table Incidents
	lineageTag: 03d974bb-f9e6-4c6c-be26-2080f7c089a1

	measure 'Open Incidents' = CALCULATE(COUNTROWS(Incidents), Incidents[Status] <> "Closed")
		formatString: 0
		lineageTag: 1a79df96-e3a1-44a9-8b7b-0785c7293716

	measure 'High-Risk Incidents' = CALCULATE(COUNTROWS(Incidents), Incidents[RiskTier] IN {"Critical", "High"})
		formatString: 0
		lineageTag: 047464e9-b647-40d2-8bae-3af2ed3bdd8f

	column IncidentNumber
		dataType: int64
		formatString: 0
		lineageTag: 3bf14212-2c54-47c6-a0bf-ec62dc62aa5f
		summarizeBy: none
		sourceColumn: IncidentNumber

		annotation SummarizationSetBy = Automatic

