	column ReportDate
		dataType: dateTime
		formatString: General Date
		lineageTag: ffb5f071-b44c-41dc-b04f-b7ecfe8d8c4e
		summarizeBy: none
		sourceColumn: ReportDate

		annotation SummarizationSetBy = Automatic

	partition Incidents = m
		mode: import
		source =
				let
				    Source = AzureDataExplorer.Contents(ClusterUri, Database, "DailyIncidentRiskFindings | summarize arg_max(TimeGenerated, *) by IncidentNumber | project IncidentNumber = tolong(IncidentNumber), Title = tostring(Title), Severity = tostring(Severity), Status = tostring(Status), Owner = tostring(Owner), AgeHours = tolong(AgeHours), Alerts = tolong(Alerts), RiskScore = tolong(RiskScore), RiskTier = tostring(RiskTier), Reason = tostring(Reason), ReportDate = todatetime(ReportDate)", [])
				in
				    Source

	annotation PBI_ResultType = Table

