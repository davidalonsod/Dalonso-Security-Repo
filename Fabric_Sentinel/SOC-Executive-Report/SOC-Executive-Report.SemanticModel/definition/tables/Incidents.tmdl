		sourceColumn: AgeHours

		annotation SummarizationSetBy = Automatic

	column Alerts
		dataType: int64
		formatString: 0
		lineageTag: a2b3bd74-c7bf-40cf-a71d-05042939b48f
		summarizeBy: none
		sourceColumn: Alerts

		annotation SummarizationSetBy = Automatic

	column RiskScore
