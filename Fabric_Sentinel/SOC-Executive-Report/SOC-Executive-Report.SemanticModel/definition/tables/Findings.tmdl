table Findings
	lineageTag: c1076496-8454-4755-a080-35fa940bf667

	measure 'Attacker IPs' = DISTINCTCOUNT(Findings[IPAddress])
		formatString: 0
		lineageTag: 8c451eb4-cb55-4b22-8093-0af3e332daf7

	measure 'Compromised IPs' = CALCULATE(DISTINCTCOUNT(Findings[IPAddress]), Findings[SuccessAfter] = TRUE())
		formatString: 0
		lineageTag: 2150e3dc-6868-4ba8-8460-db95983c63f7

	measure 'Attack Failures' = SUM(Findings[Failures])
		formatString: #,0
		lineageTag: 41cdda7f-497b-447d-a361-6878a6f8a9e3

	measure 'Attack Countries' = DISTINCTCOUNT(Findings[Country])
		formatString: 0
		lineageTag: 5f0118ea-0499-493f-b255-e747662201f9

