	partition Findings = m
		mode: import
		source =
				let
				    Source = AzureDataExplorer.Contents(ClusterUri, Database, "EntraBruteForceFindings | where TimeGenerated > ago(7d) | project TimeGenerated, Pattern = tostring(Pattern), Severity = tostring(Severity), IPAddress = tostring(IPAddress), Country = tostring(Country), City = tostring(City), Latitude = todouble(Latitude), Longitude = todouble(Longitude), Failures = tolong(Failures), Users = tolong(Users), SuccessAfter = tobool(SuccessAfter), TargetedUsers = tostring(TargetedUsers), CompromisedUsers = tostring(CompromisedUsers)", [])
				in
				    Source

	annotation PBI_ResultType = Table

