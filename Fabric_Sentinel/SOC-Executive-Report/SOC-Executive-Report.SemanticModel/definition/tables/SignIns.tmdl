table SignIns
	lineageTag: dbb8ad98-46ee-4e4f-a63d-05237e027d77

	measure 'Sign-ins' = SUM(SignIns[SignIns])
		formatString: #,0
		lineageTag: 79f4bc0f-5877-41b7-b22a-c29f67c9707b

	measure 'Failed Sign-ins' = SUM(SignIns[Failures])
		formatString: #,0
		lineageTag: 45d610f3-c78e-41da-b884-c25bf241fc98

	measure 'Failure Rate' = DIVIDE([Failed Sign-ins], [Sign-ins])
		formatString: 0.0%
		lineageTag: a503b2a8-31ff-4080-a307-e86de01052ef

	column UserId
		dataType: string
		lineageTag: 4df27a5b-eff3-47f6-a83e-7b4b6875b695
