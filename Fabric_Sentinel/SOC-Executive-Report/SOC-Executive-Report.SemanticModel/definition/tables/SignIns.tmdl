	partition SignIns = m
		mode: import
		source =
				let
				    Source = AzureDataExplorer.Contents(ClusterUri, Database, "SigninGeo7d | project UserId = tostring(UserId), IP = tostring(IP), Day = todatetime(Day), SignIns = tolong(SignIns), Failures = tolong(Failures), Successes = tolong(Successes), Country = tostring(Country), City = tostring(City), Latitude = todouble(Latitude), Longitude = todouble(Longitude)", [])
				in
				    Source

	annotation PBI_ResultType = Table

