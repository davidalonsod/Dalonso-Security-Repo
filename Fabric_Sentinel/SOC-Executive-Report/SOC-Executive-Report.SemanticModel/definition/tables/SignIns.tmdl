		annotation SummarizationSetBy = Automatic

	column Day
		dataType: dateTime
		formatString: General Date
		lineageTag: d7c41e44-02db-46d9-9682-7096dd714e60
		summarizeBy: none
		sourceColumn: Day

		annotation SummarizationSetBy = Automatic

	column SignIns
