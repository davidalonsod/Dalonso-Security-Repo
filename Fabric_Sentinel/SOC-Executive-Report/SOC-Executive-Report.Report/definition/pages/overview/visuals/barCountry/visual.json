{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "barCountry",
  "position": {
    "x": 10,
    "y": 130,
    "z": 5000,
    "width": 625,
    "height": 285,
    "tabOrder": 5000
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Findings"
                    }
                  },
                  "Property": "Country"
                }
              },
              "queryRef": "Findings.Country",
              "nativeQueryRef": "Country"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Findings"
                    }
                  },
                  "Property": "Attack Failures"
                }
              },
              "queryRef": "Findings.Attack Failures",
              "nativeQueryRef": "Attack Failures"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Attack failures by country'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}