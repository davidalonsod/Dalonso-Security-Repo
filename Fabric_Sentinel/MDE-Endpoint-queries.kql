// ===== [1 - Endpoint Overview] High-severity endpoint alerts
set query_results_cache_max_age = time(5m);
let EpAlerts = external_table('AlertInfo')
| where TimeGenerated between (_startTime .. _endTime)
| where ServiceSource has_any ("Endpoint", "Defender for Endpoint", "Antivirus") or DetectionSource has_any ("EDR", "Antivirus", "Endpoint", "Custom detection", "Automated investigation")
| extend PA = pack_all()
| project AlertTime = TimeGenerated, AlertId, Title, Severity, Category, DetectionSource, Techniques = tostring(PA.AttackTechniques);
let AlertDev = external_table('AlertEvidence')
| where TimeGenerated between (_startTime .. _endTime)
| extend PE = pack_all()
| extend DevName = tostring(PE.DeviceName), EvUser = tostring(PE.AccountName)
| where isnotempty(DevName)
| summarize Users = make_set_if(EvUser, isnotempty(EvUser), 5) by AlertId, DevName
| where isempty(_device) or DevName contains _device;
EpAlerts
| join kind=inner (AlertDev | distinct AlertId) on AlertId
| where Severity =~ "High"
| summarize HighAlerts = dcount(AlertId)

// ===== [1 - Endpoint Overview] Devices with alerts
set query_results_cache_max_age = time(5m);
let EpAlerts = external_table('AlertInfo')
| where TimeGenerated between (_startTime .. _endTime)
| where ServiceSource has_any ("Endpoint", "Defender for Endpoint", "Antivirus") or DetectionSource has_any ("EDR", "Antivirus", "Endpoint", "Custom detection", "Automated investigation")
| extend PA = pack_all()
| project AlertTime = TimeGenerated, AlertId, Title, Severity, Category, DetectionSource, Techniques = tostring(PA.AttackTechniques);
let AlertDev = external_table('AlertEvidence')
| where TimeGenerated between (_startTime .. _endTime)
| extend PE = pack_all()
| extend DevName = tostring(PE.DeviceName), EvUser = tostring(PE.AccountName)
| where isnotempty(DevName)
| summarize Users = make_set_if(EvUser, isnotempty(EvUser), 5) by AlertId, DevName
| where isempty(_device) or DevName contains _device;
EpAlerts
| join kind=inner AlertDev on AlertId
| summarize DevicesWithAlerts = dcount(DevName)

// ===== [1 - Endpoint Overview] Devices reporting process telemetry
set query_results_cache_max_age = time(5m);
let Proc = external_table('DeviceProcessEvents')
| where TimeGenerated between (_startTime .. _endTime)
| where isempty(_device) or DeviceName contains _device
| where isempty(_account) or AccountName =~ _account or AccountUpn =~ _account;
Proc
| summarize ActiveDevices = dcount(DeviceName)

// ===== [1 - Endpoint Overview] Suspicious executions (encoded PowerShell / LOLBin abuse)
set query_results_cache_max_age = time(5m);
let Proc = external_table('DeviceProcessEvents')
| where TimeGenerated between (_startTime .. _endTime)
| where isempty(_device) or DeviceName contains _device
| where isempty(_account) or AccountName =~ _account or AccountUpn =~ _account;
Proc
| where (FileName in~ ("powershell.exe", "pwsh.exe") and ProcessCommandLine matches regex @"(?i)(-e(nc|ncodedcommand)?\s+[a-z0-9+/=]{20,}|frombase64string|downloadstring|downloadfile|invoke-expression|iex\s*\()")
     or (FileName =~ "certutil.exe" and ProcessCommandLine has_any ("urlcache", "-decode", "http"))
     or (FileName =~ "mshta.exe" and ProcessCommandLine has_any ("http", "javascript", "vbscript"))
     or (FileName =~ "regsvr32.exe" and ProcessCommandLine has_any ("/i:http", "scrobj"))
     or (FileName =~ "bitsadmin.exe" and ProcessCommandLine has "/transfer")
| summarize SuspiciousExecutions = count()

// ===== [1 - Endpoint Overview] Endpoint alerts over time by severity
set query_results_cache_max_age = time(5m);
let Step = iff(_endTime - _startTime > 3d, 6h, 1h);
let EpAlerts = external_table('AlertInfo')
| where TimeGenerated between (_startTime .. _endTime)
| where ServiceSource has_any ("Endpoint", "Defender for Endpoint", "Antivirus") or DetectionSource has_any ("EDR", "Antivirus", "Endpoint", "Custom detection", "Automated investigation")
| extend PA = pack_all()
| project AlertTime = TimeGenerated, AlertId, Title, Severity, Category, DetectionSource, Techniques = tostring(PA.AttackTechniques);
let AlertDev = external_table('AlertEvidence')
| where TimeGenerated between (_startTime .. _endTime)
| extend PE = pack_all()
| extend DevName = tostring(PE.DeviceName), EvUser = tostring(PE.AccountName)
| where isnotempty(DevName)
| summarize Users = make_set_if(EvUser, isnotempty(EvUser), 5) by AlertId, DevName
| where isempty(_device) or DevName contains _device;
EpAlerts
| join kind=inner (AlertDev | distinct AlertId) on AlertId
| summarize Alerts = dcount(AlertId) by bin(AlertTime, Step), Severity
| order by AlertTime asc

