        "items": [
          {
            "type": 1,
            "content": {
              "json": "## 🚨 AI Security Monitoring (SOC)\n\nDetection categories across AI + identity + M365 + cloud-app telemetry, plus firing alerts, severity, and MITRE mapping. Category tiles light up only where the underlying connector is present.",
              "style": "info"
            },
            "name": "so-h"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true\r\n(AppDependencies | where tostring(Properties['gen_ai.input.messages']) matches regex @'(?i)(ignore (all|previous|above)|disregard .*instruction|system prompt|jailbreak|do anything now)' | summarize Count = count() | extend Category = 'Prompt injection', Severity = '🔴 High'),\r\n(CopilotActivity | mv-expand r = LLMEventData.AccessedResources | where tobool(r.XPIADetected) == true | summarize Count = count() | extend Category = 'Indirect prompt injection (XPIA)', Severity = '🔴 High'),\r\n(BehaviorInfo | where ActionType contains 'Jailbreak' or ActionType contains 'PromptShield' | summarize Count = count() | extend Category = 'Jailbreak / Prompt Shield', Severity = '🔴 High'),\r\n(AppDependencies | where isnotempty(tostring(Properties['gen_ai.conversation.id'])) and isnotempty(tostring(Properties['gen_ai.tool.name'])) | summarize tc = count() by cid = tostring(Properties['gen_ai.conversation.id']) | where tc >= 15 | summarize Count = count() | extend Category = 'Excessive tool calls', Severity = '🟠 Medium'),\r\n(AppEvents | where Name == 'BotMessageSend' and tostring(Properties['text']) matches regex @'(AKIA[0-9A-Z]{16}|BEGIN [A-Z ]*PRIVATE KEY|eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,})' | summarize Count = count() | extend Category = 'Credential / secret exposure', Severity = '🔴 High'),\r\n(OfficeActivity | where Operation in~ ('FileDownloaded', 'FileSyncDownloadedFull') | summarize c = count() by UserId | where c >= 100 | summarize Count = count() | extend Category = 'Massive file reads', Severity = '🟠 Medium'),\r\n(SigninLogs | where ResultType != 0 | summarize Count = count() | extend Category = 'Failed auth', Severity = '🟡 Low'),\r\n(AADUserRiskEvents | where RiskEventType has_any ('unfamiliarFeatures', 'anonymizedIPAddress', 'maliciousIPAddress', 'impossibleTravel') | summarize Count = count() | extend Category = 'Risky sign-ins (impossible travel / anon IP / TOR)', Severity = '🟠 Medium'),\r\n(CloudAppEvents | where Application has_any ('OpenAI', 'ChatGPT', 'Claude', 'Anthropic', 'Gemini', 'Perplexity', 'Mistral') | summarize Count = count() | extend Category = 'Third-party / shadow AI usage', Severity = '🟠 Medium')\r\n| project Category, Severity, Count\r\n| where Count > 0\r\n| order by Count desc",
              "size": 0,
              "title": "Detection categories (selected range)",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Severity",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "Count",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "so-cat"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true (SecurityAlert)\r\n| where AlertName has_any ('Copilot','Foundry','OpenAI','Agent','Prompt','Jailbreak','LLM','AI')\r\n| summarize Alerts = count() by bin(TimeGenerated, 1d), AlertSeverity",
              "size": 0,
              "visualization": "barchart",
              "title": "AI alerts over time (by severity)",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "so-alerts"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true (SecurityAlert)\r\n| where AlertName has_any ('Copilot','Foundry','OpenAI','Agent','Prompt','Jailbreak','LLM','AI')\r\n| summarize Alerts = count() by AlertSeverity",
              "size": 1,
              "visualization": "piechart",
              "title": "Alerts by severity",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "so-sev"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true (SecurityAlert)\r\n| where AlertName has_any ('Copilot','Foundry','OpenAI','Agent','Prompt','Jailbreak','LLM','AI')\r\n| mv-expand t = todynamic(Techniques)\r\n| where isnotempty(tostring(t))\r\n| summarize Alerts = count() by Technique = tostring(t)\r\n| top 20 by Alerts desc",
              "size": 1,
              "title": "MITRE ATT&CK techniques (from alerts)",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Alerts",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "orange"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "so-mitre"
          }
        ]
      },
      "name": "group-soc"
    },
    {
      "type": 12,
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "safety"
      },
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## 🛡️ Content Safety Dashboard\n\nGuardrail verdicts from Foundry content_filter.results (and Azure OpenAI AOAIOperationalLogs where present): harm categories, jailbreak / Prompt Shield, protected material, trend, and worst agents / models.",
              "style": "info"
            },
            "name": "cs-h"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let CF = AppDependencies | where isnotempty(tostring(Properties['microsoft.foundry.content_filter.results'])) | extend cf = tostring(Properties['microsoft.foundry.content_filter.results']);\r\nunion isfuzzy=true\r\n(CF | where cf has 'jailbreak' | summarize Value = count() | extend Metric = 'Jailbreak', Order = 1),\r\n(CF | where cf has 'prompt_shield' | summarize Value = count() | extend Metric = 'Prompt Shield', Order = 2),\r\n(CF | where cf has 'indirect_attack' | summarize Value = count() | extend Metric = 'Indirect injection', Order = 3),\r\n(CF | where cf has 'hate' | summarize Value = count() | extend Metric = 'Hate', Order = 4),\r\n(CF | where cf has 'sexual' | summarize Value = count() | extend Metric = 'Sexual', Order = 5),\r\n(CF | where cf has 'violence' | summarize Value = count() | extend Metric = 'Violence', Order = 6),\r\n(CF | where cf has 'self_harm' | summarize Value = count() | extend Metric = 'Self-harm', Order = 7),\r\n(CF | where cf has_any ('protected_material', 'custom_blocklists') | summarize Value = count() | extend Metric = 'Protected / blocklist', Order = 8)\r\n| project Order, Metric, Value\r\n| sort by Order asc",
              "size": 3,
              "visualization": "tiles",
              "title": "Safety category counts",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                }
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-kpi"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppDependencies\r\n| where isnotempty(tostring(Properties['microsoft.foundry.content_filter.results']))\r\n| summarize Hits = count() by bin(TimeGenerated, 1h)",
              "size": 0,
              "visualization": "timechart",
              "title": "Content-safety hits over time",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-trend"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppDependencies\r\n| where isnotempty(tostring(Properties['microsoft.foundry.content_filter.results']))\r\n| summarize Hits = count() by Agent = tostring(Properties['gen_ai.agent.name'])\r\n| top 15 by Hits desc",
              "size": 1,
              "visualization": "barchart",
              "title": "Top agents by safety hits",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-agents"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppDependencies\r\n| where isnotempty(tostring(Properties['microsoft.foundry.content_filter.results']))\r\n| summarize Hits = count() by Model = tostring(Properties['gen_ai.request.model'])\r\n| top 15 by Hits desc",
              "size": 1,
              "visualization": "barchart",
              "title": "Models with most safety hits",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-models"
          }
        ]
      },
      "name": "group-safety"
    },
    {
      "type": 12,
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "models"
      },
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## 🧠 Model Observability\n\nPer-model tokens, latency, cost, and failures across Foundry + OpenAI (+ AOAIOperationalLogs). Cost uses the token-price params.",
              "style": "info"
            },
            "name": "mo-h"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let AIRequests = union isfuzzy=true\r\n(datatable(TimeGenerated:datetime, Platform:string, AgentName:string, Identity:string, Model:string, InTok:real, OutTok:real, LatencyMs:real, ConversationId:string)[]),\r\n(CopilotActivity | where RecordType == 'CopilotInteraction' | extend Platform = 'M365 Copilot', AgentName = tostring(AgentName), Identity = tostring(ActorName), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(LLMEventData.ConversationId)),\r\n(AppEvents | where Name == 'BotMessageReceived' | extend Platform = 'Copilot Studio', AgentName = tostring(UserId), Identity = tostring(UserId), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(Properties['conversationId'])),\r\n(AppDependencies | where isnotempty(tostring(Properties['gen_ai.agent.name'])) | extend Platform = 'Azure AI Foundry', AgentName = tostring(Properties['gen_ai.agent.name']), Identity = tostring(Properties['gen_ai.agent.name']), Model = tostring(Properties['gen_ai.request.model']), InTok = toreal(tolong(Properties['gen_ai.usage.input_tokens'])), OutTok = toreal(tolong(Properties['gen_ai.usage.output_tokens'])), LatencyMs = toreal(DurationMs), ConversationId = tostring(Properties['gen_ai.conversation.id'])),\r\n(ASimAgentEventLogs | extend Platform = 'OpenAI', AgentName = coalesce(tostring(TargetAgentName), tostring(SrcAgentName), tostring(ModelName)), Identity = coalesce(tostring(ActorUsername), tostring(ActorUserId)), Model = tostring(ModelName), InTok = toreal(tolong(InputTokensUsed)), OutTok = toreal(tolong(OutputTokensUsed)), LatencyMs = iff(isnotempty(EventStartTime) and isnotempty(EventEndTime), toreal(datetime_diff('millisecond', EventEndTime, EventStartTime)), toreal(0)), ConversationId = tostring(EventSessionId))\r\n| project TimeGenerated, Platform, AgentName, Identity, Model, InTok, OutTok, LatencyMs, ConversationId;AIRequests\r\n| where isnotempty(Model)\r\n| summarize Requests = count(), InputTokens = sum(InTok), OutputTokens = sum(OutTok), AvgLatencyMs = round(avg(LatencyMs), 0) by Model\r\n| extend EstCostUSD = round((InputTokens / 1000.0) * toreal('{PriceInput}') + (OutputTokens / 1000.0) * toreal('{PriceOutput}'), 2)\r\n| order by Requests desc",
              "size": 0,
              "title": "Per-model summary (requests, tokens, latency, cost)",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Requests",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  },
                  {
                    "columnMatch": "EstCostUSD",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "mo-grid"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let AIRequests = union isfuzzy=true\r\n(datatable(TimeGenerated:datetime, Platform:string, AgentName:string, Identity:string, Model:string, InTok:real, OutTok:real, LatencyMs:real, ConversationId:string)[]),\r\n(CopilotActivity | where RecordType == 'CopilotInteraction' | extend Platform = 'M365 Copilot', AgentName = tostring(AgentName), Identity = tostring(ActorName), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(LLMEventData.ConversationId)),\r\n(AppEvents | where Name == 'BotMessageReceived' | extend Platform = 'Copilot Studio', AgentName = tostring(UserId), Identity = tostring(UserId), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(Properties['conversationId'])),\r\n(AppDependencies | where isnotempty(tostring(Properties['gen_ai.agent.name'])) | extend Platform = 'Azure AI Foundry', AgentName = tostring(Properties['gen_ai.agent.name']), Identity = tostring(Properties['gen_ai.agent.name']), Model = tostring(Properties['gen_ai.request.model']), InTok = toreal(tolong(Properties['gen_ai.usage.input_tokens'])), OutTok = toreal(tolong(Properties['gen_ai.usage.output_tokens'])), LatencyMs = toreal(DurationMs), ConversationId = tostring(Properties['gen_ai.conversation.id'])),\r\n(ASimAgentEventLogs | extend Platform = 'OpenAI', AgentName = coalesce(tostring(TargetAgentName), tostring(SrcAgentName), tostring(ModelName)), Identity = coalesce(tostring(ActorUsername), tostring(ActorUserId)), Model = tostring(ModelName), InTok = toreal(tolong(InputTokensUsed)), OutTok = toreal(tolong(OutputTokensUsed)), LatencyMs = iff(isnotempty(EventStartTime) and isnotempty(EventEndTime), toreal(datetime_diff('millisecond', EventEndTime, EventStartTime)), toreal(0)), ConversationId = tostring(EventSessionId))\r\n| project TimeGenerated, Platform, AgentName, Identity, Model, InTok, OutTok, LatencyMs, ConversationId;AIRequests | where isnotempty(Model) and LatencyMs > 0 | summarize AvgLatencyMs = avg(LatencyMs) by bin(TimeGenerated, 1h), Model",
              "size": 0,
              "visualization": "timechart",
              "title": "Avg latency over time by model",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "mo-lat"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let AIRequests = union isfuzzy=true\r\n(datatable(TimeGenerated:datetime, Platform:string, AgentName:string, Identity:string, Model:string, InTok:real, OutTok:real, LatencyMs:real, ConversationId:string)[]),\r\n(CopilotActivity | where RecordType == 'CopilotInteraction' | extend Platform = 'M365 Copilot', AgentName = tostring(AgentName), Identity = tostring(ActorName), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(LLMEventData.ConversationId)),\r\n(AppEvents | where Name == 'BotMessageReceived' | extend Platform = 'Copilot Studio', AgentName = tostring(UserId), Identity = tostring(UserId), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(Properties['conversationId'])),\r\n(AppDependencies | where isnotempty(tostring(Properties['gen_ai.agent.name'])) | extend Platform = 'Azure AI Foundry', AgentName = tostring(Properties['gen_ai.agent.name']), Identity = tostring(Properties['gen_ai.agent.name']), Model = tostring(Properties['gen_ai.request.model']), InTok = toreal(tolong(Properties['gen_ai.usage.input_tokens'])), OutTok = toreal(tolong(Properties['gen_ai.usage.output_tokens'])), LatencyMs = toreal(DurationMs), ConversationId = tostring(Properties['gen_ai.conversation.id'])),\r\n(ASimAgentEventLogs | extend Platform = 'OpenAI', AgentName = coalesce(tostring(TargetAgentName), tostring(SrcAgentName), tostring(ModelName)), Identity = coalesce(tostring(ActorUsername), tostring(ActorUserId)), Model = tostring(ModelName), InTok = toreal(tolong(InputTokensUsed)), OutTok = toreal(tolong(OutputTokensUsed)), LatencyMs = iff(isnotempty(EventStartTime) and isnotempty(EventEndTime), toreal(datetime_diff('millisecond', EventEndTime, EventStartTime)), toreal(0)), ConversationId = tostring(EventSessionId))\r\n| project TimeGenerated, Platform, AgentName, Identity, Model, InTok, OutTok, LatencyMs, ConversationId;AIRequests | where isnotempty(Model) | summarize Tokens = sum(InTok + OutTok) by bin(TimeGenerated, 1d), Model",
              "size": 1,
              "visualization": "barchart",
              "title": "Token volume by day / model",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "mo-cost"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true\r\n(AppDependencies | where isnotempty(tostring(Properties['gen_ai.request.model'])) and Success == false | extend Model = tostring(Properties['gen_ai.request.model']) | summarize Failures = count() by Model),\r\n(AOAIOperationalLogs | extend Model = tostring(column_ifexists('properties_modelDeploymentName', column_ifexists('ModelDeploymentName', ''))) | where toint(column_ifexists('ResultSignature', column_ifexists('resultSignature', 200))) >= 400 | summarize Failures = count() by Model)\r\n| summarize Failures = sum(Failures) by Model\r\n| where isnotempty(Model)\r\n| order by Failures desc",
              "size": 1,
              "visualization": "barchart",
              "title": "Failures by model",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Failures",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "mo-err"
          }
        ]
      },
      "name": "group-models"
    },
    {
      "type": 12,
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "ops"
      },
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## ⚙️ Agent Operations\n\nOperational health from AppDependencies / AppRequests / AppExceptions: failure breakdown, HTTP result codes (429/500/timeouts), success %, and top exceptions.",
              "style": "info"
            },
            "name": "op-h"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true\r\n(AppDependencies | where Success == false | extend Kind = case(AppRoleName == 'Microsoft Copilot Studio', 'Connector', isnotempty(tostring(Properties['gen_ai.tool.name'])), 'Agent tool', tostring(DependencyType)) | summarize Failures = count() by Kind),\r\n(AppExceptions | summarize Failures = count() by Kind = tostring(ExceptionType))\r\n| summarize Failures = sum(Failures) by Kind\r\n| order by Failures desc\r\n| take 20",
              "size": 1,
              "visualization": "barchart",
              "title": "Failures by kind (tool / connector / exception)",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Failures",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "op-fail"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true\r\n(AppDependencies | summarize Count = count() by ResultCode = tostring(ResultCode)),\r\n(AppRequests | summarize Count = count() by ResultCode = tostring(ResultCode))\r\n| summarize Count = sum(Count) by ResultCode\r\n| order by Count desc\r\n| take 25",
              "size": 1,
              "title": "Result codes (429 / 500 / timeouts)",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Count",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "orange"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "op-codes"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppDependencies\r\n| summarize Total = count(), Fail = countif(Success == false) by bin(TimeGenerated, 1h)\r\n| extend SuccessPct = round(100.0 * (Total - Fail) / Total, 1)\r\n| project TimeGenerated, SuccessPct",
              "size": 0,
              "visualization": "timechart",
              "title": "Success % over time",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "op-succ"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true (AppExceptions)\r\n| summarize Count = count(), Last = max(TimeGenerated) by Problem = tostring(ExceptionType)\r\n| top 25 by Count desc",
              "size": 0,
              "title": "Top exceptions",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Count",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "op-exc"
          }
        ]
      },
      "name": "group-ops"
    },
    {
      "type": 12,
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "gov"
      },
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## 📋 Governance & Compliance\n\nOwnerless / unapproved agents, external-data & MCP usage, weak auth, inactivity, and **shadow AI** (third-party AI SaaS from CloudAppEvents).",
              "style": "info"
            },
            "name": "gv-h"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let A = AgentsInfo | summarize arg_max(TimeGenerated, *) by AgentId;\r\nunion isfuzzy=true\r\n(A | where isempty(tostring(Owners)) or tostring(Owners) in ('', '[]') | summarize Value = count() | extend Metric = 'Ownerless agents', Order = 1),\r\n(A | where PublishedStatus !~ 'Published' | summarize Value = count() | extend Metric = 'Unpublished / unapproved', Order = 2),\r\n(A | where isnotempty(tostring(column_ifexists('DeclaredDataSources', ''))) and tostring(column_ifexists('DeclaredDataSources', '')) !in ('', '[]') | summarize Value = count() | extend Metric = 'Using external / knowledge data', Order = 3),\r\n(A | where isnotempty(tostring(McpServers)) and tostring(McpServers) !in ('', '[]') | summarize Value = count() | extend Metric = 'Using MCP servers', Order = 4),\r\n(A | where tostring(ToolsAuthenticationType) has_any ('None', 'Anonymous', 'ApiKey', 'key') | summarize Value = count() | extend Metric = 'Weak / no tool auth', Order = 5),\r\n(A | where LastUpdatedDateTime < ago(30d) | summarize Value = count() | extend Metric = 'Inactive (>30d)', Order = 6),\r\n(union isfuzzy=true (CloudAppEvents | where Application has_any ('OpenAI','ChatGPT','Claude','Anthropic','Gemini','Perplexity','Mistral')) | summarize Value = dcount(Application) | extend Metric = 'Shadow AI apps', Order = 7)\r\n| project Order, Metric, Value\r\n| sort by Order asc",
              "size": 3,
              "visualization": "tiles",
              "title": "Governance metrics",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                }
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "gv-kpi"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true (CloudAppEvents)\r\n| where Application has_any ('OpenAI', 'ChatGPT', 'Claude', 'Anthropic', 'Gemini', 'Perplexity', 'Mistral', 'DeepSeek', 'Copilot')\r\n| summarize Events = count(), Users = dcount(AccountObjectId), LastSeen = max(TimeGenerated) by Application\r\n| top 25 by Events desc",
              "size": 0,
              "title": "Shadow / third-party AI usage (CloudAppEvents)",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Events",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "orange"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "gv-shadow"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AgentsInfo\r\n| summarize arg_max(TimeGenerated, *) by AgentId\r\n| where isnotempty(tostring(column_ifexists('DeclaredDataSources', ''))) and tostring(column_ifexists('DeclaredDataSources', '')) !in ('', '[]')\r\n| project Name, Platform, DeclaredDataSources = tostring(column_ifexists('DeclaredDataSources', '')), McpServers = tostring(McpServers), Auth = tostring(ToolsAuthenticationType)\r\n| take 100",
              "size": 0,
              "title": "Agents using external / knowledge data sources",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "gv-ext"
          }
        ]
      },
      "name": "group-gov"
    },
    {
      "type": 12,
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "invest"
      },
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## 🔎 Investigation\n\nEntity-pivot investigation. Type a **client agent / bot / identity / UPN** in **Agent contains** above to focus the timeline, related alerts, and (for a human UPN) sign-ins.",
              "style": "info"
            },
            "name": "iv-h"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let Events = union isfuzzy=true\r\n(CopilotActivity | where RecordType == 'CopilotInteraction' | extend EventType = 'Prompt/Response', Platform = 'M365 Copilot', Agent = tostring(AgentName), Identity = tostring(ActorName), Detail = substring(tostring(LLMEventData.Prompt), 0, 160)),\r\n(CopilotActivity | where RecordType != 'CopilotInteraction' | extend EventType = tostring(RecordType), Platform = 'M365 Copilot', Agent = tostring(AgentName), Identity = tostring(ActorName), Detail = tostring(RecordType)),\r\n(AppEvents | where Name startswith 'BotMessage' | extend EventType = tostring(Name), Platform = 'Copilot Studio', Agent = tostring(UserId), Identity = tostring(UserId), Detail = substring(tostring(Properties['text']), 0, 160)),\r\n(AppDependencies | where isnotempty(tostring(Properties['gen_ai.tool.name'])) | extend EventType = 'Tool call', Platform = 'Foundry', Agent = tostring(Properties['gen_ai.agent.name']), Identity = tostring(Properties['gen_ai.agent.name']), Detail = tostring(Properties['gen_ai.tool.name'])),\r\n(AppDependencies | where isnotempty(tostring(Properties['microsoft.foundry.content_filter.results'])) | extend EventType = 'Content-safety', Platform = 'Foundry', Agent = tostring(Properties['gen_ai.agent.name']), Identity = tostring(Properties['gen_ai.agent.name']), Detail = tostring(Properties['microsoft.foundry.content_filter.results'])),\r\n(BehaviorInfo | where ActionType contains 'PromptShield' or ActionType contains 'Jailbreak' | extend EventType = 'Prompt Shield', Platform = 'Defender XDR', Agent = tostring(todynamic(AdditionalFields).AgentName), Identity = tostring(AccountUpn), Detail = tostring(Description)),\r\n(SecurityAlert | where AlertName has_any ('Copilot','Foundry','OpenAI','Agent','Prompt','Jailbreak','AI') | extend EventType = 'Alert', Platform = 'Sentinel', Agent = tostring(AlertName), Identity = '', Detail = tostring(AlertName))\r\n| project TimeGenerated, EventType, Platform, Agent, Identity, Detail;\r\nEvents\r\n| where '{AgentSearch}' == '' or Agent has '{AgentSearch}' or Identity has '{AgentSearch}'\r\n| order by TimeGenerated desc\r\n| take 200",
              "size": 0,
              "title": "Event timeline for the selected entity",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "iv-feed"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true (SecurityAlert)\r\n| where '{AgentSearch}' == '' or tostring(Entities) has '{AgentSearch}' or AlertName has '{AgentSearch}'\r\n| project TimeGenerated, AlertName, AlertSeverity, Description\r\n| order by TimeGenerated desc\r\n| take 50",
              "size": 0,
              "title": "Related security alerts",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "iv-alerts"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true (SigninLogs)\r\n| where '{AgentSearch}' != '' and UserPrincipalName has '{AgentSearch}'\r\n| project TimeGenerated, UserPrincipalName, AppDisplayName, ResultType, IPAddress, Location = tostring(LocationDetails.countryOrRegion)\r\n| order by TimeGenerated desc\r\n| take 50",
              "size": 0,
              "title": "Related sign-ins (if a user UPN)",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "iv-signin"
          }
        ]
      },
      "name": "group-invest"
    },
    {
      "type": 12,
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "risk"
      },
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## 🎯 AI Risk Score\n\nComposite 0-100 score, weighted across prompt injection (22%), content safety (18%), sensitive data (18%), detection alerts (14%), tool/plugin risk (10%), third-party AI (9%), governance (9%). Tune caps / weights in the generator.",
              "style": "info"
            },
            "name": "rk-h"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let AIRequests = union isfuzzy=true\r\n(datatable(TimeGenerated:datetime, Platform:string, AgentName:string, Identity:string, Model:string, InTok:real, OutTok:real, LatencyMs:real, ConversationId:string)[]),\r\n(CopilotActivity | where RecordType == 'CopilotInteraction' | extend Platform = 'M365 Copilot', AgentName = tostring(AgentName), Identity = tostring(ActorName), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(LLMEventData.ConversationId)),\r\n(AppEvents | where Name == 'BotMessageReceived' | extend Platform = 'Copilot Studio', AgentName = tostring(UserId), Identity = tostring(UserId), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(Properties['conversationId'])),\r\n(AppDependencies | where isnotempty(tostring(Properties['gen_ai.agent.name'])) | extend Platform = 'Azure AI Foundry', AgentName = tostring(Properties['gen_ai.agent.name']), Identity = tostring(Properties['gen_ai.agent.name']), Model = tostring(Properties['gen_ai.request.model']), InTok = toreal(tolong(Properties['gen_ai.usage.input_tokens'])), OutTok = toreal(tolong(Properties['gen_ai.usage.output_tokens'])), LatencyMs = toreal(DurationMs), ConversationId = tostring(Properties['gen_ai.conversation.id'])),\r\n(ASimAgentEventLogs | extend Platform = 'OpenAI', AgentName = coalesce(tostring(TargetAgentName), tostring(SrcAgentName), tostring(ModelName)), Identity = coalesce(tostring(ActorUsername), tostring(ActorUserId)), Model = tostring(ModelName), InTok = toreal(tolong(InputTokensUsed)), OutTok = toreal(tolong(OutputTokensUsed)), LatencyMs = iff(isnotempty(EventStartTime) and isnotempty(EventEndTime), toreal(datetime_diff('millisecond', EventEndTime, EventStartTime)), toreal(0)), ConversationId = tostring(EventSessionId))\r\n| project TimeGenerated, Platform, AgentName, Identity, Model, InTok, OutTok, LatencyMs, ConversationId;let inj = toscalar(union isfuzzy=true (AppDependencies | where tostring(Properties['gen_ai.input.messages']) matches regex @'(?i)(ignore (all|previous)|jailbreak|system prompt)'), (CopilotActivity | mv-expand m = LLMEventData.Messages | where tobool(m.JailbreakDetected) == true) | summarize count());\r\nlet safety = toscalar(AppDependencies | where isnotempty(tostring(Properties['microsoft.foundry.content_filter.results'])) | summarize count());\r\nlet sens = toscalar(union isfuzzy=true (CopilotActivity | mv-expand r = LLMEventData.AccessedResources | where tobool(r.XPIADetected) == true), (AppEvents | where Name == 'BotMessageSend' and tostring(Properties['text']) matches regex @'(AKIA[0-9A-Z]{16}|BEGIN [A-Z ]*PRIVATE KEY)') | summarize count());\r\nlet tool = toscalar(union isfuzzy=true (AppDependencies | where isnotempty(tostring(Properties['gen_ai.tool.name']))), (ASimAgentEventLogs | where isnotempty(ToolName)) | summarize count());\r\nlet alerts = toscalar(union isfuzzy=true (SecurityAlert | where TimeGenerated > ago(7d) and AlertName has_any ('Copilot','Foundry','OpenAI','Agent','Prompt','Jailbreak','AI')) | summarize count());\r\nlet ext = toscalar(union isfuzzy=true (CloudAppEvents | where Application has_any ('OpenAI','ChatGPT','Claude','Anthropic','Gemini','Perplexity','Mistral')) | summarize count());\r\nlet gov = toscalar(AgentsInfo | summarize arg_max(TimeGenerated, *) by AgentId | where isempty(tostring(Owners)) or tostring(Owners) in ('', '[]') | summarize count());\r\nlet sc = (v:long, cap:real) { min_of(100.0, todouble(v) / cap * 100.0) };\r\nlet s_inj = sc(inj, 50.0); let s_safe = sc(safety, 50.0); let s_sens = sc(sens, 20.0); let s_tool = sc(tool, 500.0); let s_alert = sc(alerts, 10.0); let s_ext = sc(ext, 20.0); let s_gov = sc(gov, 10.0);\r\nlet overall = round(0.22 * s_inj + 0.18 * s_safe + 0.18 * s_sens + 0.10 * s_tool + 0.14 * s_alert + 0.09 * s_ext + 0.09 * s_gov, 0);\r\nunion\r\n(print Metric = 'AI Risk Score', Value = overall, Order = 1),\r\n(print Metric = 'Prompt injection', Value = round(s_inj, 0), Order = 2),\r\n(print Metric = 'Content safety', Value = round(s_safe, 0), Order = 3),\r\n(print Metric = 'Sensitive data', Value = round(s_sens, 0), Order = 4),\r\n(print Metric = 'Tool / plugin risk', Value = round(s_tool, 0), Order = 5),\r\n(print Metric = 'Detection alerts', Value = round(s_alert, 0), Order = 6),\r\n(print Metric = 'Third-party AI', Value = round(s_ext, 0), Order = 7),\r\n(print Metric = 'Governance', Value = round(s_gov, 0), Order = 8)\r\n| project Order, Metric, Value\r\n| sort by Order asc",
              "size": 3,
              "visualization": "tiles",
              "title": "AI Risk Score & component sub-scores",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "red"
                  }
                },
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                }
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "rk-score"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true\r\n(AppDependencies | where isnotempty(tostring(Properties['microsoft.foundry.content_filter.results'])) | extend Cat = 'Content safety'),\r\n(AppDependencies | where tostring(Properties['gen_ai.input.messages']) matches regex @'(?i)(ignore (all|previous)|jailbreak|system prompt)' | extend Cat = 'Prompt injection'),\r\n(CopilotActivity | mv-expand m = LLMEventData.Messages | where tobool(m.JailbreakDetected) == true | extend Cat = 'Jailbreak')\r\n| summarize Events = count() by bin(TimeGenerated, 1h), Cat",
              "size": 0,
              "visualization": "timechart",
              "title": "Risk-contributing events over time",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "rk-trend"
          }
        ]
      },
      "name": "group-risk"
    }
  ],
  "styleSettings": {},
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}