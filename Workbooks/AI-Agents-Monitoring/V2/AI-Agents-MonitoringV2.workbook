              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true\n(requests | where sdkVersion startswith \"apim:\" and resultCode == \"400\" | summarize Value = todouble(count()) | extend Metric = \"Validation / safety 400\", Order = 1),\n(requests | where sdkVersion startswith \"apim:\" and resultCode == \"401\" | summarize Value = todouble(count()) | extend Metric = \"Authentication 401\", Order = 2),\n(requests | where sdkVersion startswith \"apim:\" and resultCode == \"403\" | summarize Value = todouble(count()) | extend Metric = \"Policy / authorization 403\", Order = 3),\n(requests | where sdkVersion startswith \"apim:\" and resultCode == \"404\" | summarize Value = todouble(count()) | extend Metric = \"Reconnaissance 404\", Order = 4),\n(requests | where sdkVersion startswith \"apim:\" and resultCode == \"429\" | summarize Value = todouble(count()) | extend Metric = \"Rate / token limit 429\", Order = 5),\n(requests | where sdkVersion startswith \"apim:\" and toint(resultCode) >= 500 | summarize Value = todouble(count()) | extend Metric = \"Gateway / backend 5xx\", Order = 6)\n| project Order, Metric, Value\n| sort by Order asc",
              "size": 3,
