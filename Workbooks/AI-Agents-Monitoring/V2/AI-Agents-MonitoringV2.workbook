    {
      "type": 12,
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "usage"
      },
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## 📈 AI Usage Analytics\n\nAdoption across platforms. Set the **Price / 1K tokens** params for cost, and **Department contains** to focus by business unit.\n\n**How to read this tab:** trends show adoption, model mix shows where token-bearing workloads run, and top users reveal concentration that may reflect legitimate champions, automation, or misuse. Configure current input/output prices before using cost estimates, and compare like-for-like platforms because source event grains differ. Missing token, model, latency, conversation, or identity fields are excluded from the corresponding averages rather than inferred.",
              "style": "info"
            },
            "name": "us-h"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let AIRequests = union isfuzzy=true\r\n(datatable(TimeGenerated:datetime, Platform:string, AgentName:string, Identity:string, Model:string, InTok:real, OutTok:real, LatencyMs:real, ConversationId:string)[]),\r\n(CopilotActivity | where RecordType == 'CopilotInteraction' | extend Platform = 'M365 Copilot', AgentName = tostring(AgentName), Identity = tostring(ActorName), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(LLMEventData.ConversationId)),\r\n(AppEvents | where Name == 'BotMessageReceived' | extend Platform = 'Copilot Studio', AgentName = tostring(UserId), Identity = tostring(UserId), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(Properties['conversationId'])),\r\n(AppDependencies | where isnotempty(tostring(Properties['gen_ai.agent.name'])) | extend Platform = 'Azure AI Foundry', AgentName = tostring(Properties['gen_ai.agent.name']), Identity = tostring(Properties['gen_ai.agent.name']), Model = tostring(Properties['gen_ai.request.model']), InTok = toreal(tolong(Properties['gen_ai.usage.input_tokens'])), OutTok = toreal(tolong(Properties['gen_ai.usage.output_tokens'])), LatencyMs = toreal(DurationMs), ConversationId = tostring(Properties['gen_ai.conversation.id'])),\r\n(ASimAgentEventLogs | extend Platform = 'OpenAI', AgentName = coalesce(tostring(TargetAgentName), tostring(SrcAgentName), tostring(ModelName)), Identity = coalesce(tostring(ActorUsername), tostring(ActorUserId)), Model = tostring(ModelName), InTok = toreal(tolong(InputTokensUsed)), OutTok = toreal(tolong(OutputTokensUsed)), LatencyMs = iff(isnotempty(EventStartTime) and isnotempty(EventEndTime), toreal(datetime_diff('millisecond', EventEndTime, EventStartTime)), toreal(0)), ConversationId = tostring(EventSessionId))\r\n| project TimeGenerated, Platform, AgentName, Identity, Model, InTok, OutTok, LatencyMs, ConversationId;let tools = AppDependencies | where isnotempty(tostring(Properties['gen_ai.conversation.id'])) and isnotempty(tostring(Properties['gen_ai.tool.name'])) | summarize ToolCalls = count() by cid = tostring(Properties['gen_ai.conversation.id']);\r\nunion isfuzzy=true\r\n(AIRequests | summarize Value = round(avg(InTok + OutTok), 0) | extend Metric = 'Avg tokens / request', Order = 1),\r\n(AIRequests | where LatencyMs > 0 | summarize Value = round(avg(LatencyMs), 0) | extend Metric = 'Avg latency (ms)', Order = 2),\r\n(AIRequests | where isnotempty(ConversationId) | summarize Msgs = count() by ConversationId | summarize Value = round(avg(Msgs), 1) | extend Metric = 'Avg messages / conversation', Order = 3),\r\n(tools | summarize Value = round(avg(ToolCalls), 1) | extend Metric = 'Avg tool calls / conversation', Order = 4),\r\n(AIRequests | summarize InTok = sum(InTok), OutTok = sum(OutTok), Reqs = count() | extend Value = round(((InTok / 1000.0) * toreal('{PriceInput}') + (OutTok / 1000.0) * toreal('{PriceOutput}')) / Reqs, 4), Metric = 'Avg cost / request (USD)', Order = 5 | project Value, Metric, Order)\r\n| project Order, Metric, Value\r\n| sort by Order asc",
              "size": 3,
              "visualization": "tiles",
              "title": "Usage averages",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                }
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "us-avg"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let AIRequests = union isfuzzy=true\r\n(datatable(TimeGenerated:datetime, Platform:string, AgentName:string, Identity:string, Model:string, InTok:real, OutTok:real, LatencyMs:real, ConversationId:string)[]),\r\n(CopilotActivity | where RecordType == 'CopilotInteraction' | extend Platform = 'M365 Copilot', AgentName = tostring(AgentName), Identity = tostring(ActorName), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(LLMEventData.ConversationId)),\r\n(AppEvents | where Name == 'BotMessageReceived' | extend Platform = 'Copilot Studio', AgentName = tostring(UserId), Identity = tostring(UserId), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(Properties['conversationId'])),\r\n(AppDependencies | where isnotempty(tostring(Properties['gen_ai.agent.name'])) | extend Platform = 'Azure AI Foundry', AgentName = tostring(Properties['gen_ai.agent.name']), Identity = tostring(Properties['gen_ai.agent.name']), Model = tostring(Properties['gen_ai.request.model']), InTok = toreal(tolong(Properties['gen_ai.usage.input_tokens'])), OutTok = toreal(tolong(Properties['gen_ai.usage.output_tokens'])), LatencyMs = toreal(DurationMs), ConversationId = tostring(Properties['gen_ai.conversation.id'])),\r\n(ASimAgentEventLogs | extend Platform = 'OpenAI', AgentName = coalesce(tostring(TargetAgentName), tostring(SrcAgentName), tostring(ModelName)), Identity = coalesce(tostring(ActorUsername), tostring(ActorUserId)), Model = tostring(ModelName), InTok = toreal(tolong(InputTokensUsed)), OutTok = toreal(tolong(OutputTokensUsed)), LatencyMs = iff(isnotempty(EventStartTime) and isnotempty(EventEndTime), toreal(datetime_diff('millisecond', EventEndTime, EventStartTime)), toreal(0)), ConversationId = tostring(EventSessionId))\r\n| project TimeGenerated, Platform, AgentName, Identity, Model, InTok, OutTok, LatencyMs, ConversationId;AIRequests | summarize Requests = count() by bin(TimeGenerated, 1d), Platform",
              "size": 0,
              "visualization": "barchart",
              "title": "Requests by day (platform)",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "us-day"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let AIRequests = union isfuzzy=true\r\n(datatable(TimeGenerated:datetime, Platform:string, AgentName:string, Identity:string, Model:string, InTok:real, OutTok:real, LatencyMs:real, ConversationId:string)[]),\r\n(CopilotActivity | where RecordType == 'CopilotInteraction' | extend Platform = 'M365 Copilot', AgentName = tostring(AgentName), Identity = tostring(ActorName), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(LLMEventData.ConversationId)),\r\n(AppEvents | where Name == 'BotMessageReceived' | extend Platform = 'Copilot Studio', AgentName = tostring(UserId), Identity = tostring(UserId), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(Properties['conversationId'])),\r\n(AppDependencies | where isnotempty(tostring(Properties['gen_ai.agent.name'])) | extend Platform = 'Azure AI Foundry', AgentName = tostring(Properties['gen_ai.agent.name']), Identity = tostring(Properties['gen_ai.agent.name']), Model = tostring(Properties['gen_ai.request.model']), InTok = toreal(tolong(Properties['gen_ai.usage.input_tokens'])), OutTok = toreal(tolong(Properties['gen_ai.usage.output_tokens'])), LatencyMs = toreal(DurationMs), ConversationId = tostring(Properties['gen_ai.conversation.id'])),\r\n(ASimAgentEventLogs | extend Platform = 'OpenAI', AgentName = coalesce(tostring(TargetAgentName), tostring(SrcAgentName), tostring(ModelName)), Identity = coalesce(tostring(ActorUsername), tostring(ActorUserId)), Model = tostring(ModelName), InTok = toreal(tolong(InputTokensUsed)), OutTok = toreal(tolong(OutputTokensUsed)), LatencyMs = iff(isnotempty(EventStartTime) and isnotempty(EventEndTime), toreal(datetime_diff('millisecond', EventEndTime, EventStartTime)), toreal(0)), ConversationId = tostring(EventSessionId))\r\n| project TimeGenerated, Platform, AgentName, Identity, Model, InTok, OutTok, LatencyMs, ConversationId;AIRequests | where isnotempty(Model) | summarize Requests = count(), Tokens = sum(InTok + OutTok) by Model | top 15 by Requests desc",
              "size": 1,
              "visualization": "barchart",
              "title": "Requests by model",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "us-model"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let AIRequests = union isfuzzy=true\r\n(datatable(TimeGenerated:datetime, Platform:string, AgentName:string, Identity:string, Model:string, InTok:real, OutTok:real, LatencyMs:real, ConversationId:string)[]),\r\n(CopilotActivity | where RecordType == 'CopilotInteraction' | extend Platform = 'M365 Copilot', AgentName = tostring(AgentName), Identity = tostring(ActorName), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(LLMEventData.ConversationId)),\r\n(AppEvents | where Name == 'BotMessageReceived' | extend Platform = 'Copilot Studio', AgentName = tostring(UserId), Identity = tostring(UserId), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(Properties['conversationId'])),\r\n(AppDependencies | where isnotempty(tostring(Properties['gen_ai.agent.name'])) | extend Platform = 'Azure AI Foundry', AgentName = tostring(Properties['gen_ai.agent.name']), Identity = tostring(Properties['gen_ai.agent.name']), Model = tostring(Properties['gen_ai.request.model']), InTok = toreal(tolong(Properties['gen_ai.usage.input_tokens'])), OutTok = toreal(tolong(Properties['gen_ai.usage.output_tokens'])), LatencyMs = toreal(DurationMs), ConversationId = tostring(Properties['gen_ai.conversation.id'])),\r\n(ASimAgentEventLogs | extend Platform = 'OpenAI', AgentName = coalesce(tostring(TargetAgentName), tostring(SrcAgentName), tostring(ModelName)), Identity = coalesce(tostring(ActorUsername), tostring(ActorUserId)), Model = tostring(ModelName), InTok = toreal(tolong(InputTokensUsed)), OutTok = toreal(tolong(OutputTokensUsed)), LatencyMs = iff(isnotempty(EventStartTime) and isnotempty(EventEndTime), toreal(datetime_diff('millisecond', EventEndTime, EventStartTime)), toreal(0)), ConversationId = tostring(EventSessionId))\r\n| project TimeGenerated, Platform, AgentName, Identity, Model, InTok, OutTok, LatencyMs, ConversationId;AIRequests | where isnotempty(Identity) | summarize Requests = count(), Agents = dcount(AgentName) by Identity | top 20 by Requests desc",
              "size": 1,
