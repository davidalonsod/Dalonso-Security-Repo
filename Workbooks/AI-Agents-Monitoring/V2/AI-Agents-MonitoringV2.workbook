          {
            "type": 1,
            "content": {
              "json": "#### Authentication and policy blocks\n\nReplicates `APIMRepeatedUnauthorizedRequests` with at least 10 `401` or `403` responses from one agent/caller in five minutes. `401` usually indicates missing, invalid, or expired authentication; `403` can represent authorization, IP, quota, or content-policy denial. Review policy traces before attributing the control."
            },
            "name": "apim-auth-abuse-desc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppRequests\n| where SDKVersion startswith \"apim:\" or tostring(Properties[\"Service Type\"]) =~ \"API Management\"\n| where ResultCode in (\"401\", \"403\")\n| extend Caller=coalesce(UserAuthenticatedId, UserId, tostring(Properties[\"Subscription ID\"]), tostring(Properties[\"SubscriptionId\"]), tostring(Properties[\"subscriptionId\"]), ClientIP, \"unknown\"), APIName=coalesce(tostring(Properties[\"API Name\"]), Name)\n| extend AgentKey=coalesce(tostring(Properties[\"AgentId\"]), tostring(Properties[\"Agent ID\"]), tostring(Properties[\"ApplicationId\"]), tostring(Properties[\"Application ID\"]), AppRoleName, Caller)\n| summarize DeniedRequests=sum(ItemCount), DistinctOperations=dcount(Name), Operations=make_set(Name, 20), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated), Caller=take_any(Caller), ClientIP=take_any(ClientIP), Country=take_any(ClientCountryOrRegion) by bin(TimeGenerated, 5m), AgentKey, APIName, ResultCode\n| where DeniedRequests >= 10\n| extend Signal=case(ResultCode == \"401\", \"REPEATED AUTHENTICATION FAILURES\", \"REPEATED POLICY OR AUTHORIZATION DENIALS\")\n| project TimeGenerated, Signal, AgentKey, Caller, ClientIP, Country, APIName, ResultCode, DeniedRequests, DistinctOperations, Operations, FirstSeen, LastSeen\n| order by DeniedRequests desc",
              "size": 0,
              "title": "Authentication and policy-block bursts (401 / 403)",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "DeniedRequests",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  },
                  {
                    "columnMatch": "DistinctOperations",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "yellow"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{APIMWorkspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "apim-auth-abuse",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "workspace"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "requests\n| where sdkVersion startswith \"apim:\" or tostring(customDimensions[\"Service Type\"]) =~ \"API Management\"\n| where resultCode in (\"401\", \"403\")\n| extend Caller=coalesce(user_AuthenticatedId, user_Id, tostring(customDimensions[\"Subscription ID\"]), tostring(customDimensions[\"SubscriptionId\"]), tostring(customDimensions[\"subscriptionId\"]), client_IP, \"unknown\"), APIName=coalesce(tostring(customDimensions[\"API Name\"]), name)\n| extend AgentKey=coalesce(tostring(customDimensions[\"AgentId\"]), tostring(customDimensions[\"Agent ID\"]), tostring(customDimensions[\"ApplicationId\"]), tostring(customDimensions[\"Application ID\"]), cloud_RoleName, Caller)\n| summarize DeniedRequests=sum(itemCount), DistinctOperations=dcount(name), Operations=make_set(name, 20), FirstSeen=min(timestamp), LastSeen=max(timestamp), Caller=take_any(Caller), client_IP=take_any(client_IP), Country=take_any(client_CountryOrRegion) by bin(timestamp, 5m), AgentKey, APIName, resultCode\n| where DeniedRequests >= 10\n| extend Signal=case(resultCode == \"401\", \"REPEATED AUTHENTICATION FAILURES\", \"REPEATED POLICY OR AUTHORIZATION DENIALS\")\n| project timestamp, Signal, AgentKey, Caller, client_IP, Country, APIName, resultCode, DeniedRequests, DistinctOperations, Operations, FirstSeen, LastSeen\n| order by DeniedRequests desc",
              "size": 0,
              "title": "Authentication and policy-block bursts (401 / 403)",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "DeniedRequests",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  },
                  {
                    "columnMatch": "DistinctOperations",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "yellow"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{APIMApplicationInsights}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "apim-auth-abuse-appinsights",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "applicationInsights"
            }
          },
          {
            "type": 1,
            "content": {
              "json": "#### API enumeration and automated scanning\n\nReplicates `APIMApiEnumeration`: at least 20 requests across 10 operations or URL paths in ten minutes. Unlike the 404-only reconnaissance panel, this includes successful calls and distinguishes high-error scanning from successful or mixed capability enumeration. API tests and broad legitimate workflows require tuning."
            },
            "name": "apim-api-enumeration-desc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppRequests\n| where SDKVersion startswith \"apim:\" or tostring(Properties[\"Service Type\"]) =~ \"API Management\"\n| extend Caller=coalesce(UserAuthenticatedId, UserId, tostring(Properties[\"Subscription ID\"]), tostring(Properties[\"SubscriptionId\"]), tostring(Properties[\"subscriptionId\"]), ClientIP, \"unknown\"), APIName=coalesce(tostring(Properties[\"API Name\"]), Name), Operation=coalesce(tostring(Properties[\"Operation Name\"]), Name), Route=tostring(parse_url(Url)[\"Path\"]), Code=toint(ResultCode)\n| extend AgentKey=coalesce(tostring(Properties[\"AgentId\"]), tostring(Properties[\"Agent ID\"]), tostring(Properties[\"ApplicationId\"]), tostring(Properties[\"Application ID\"]), AppRoleName, Caller)\n| summarize Requests=sum(ItemCount), DistinctOperations=dcount(Operation), DistinctRoutes=dcount(Route), Errors=sum(iff(Code >= 400, ItemCount, 0)), Operations=make_set(Operation, 30), Routes=make_set(Route, 30), ResultCodes=make_set(ResultCode, 12), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated), Caller=take_any(Caller), ClientIP=take_any(ClientIP), Country=take_any(ClientCountryOrRegion) by bin(TimeGenerated, 10m), AgentKey, APIName\n| extend ErrorRate=round(100.0 * todouble(Errors) / max_of(todouble(Requests), 1.0), 2)\n| where Requests >= 20 and (DistinctOperations >= 10 or DistinctRoutes >= 10)\n| extend Signal=case(ErrorRate >= 50.0, \"HIGH-ERROR API SCANNING\", \"SUCCESSFUL OR MIXED API ENUMERATION\")\n| project TimeGenerated, Signal, AgentKey, Caller, ClientIP, Country, APIName, Requests, DistinctOperations, DistinctRoutes, Errors, ErrorRate, Operations, Routes, ResultCodes, FirstSeen, LastSeen\n| order by DistinctOperations desc, DistinctRoutes desc",
              "size": 0,
              "title": "Potential API enumeration or automated scanning",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Signal",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "ErrorRate",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{APIMWorkspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "apim-api-enumeration",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "workspace"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "requests\n| where sdkVersion startswith \"apim:\" or tostring(customDimensions[\"Service Type\"]) =~ \"API Management\"\n| extend Caller=coalesce(user_AuthenticatedId, user_Id, tostring(customDimensions[\"Subscription ID\"]), tostring(customDimensions[\"SubscriptionId\"]), tostring(customDimensions[\"subscriptionId\"]), client_IP, \"unknown\"), APIName=coalesce(tostring(customDimensions[\"API Name\"]), name), Operation=coalesce(tostring(customDimensions[\"Operation Name\"]), name), Route=tostring(parse_url(url)[\"Path\"]), Code=toint(resultCode)\n| extend AgentKey=coalesce(tostring(customDimensions[\"AgentId\"]), tostring(customDimensions[\"Agent ID\"]), tostring(customDimensions[\"ApplicationId\"]), tostring(customDimensions[\"Application ID\"]), cloud_RoleName, Caller)\n| summarize Requests=sum(itemCount), DistinctOperations=dcount(Operation), DistinctRoutes=dcount(Route), Errors=sum(iff(Code >= 400, itemCount, 0)), Operations=make_set(Operation, 30), Routes=make_set(Route, 30), ResultCodes=make_set(resultCode, 12), FirstSeen=min(timestamp), LastSeen=max(timestamp), Caller=take_any(Caller), client_IP=take_any(client_IP), Country=take_any(client_CountryOrRegion) by bin(timestamp, 10m), AgentKey, APIName\n| extend ErrorRate=round(100.0 * todouble(Errors) / max_of(todouble(Requests), 1.0), 2)\n| where Requests >= 20 and (DistinctOperations >= 10 or DistinctRoutes >= 10)\n| extend Signal=case(ErrorRate >= 50.0, \"HIGH-ERROR API SCANNING\", \"SUCCESSFUL OR MIXED API ENUMERATION\")\n| project timestamp, Signal, AgentKey, Caller, client_IP, Country, APIName, Requests, DistinctOperations, DistinctRoutes, Errors, ErrorRate, Operations, Routes, ResultCodes, FirstSeen, LastSeen\n| order by DistinctOperations desc, DistinctRoutes desc",
              "size": 0,
              "title": "Potential API enumeration or automated scanning",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Signal",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "ErrorRate",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{APIMApplicationInsights}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "apim-api-enumeration-appinsights",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "applicationInsights"
            }
          },
          {
            "type": 1,
            "content": {
              "json": "#### Sustained high API failure rate\n\nReplicates `APIMHighFailureRate`: at least 20 requests with a 50% failure rate per agent/caller, API, and operation in 30 minutes. This catches gradual degradation and malformed-request loops that do not meet concentrated `429` or `5xx` thresholds. It can overlap auth and availability panels by design."
            },
            "name": "apim-high-failure-desc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppRequests\n| where SDKVersion startswith \"apim:\" or tostring(Properties[\"Service Type\"]) =~ \"API Management\"\n| extend Caller=coalesce(UserAuthenticatedId, UserId, tostring(Properties[\"Subscription ID\"]), tostring(Properties[\"SubscriptionId\"]), tostring(Properties[\"subscriptionId\"]), ClientIP, \"unknown\"), APIName=coalesce(tostring(Properties[\"API Name\"]), Name), Operation=coalesce(tostring(Properties[\"Operation Name\"]), Name), Failed=Success == false or toint(ResultCode) >= 400\n| extend AgentKey=coalesce(tostring(Properties[\"AgentId\"]), tostring(Properties[\"Agent ID\"]), tostring(Properties[\"ApplicationId\"]), tostring(Properties[\"Application ID\"]), AppRoleName, Caller)\n| summarize TotalRequests=sum(ItemCount), FailedRequests=sum(iff(Failed, ItemCount, 0)), ServerErrors=sum(iff(toint(ResultCode) between (500 .. 599), ItemCount, 0)), ResultCodes=make_set(ResultCode, 12), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated), Caller=take_any(Caller), ClientIP=take_any(ClientIP), Country=take_any(ClientCountryOrRegion) by bin(TimeGenerated, 30m), AgentKey, APIName, Operation\n| extend FailureRate=round(100.0 * todouble(FailedRequests) / max_of(todouble(TotalRequests), 1.0), 2)\n| where TotalRequests >= 20 and FailureRate >= 50.0\n| extend Signal=case(ServerErrors >= 10, \"HIGH FAILURE RATE WITH SERVER IMPACT\", \"HIGH API FAILURE RATE\")\n| project TimeGenerated, Signal, AgentKey, Caller, ClientIP, Country, APIName, Operation, TotalRequests, FailedRequests, ServerErrors, FailureRate, ResultCodes, FirstSeen, LastSeen\n| order by FailureRate desc, TotalRequests desc",
              "size": 0,
              "title": "High failure rate by agent, API, and operation",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Signal",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "FailureRate",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{APIMWorkspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "apim-high-failure",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "workspace"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "requests\n| where sdkVersion startswith \"apim:\" or tostring(customDimensions[\"Service Type\"]) =~ \"API Management\"\n| extend Caller=coalesce(user_AuthenticatedId, user_Id, tostring(customDimensions[\"Subscription ID\"]), tostring(customDimensions[\"SubscriptionId\"]), tostring(customDimensions[\"subscriptionId\"]), client_IP, \"unknown\"), APIName=coalesce(tostring(customDimensions[\"API Name\"]), name), Operation=coalesce(tostring(customDimensions[\"Operation Name\"]), name), Failed=success == false or toint(resultCode) >= 400\n| extend AgentKey=coalesce(tostring(customDimensions[\"AgentId\"]), tostring(customDimensions[\"Agent ID\"]), tostring(customDimensions[\"ApplicationId\"]), tostring(customDimensions[\"Application ID\"]), cloud_RoleName, Caller)\n| summarize TotalRequests=sum(itemCount), FailedRequests=sum(iff(Failed, itemCount, 0)), ServerErrors=sum(iff(toint(resultCode) between (500 .. 599), itemCount, 0)), ResultCodes=make_set(resultCode, 12), FirstSeen=min(timestamp), LastSeen=max(timestamp), Caller=take_any(Caller), client_IP=take_any(client_IP), Country=take_any(client_CountryOrRegion) by bin(timestamp, 30m), AgentKey, APIName, Operation\n| extend FailureRate=round(100.0 * todouble(FailedRequests) / max_of(todouble(TotalRequests), 1.0), 2)\n| where TotalRequests >= 20 and FailureRate >= 50.0\n| extend Signal=case(ServerErrors >= 10, \"HIGH FAILURE RATE WITH SERVER IMPACT\", \"HIGH API FAILURE RATE\")\n| project timestamp, Signal, AgentKey, Caller, client_IP, Country, APIName, Operation, TotalRequests, FailedRequests, ServerErrors, FailureRate, ResultCodes, FirstSeen, LastSeen\n| order by FailureRate desc, TotalRequests desc",
              "size": 0,
              "title": "High failure rate by agent, API, and operation",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Signal",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "FailureRate",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{APIMApplicationInsights}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "apim-high-failure-appinsights",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "applicationInsights"
            }
          },
          {
            "type": 1,
            "content": {
              "json": "#### Throttling and denial-of-wallet pressure\n\n`429` events show that a request-rate or token-rate control rejected traffic. Review the caller, operations, time window, token metrics, and `Retry-After` behavior. A working limit can produce this signal during load tests or legitimate bursts; sustained or distributed throttling can indicate automation abuse, runaway agents, or denial-of-wallet pressure."
            },
            "name": "apim-throttling-desc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppRequests\n| where SDKVersion startswith \"apim:\" and ResultCode == \"429\"\n| extend Caller = coalesce(UserAuthenticatedId, UserId, ClientIP, \"unknown\")\n| summarize Throttled = count(), Operations = dcount(Name), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by bin(TimeGenerated, 5m), Caller\n| order by Throttled desc",
              "size": 0,
              "title": "Request / token throttling and denial-of-wallet pressure",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Throttled",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{APIMWorkspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "apim-throttling",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "workspace"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "requests\n| where sdkVersion startswith \"apim:\" and resultCode == \"429\"\n| extend Caller = coalesce(user_AuthenticatedId, user_Id, client_IP, \"unknown\")\n| summarize Throttled = count(), Operations = dcount(name), FirstSeen = min(timestamp), LastSeen = max(timestamp) by bin(timestamp, 5m), Caller\n| order by Throttled desc",
              "size": 0,
              "title": "Request / token throttling and denial-of-wallet pressure",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Throttled",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{APIMApplicationInsights}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "apim-throttling-appinsights",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "applicationInsights"
            }
          },
          {
            "type": 1,
            "content": {
              "json": "#### Caller-level availability pressure\n\nReplicates `APIMAvailabilityPressure` with its alert thresholds: at least 10 throttles, at least 10 server failures, or at least 20 requests with a combined `429`/`5xx` rate of 70% in five minutes. A `429` can represent a working control, while repeated `5xx` responses can indicate backend impact or an operational fault."
            },
            "name": "apim-availability-pressure-desc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppRequests\n| where SDKVersion startswith \"apim:\" or tostring(Properties[\"Service Type\"]) =~ \"API Management\"\n| extend Caller = coalesce(UserAuthenticatedId, UserId, ClientIP, \"unknown\"), APIName = tostring(Properties[\"API Name\"]), Code = toint(ResultCode)\n| summarize TotalRequests = count(), Throttled = countif(Code == 429), ServerErrors = countif(Code between (500 .. 599)), Timeouts = countif(Code in (408, 504)), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated), Models = make_set(tostring(Properties[\"Backend Method\"]), 10) by bin(TimeGenerated, 5m), Caller, APIName, Name\n| extend PressureEvents = Throttled + ServerErrors, FailureRate = round(100.0 * todouble(Throttled + ServerErrors) / todouble(TotalRequests), 2)\n| where Throttled >= 10 or ServerErrors >= 10 or (TotalRequests >= 20 and FailureRate >= 70.0)\n| extend Signal = case(ServerErrors >= 10, \"BACKEND AVAILABILITY IMPACT\", Throttled >= 10, \"RATE OR TOKEN LIMIT PRESSURE\", \"HIGH FAILURE CONCENTRATION\")\n| project TimeGenerated, Signal, Caller, APIName, Name, TotalRequests, Throttled, ServerErrors, Timeouts, FailureRate, Models, FirstSeen, LastSeen\n| order by TimeGenerated desc",
              "size": 0,
              "title": "Availability pressure by APIM caller",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Signal",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "FailureRate",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{APIMWorkspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "apim-availability-pressure",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "workspace"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "requests\n| where sdkVersion startswith \"apim:\" or tostring(customDimensions[\"Service Type\"]) =~ \"API Management\"\n| extend Caller = coalesce(user_AuthenticatedId, user_Id, client_IP, \"unknown\"), APIName = tostring(customDimensions[\"API Name\"]), Code = toint(resultCode)\n| summarize TotalRequests = count(), Throttled = countif(Code == 429), ServerErrors = countif(Code between (500 .. 599)), Timeouts = countif(Code in (408, 504)), FirstSeen = min(timestamp), LastSeen = max(timestamp), Models = make_set(tostring(customDimensions[\"Backend Method\"]), 10) by bin(timestamp, 5m), Caller, APIName, name\n| extend PressureEvents = Throttled + ServerErrors, FailureRate = round(100.0 * todouble(Throttled + ServerErrors) / todouble(TotalRequests), 2)\n| where Throttled >= 10 or ServerErrors >= 10 or (TotalRequests >= 20 and FailureRate >= 70.0)\n| extend Signal = case(ServerErrors >= 10, \"BACKEND AVAILABILITY IMPACT\", Throttled >= 10, \"RATE OR TOKEN LIMIT PRESSURE\", \"HIGH FAILURE CONCENTRATION\")\n| project timestamp, Signal, Caller, APIName, name, TotalRequests, Throttled, ServerErrors, Timeouts, FailureRate, Models, FirstSeen, LastSeen\n| order by timestamp desc",
              "size": 0,
              "title": "Availability pressure by APIM caller",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Signal",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "FailureRate",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{APIMApplicationInsights}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "apim-availability-pressure-appinsights",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "applicationInsights"
            }
          },
          {
            "type": 1,
            "content": {
              "json": "#### Potential API route reconnaissance\n\nThis grid expands every `404` event that belongs to a suspicious five-minute burst. It shows the attempted method and URL, APIM operation, caller, request and operation IDs, burst size, distinct-route count, service/region, and latency. Review unusual paths such as framework probes, admin endpoints, batch APIs, or repeated root requests. Deployment health checks, stale clients, and mistyped routes are common false positives."
            },
            "name": "apim-recon-desc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let Events = materialize(\n    AppRequests\n    | where SDKVersion startswith \"apim:\" and ResultCode == \"404\"\n    | extend Caller = coalesce(UserAuthenticatedId, UserId, ClientIP, \"unknown\"),\n        Window = bin(TimeGenerated, 5m),\n        HTTPMethod = coalesce(tostring(Properties[\"HTTP Method\"]), tostring(split(Name, \" \")[0])),\n        RequestId = tostring(Properties[\"Request Id\"]),\n        ServiceName = tostring(Properties[\"Service Name\"]),\n        Region = tostring(Properties[\"Region\"])\n);\nlet Bursts = Events\n| summarize BurstRequests = count(), DistinctRoutes = dcount(Url), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by Window, Caller\n| where BurstRequests >= 5 or DistinctRoutes >= 3;\nEvents\n| join kind=inner Bursts on Window, Caller\n| extend Risk = case(DistinctRoutes >= 10 or BurstRequests >= 20, \"HIGH\", \"MEDIUM\")\n| project TimeGenerated, Risk, Caller, HTTPMethod, Operation = Name, Url,\n    RequestId, OperationId, BurstRequests, DistinctRoutes, FirstSeen, LastSeen,\n    DurationMs, ServiceName, Region, AppRoleName\n| order by TimeGenerated desc\n| take 250",
              "size": 0,
              "title": "Potential API route reconnaissance — event details from 404 bursts",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Risk",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "BurstRequests",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  },
                  {
                    "columnMatch": "DistinctRoutes",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "yellow"
                    }
                  },
                  {
                    "columnMatch": "Url",
                    "formatter": 1
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{APIMWorkspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "apim-recon",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "workspace"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let Events = materialize(\n    requests\n    | where sdkVersion startswith \"apim:\" and resultCode == \"404\"\n    | extend Caller = coalesce(user_AuthenticatedId, user_Id, client_IP, \"unknown\"),\n        Window = bin(timestamp, 5m),\n        HTTPMethod = coalesce(tostring(customDimensions[\"HTTP Method\"]), tostring(split(name, \" \")[0])),\n        RequestId = tostring(customDimensions[\"Request Id\"]),\n        ServiceName = tostring(customDimensions[\"Service Name\"]),\n        Region = tostring(customDimensions[\"Region\"])\n);\nlet Bursts = Events\n| summarize BurstRequests = count(), DistinctRoutes = dcount(url), FirstSeen = min(timestamp), LastSeen = max(timestamp) by Window, Caller\n| where BurstRequests >= 5 or DistinctRoutes >= 3;\nEvents\n| join kind=inner Bursts on Window, Caller\n| extend Risk = case(DistinctRoutes >= 10 or BurstRequests >= 20, \"HIGH\", \"MEDIUM\")\n| project timestamp, Risk, Caller, HTTPMethod, Operation = name, url,\n    RequestId, operation_Id, BurstRequests, DistinctRoutes, FirstSeen, LastSeen,\n    duration, ServiceName, Region, cloud_RoleName\n| order by timestamp desc\n| take 250",
              "size": 0,
              "title": "Potential API route reconnaissance — event details from 404 bursts",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Risk",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "BurstRequests",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  },
                  {
                    "columnMatch": "DistinctRoutes",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "yellow"
                    }
                  },
                  {
                    "columnMatch": "url",
                    "formatter": 1
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{APIMApplicationInsights}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "apim-recon-appinsights",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "applicationInsights"
            }
          },
          {
            "type": 1,
            "content": {
              "json": "#### Prompt Shield and content-safety enforcement\n\nThis grid shows one row per sanitized APIM policy trace, then enriches it with the correlated request result and route when available. `Signal` distinguishes prompt-attack markers from other content-safety events; `Control`, `ContentLogged`, and `Message` should contain only approved low-cardinality metadata. Investigate repeated attempts, affected operations, caller identity, policy mode, and whether the request was actually blocked. Never put prompt text, credentials, or regulated data in APIM trace metadata."
            },
            "name": "apim-safety-events-desc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let SafetyEvents = AppTraces\n| where SDKVersion startswith \"apim:\"\n| extend MatchText = strcat(Message, \" \", tostring(Properties))\n| where MatchText has_any (\"prompt_injection_blocked\", \"prompt shield\", \"prompt injection\", \"jailbreak\", \"content safety\")\n| extend Signal = case(MatchText has_any (\"prompt_injection_blocked\", \"prompt shield\", \"prompt injection\", \"jailbreak\"), \"Prompt attack blocked\", \"Content safety event\"),\n    Severity = case(SeverityLevel >= 4, \"CRITICAL\", SeverityLevel == 3, \"HIGH\", SeverityLevel == 2, \"MEDIUM\", \"INFORMATIONAL\"),\n    Control = tostring(Properties[\"control\"]),\n    ContentLogged = tostring(Properties[\"content_logged\"]),\n    ServiceName = tostring(Properties[\"Service Name\"]),\n    Region = tostring(Properties[\"Region\"])\n| project TimeGenerated, OperationId, Signal, Severity, SeverityLevel,\n    Message, Control, ContentLogged, ServiceName, Region, AppRoleName, SDKVersion;\nlet Requests = AppRequests\n| where SDKVersion startswith \"apim:\"\n| summarize arg_max(TimeGenerated, *) by OperationId\n| project OperationId, RequestResult = ResultCode, RequestBlocked = Success == false,\n    RequestOperation = Name, RequestUrl = Url,\n    Caller = coalesce(UserAuthenticatedId, UserId, ClientIP, \"unknown\"),\n    RequestId = tostring(Properties[\"Request Id\"]);\nSafetyEvents\n| join kind=leftouter Requests on OperationId\n| project TimeGenerated, Signal, Severity, Message, Control, ContentLogged,\n    RequestResult, RequestBlocked, Caller, RequestOperation, RequestUrl,\n    RequestId, OperationId, ServiceName, Region, AppRoleName\n| order by TimeGenerated desc\n| take 250",
              "size": 0,
              "title": "Prompt Shield / content-safety events — sanitized event details",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Signal",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "Severity",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "RequestBlocked",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "RequestUrl",
                    "formatter": 1
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{APIMWorkspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "apim-safety-events",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "workspace"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let SafetyEvents = traces\n| where sdkVersion startswith \"apim:\"\n| extend MatchText = strcat(message, \" \", tostring(customDimensions))\n| where MatchText has_any (\"prompt_injection_blocked\", \"prompt shield\", \"prompt injection\", \"jailbreak\", \"content safety\")\n| extend Signal = case(MatchText has_any (\"prompt_injection_blocked\", \"prompt shield\", \"prompt injection\", \"jailbreak\"), \"Prompt attack blocked\", \"Content safety event\"),\n    Severity = case(severityLevel >= 4, \"CRITICAL\", severityLevel == 3, \"HIGH\", severityLevel == 2, \"MEDIUM\", \"INFORMATIONAL\"),\n    Control = tostring(customDimensions[\"control\"]),\n    ContentLogged = tostring(customDimensions[\"content_logged\"]),\n    ServiceName = tostring(customDimensions[\"Service Name\"]),\n    Region = tostring(customDimensions[\"Region\"])\n| project timestamp, operation_Id, Signal, Severity, severityLevel,\n    message, Control, ContentLogged, ServiceName, Region, cloud_RoleName, sdkVersion;\nlet Requests = requests\n| where sdkVersion startswith \"apim:\"\n| summarize arg_max(timestamp, *) by operation_Id\n| project operation_Id, RequestResult = resultCode, RequestBlocked = success == false,\n    RequestOperation = name, RequestUrl = url,\n    Caller = coalesce(user_AuthenticatedId, user_Id, client_IP, \"unknown\"),\n    RequestId = tostring(customDimensions[\"Request Id\"]);\nSafetyEvents\n| join kind=leftouter Requests on operation_Id\n| project timestamp, Signal, Severity, message, Control, ContentLogged,\n    RequestResult, RequestBlocked, Caller, RequestOperation, RequestUrl,\n    RequestId, operation_Id, ServiceName, Region, cloud_RoleName\n| order by timestamp desc\n| take 250",
              "size": 0,
              "title": "Prompt Shield / content-safety events — sanitized event details",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Signal",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "Severity",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "RequestBlocked",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "RequestUrl",
                    "formatter": 1
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{APIMApplicationInsights}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "apim-safety-events-appinsights",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "applicationInsights"
            }
          },
          {
            "type": 1,
            "content": {
              "json": "### Configuration and interpretation\n\n- Use an Application Insights **connection string with APIM managed identity** and grant **Monitoring Metrics Publisher**.\n- APIM rows are isolated with `SDKVersion startswith 'apim:'` or `Service Type == API Management`. Microsoft does not guarantee the SDK prefix; verify the signature after onboarding.\n- Set diagnostics to **always log errors**. Tune sampling for traffic volume; Application Insights is observability telemetry, not an audit log.\n- This version intentionally renders `Request-Body` and `Response-Body` for investigation. These fields can expose prompts, system instructions, tool schemas, credentials, personal data, and regulated content. Restrict access, retention, exports, screenshots, and incident copies. Mask authorization headers and query parameters.\n- In Application Insights resource scope use `requests` / `customDimensions`; in Log Analytics use `AppRequests` / `Properties`.\n- `AppGenAIContent` is generated by agent OpenTelemetry instrumentation, not APIM. Configure it as a **protected table**.\n- Starting **September 30, 2026**, new GenAI content values move out of `AppDependencies`, `AppTraces`, and `AppEvents` into `AppGenAIContent`; structural spans remain in requests/dependencies.\n- `llm-emit-token-metric` supports OpenAI, Anthropic, and Google Vertex AI schemas. Streaming requests need usage data in the response; for applicable OpenAI APIs set `include_usage=true`.\n- Custom metrics allow at most five custom dimensions in APIM. Avoid high-cardinality consumer, prompt, conversation, or request identifiers.\n- A blank correlation panel means either no agent OTel spans share this workspace or W3C `traceparent` was not propagated end to end.",
              "style": "warning"
            },
            "name": "apim-notes"
          }
        ]
      },
      "name": "group-apim"
    },
    {
      "type": 12,
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "advhunt"
      },
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## 🔬 Defender XDR & Agents — Advanced Hunting\n\nReads **BehaviorInfo** (AI-agent interaction behaviors incl. Microsoft **Prompt Shield** jailbreak detections), **BehaviorEntities**, **AgentsInfo** (cloud and local agent inventory, configuration, MCP servers and tools), **ExposureGraphNodes / ExposureGraphEdges** (critical-device and identity blast radius), and **AADAgentRiskEvents** (Microsoft Entra **Agent ID risk** detections). Local agent discovery and `AgentsInfo` require Defender for Endpoint Plan 2; inventory risk indicators and recommendations require Microsoft 365 E7 or Microsoft Agent 365 with Defender for Endpoint Plan 2. Local discovery is currently Preview.\n\n**How to read this tab:** separate behavior detections from inventory posture. `BehaviorInfo` records Defender audit/block behaviors and joins to `BehaviorEntities` by `BehaviorId`; `AgentsInfo` contains multiple snapshots, so inventory panels select the latest state per `AgentId`. Local-agent exposure panels resolve relationships through `ExposureGraphNodes` and `ExposureGraphEdges`; reachability is potential blast radius, not observed exploitation. The workbook queries the copies available in the selected Sentinel workspace. Missing optional exposure-graph tables produce empty results rather than errors; use Defender Advanced Hunting for tenant-native investigation.",
              "style": "info"
            },
            "name": "ah-h"
          },
          {
            "type": 1,
            "content": {
              "json": "### Defender-native Advanced Hunting scope\n\nThese panels query Microsoft Defender Advanced Hunting directly. The visible Sentinel `Workspace` picker drives a hidden Azure Resource Graph lookup of that workspace's customer ID, which the workbook passes to the Advanced Hunting **Workspaces** selector. If the selector remains blank, connect the selected Sentinel workspace in [Microsoft Defender](https://security.microsoft.com/) under **System → Settings → Microsoft Sentinel → Connect a workspace**, select the primary workspace when appropriate, and reopen the workbook. `AgentsInfo`, `BehaviorInfo`, `BehaviorEntities`, `ExposureGraphNodes/Edges`, `AADAgentRiskEvents`, `DeviceProcessEvents`, and `CloudAppEvents` remain on their authoritative Defender surface.",
              "style": "warning"
            },
            "name": "ah-workspace-prerequisite"
          },
          {
            "type": 1,
            "content": {
              "json": "▶️ **Run directly in Advanced Hunting** — open [security.microsoft.com › Advanced hunting](https://security.microsoft.com/v2/advanced-hunting) and paste any of these (the same tables this tab reads):\r\n\r\n```kql\r\nBehaviorInfo\r\n| where ActionType contains 'PromptShield' or ActionType contains 'Jailbreak'\r\n| extend AgentName = tostring(todynamic(AdditionalFields).AgentName)\r\n| project Timestamp, ActionType, Description, AgentName, AccountUpn, DetectionSource\r\n\r\nAgentsInfo\r\n| summarize arg_max(TimeGenerated, *) by AgentId\r\n| project Name, Platform, Model, PublishedStatus, Channels, McpServers, Owners\r\n\r\nAADAgentRiskEvents\r\n| summarize arg_max(TimeGenerated, *) by Id\r\n| project DetectedDateTime, AgentDisplayName, AgentId, RiskLevel, RiskState, RiskEventType, RiskEvidence\r\n```"
            },
            "name": "ah-run"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"union isfuzzy=true\\r\\n(BehaviorInfo | where isnotempty(tostring(todynamic(AdditionalFields).AgentName)) or ActionType contains 'Agent' or ActionType contains 'PromptShield' | summarize Value = count() | extend Metric = 'AI agent behaviors', Order = 1),\\r\\n(BehaviorInfo | where ActionType contains 'PromptShield' or ActionType contains 'Jailbreak' | summarize Value = count() | extend Metric = 'Prompt Shield / jailbreak', Order = 2),\\r\\n(AgentsInfo | summarize Value = dcount(AgentId) | extend Metric = 'Agents (inventory)', Order = 3),\\r\\n(AgentsInfo | where PublishedStatus =~ 'Published' | summarize Value = dcount(AgentId) | extend Metric = 'Published agents', Order = 4),\\r\\n(AgentsInfo | summarize Value = dcount(Platform) | extend Metric = 'Agent platforms', Order = 5),\\r\\n(AgentsInfo | where isnotempty(tostring(McpServers)) and tostring(McpServers) !in ('', '[]') | summarize Value = dcount(AgentId) | extend Metric = 'Agents with MCP', Order = 6),\\r\\n(AADAgentRiskEvents | summarize Value = dcount(Id) | extend Metric = 'Agent risk events', Order = 7),\\r\\n(AADAgentRiskEvents | where RiskLevel =~ 'high' or RiskState in~ ('confirmedCompromised', 'atRisk') | summarize Value = dcount(AgentId) | extend Metric = 'High-risk / compromised agents', Order = 8)\\r\\n| project Order, Metric, Value\\r\\n| sort by Order asc\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 3,
              "visualization": "tiles",
              "title": "Advanced Hunting metrics",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                }
              },
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-kpi"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"BehaviorInfo\\r\\n| where isnotempty(tostring(todynamic(AdditionalFields).AgentName)) or ActionType contains 'Agent' or ActionType contains 'PromptShield'\\r\\n| summarize Events = count() by bin(TimeGenerated, 1h), ActionType\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 0,
              "visualization": "timechart",
              "title": "AI agent behaviors over time (ActionType)",
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-time"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"BehaviorInfo\\r\\n| where ActionType contains 'PromptShield' or ActionType contains 'Jailbreak' or Description contains 'AI agent'\\r\\n| extend AgentName = tostring(todynamic(AdditionalFields).AgentName), HostingPlatform = tostring(todynamic(AdditionalFields).HostingPlatformType)\\r\\n| where '{AgentSearch}' == '' or AgentName has '{AgentSearch}' or AccountUpn has '{AgentSearch}'\\r\\n| project TimeGenerated, ThreatLevel = strcat('🔴 ', ActionType), Description, AgentName, HostingPlatform, AccountUpn, DetectionSource\\r\\n| order by TimeGenerated desc\\r\\n| take 100\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 0,
              "title": "🚨 Prompt Shield / jailbreak detections (BehaviorInfo)",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "ThreatLevel",
                    "formatter": 0
                  }
                ]
              },
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-ps"
          },
          {
            "type": 1,
            "content": {
              "json": "### 🤖 Agent inventory & governance (AgentsInfo)\n\n`AgentsInfo` is posture inventory, not runtime execution evidence. Use the latest snapshot per `AgentId` to review ownership, lifecycle, publication, authentication, knowledge, tools, MCP servers, and connected agents. Missing values may mean incomplete discovery; validate in the source platform before remediation. Prioritize ownerless or weakly authenticated agents that also have broad tools, sensitive knowledge, external endpoints, or active alerts."
            },
            "name": "ah-h2"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"let A = AgentsInfo | summarize arg_max(Timestamp, *) by AgentId;\\r\\nunion isfuzzy=true\\r\\n(A | summarize Value = count() | extend Metric = 'Total agents', Order = 1),\\r\\n(A | where PublishedStatus =~ 'Published' | summarize Value = count() | extend Metric = 'Published', Order = 2),\\r\\n(A | where PublishedStatus !~ 'Published' | summarize Value = count() | extend Metric = 'Unpublished', Order = 3),\\r\\n(A | where isempty(tostring(Owners)) or tostring(Owners) in ('', '[]') | summarize Value = count() | extend Metric = 'Ownerless', Order = 4),\\r\\n(A | where LastUpdatedDateTime < ago(30d) | summarize Value = count() | extend Metric = 'Inactive (>30d)', Order = 5),\\r\\n(A | where isnotempty(tostring(McpServers)) and tostring(McpServers) !in ('', '[]') | summarize Value = count() | extend Metric = 'With MCP servers', Order = 6),\\r\\n(A | summarize Value = dcount(Platform) | extend Metric = 'Platforms', Order = 7)\\r\\n| project Order, Metric, Value\\r\\n| sort by Order asc\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 3,
              "visualization": "tiles",
              "title": "Inventory metrics",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                }
              },
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "in-kpi"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"AgentsInfo\\r\\n| summarize arg_max(Timestamp, *) by AgentId\\r\\n| summarize Agents = count() by Platform\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 1,
              "visualization": "piechart",
              "title": "Agents by platform",
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-plat"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"AgentsInfo\\r\\n| summarize arg_max(Timestamp, *) by AgentId\\r\\n| where '{AgentSearch}' == '' or Name has '{AgentSearch}' or tostring(Model) has '{AgentSearch}' or Platform has '{AgentSearch}'\\r\\n| extend AgentType = case(\\r\\n    isnotempty(tostring(ConnectedAgents)) and tostring(ConnectedAgents) !in ('', '[]'), 'Multi-agent',\\r\\n    isnotempty(tostring(column_ifexists('Triggers', ''))) and tostring(column_ifexists('Triggers', '')) !in ('', '[]'), 'Workflow',\\r\\n    tostring(column_ifexists('Capabilities', '')) has 'autonom', 'Autonomous',\\r\\n    'Assistant')\\r\\n| project Name, Platform, AgentType, Model = tostring(Model), Version, Status = PublishedStatus, Lifecycle = LifecycleStatus,\\r\\n          Auth = tostring(ToolsAuthenticationType), Knowledge = tostring(column_ifexists('DeclaredDataSources', '')), Tools = tostring(column_ifexists('DeclaredTools', '')),\\r\\n          MCP = tostring(McpServers), ConnectedAgents = tostring(ConnectedAgents), Owners = tostring(Owners),\\r\\n          Created = CreatedDateTime, Modified = LastUpdatedDateTime\\r\\n| order by Modified desc\\r\\n| take 200\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 0,
              "title": "Agent inventory (type, auth, knowledge, tools, MCP, owners)",
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "in-grid"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"AgentsInfo\\r\\n| summarize arg_max(Timestamp, *) by AgentId\\r\\n| where CreatedDateTime > ago(7d)\\r\\n| project CreatedDateTime, Name, Platform, Model = tostring(Model), PublishedStatus, Owners = tostring(Owners)\\r\\n| order by CreatedDateTime desc\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 1,
              "title": "New agents (created in last 7 days)",
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-new"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"AgentsInfo\\r\\n| summarize arg_max(Timestamp, *) by AgentId\\r\\n| where isnotempty(CreatedDateTime)\\r\\n| summarize NewAgents = count() by Week = bin(todatetime(CreatedDateTime), 7d), Platform\\r\\n| order by Week asc\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 1,
              "visualization": "barchart",
              "title": "Agent growth (new agents / week)",
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "in-growth"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"AgentsInfo\\r\\n| summarize arg_max(Timestamp, *) by AgentId\\r\\n| where (isnotempty(tostring(McpServers)) and tostring(McpServers) !in ('', '[]')) or (isnotempty(tostring(ConnectedAgents)) and tostring(ConnectedAgents) !in ('', '[]'))\\r\\n| project Name, Platform, McpServers = tostring(McpServers), DeclaredTools = tostring(DeclaredTools), ConnectedAgents = tostring(ConnectedAgents), ToolsAuthType = tostring(ToolsAuthenticationType)\\r\\n| take 100\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 1,
              "title": "Agents exposing MCP servers / connected agents (supply-chain surface)",
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-mcp"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"AgentsInfo\\r\\n| summarize arg_max(Timestamp, *) by AgentId\\r\\n| mv-expand o = todynamic(Owners)\\r\\n| extend Owner = tostring(o)\\r\\n| where isnotempty(Owner)\\r\\n| summarize Agents = dcount(AgentId), AgentNames = make_set(Name, 10) by Owner\\r\\n| top 20 by Agents desc\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 1,
              "title": "Top agent owners",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Agents",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  }
                ]
              },
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "in-owners"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"AgentsInfo\\r\\n| summarize arg_max(Timestamp, *) by AgentId\\r\\n| where isempty(tostring(Owners)) or tostring(Owners) in ('', '[]')\\r\\n| project Name, Platform, Status = PublishedStatus, Model = tostring(Model), Created = CreatedDateTime, Modified = LastUpdatedDateTime\\r\\n| order by Modified desc\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 0,
              "title": "⚠️ Ownerless agents",
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "in-ownerless"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"AgentsInfo\\r\\n| summarize arg_max(Timestamp, *) by AgentId\\r\\n| where LastUpdatedDateTime < ago(30d)\\r\\n| project Name, Platform, Status = PublishedStatus, Owners = tostring(Owners), LastModified = LastUpdatedDateTime\\r\\n| order by LastModified asc\\r\\n| take 100\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 0,
              "title": "Inactive agents (>30 days)",
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "in-inactive"
          },
          {
            "type": 1,
            "content": {
              "json": "### Local AI agents on endpoints (Preview)\n\nMicrosoft Defender for Endpoint discovers supported local AI agents as a profile composed of **agent type + user + device**, including CLI agents, desktop applications, agentic IDEs, VS Code extensions, and Claw-based agents. This V2 section includes the original local-agent panels for deployment footprint, remote/local MCP servers, declared tools, auto-approval, host-process trust, critical-device exposure, user blast radius, and lifecycle changes. It also includes the nested **Visual Studio Code and coding-agent MCP discovery & runtime** subsection below for configured MCPs, account/device attribution, spawned MCP processes, governed tool calls, coverage health, and prioritized risk.\n\n`AgentsInfo` provides discovered configuration and posture. `ExposureGraphNodes/Edges` provides potential relationships and blast radius. `DeviceProcessEvents` provides endpoint process execution. `CloudAppEvents/ExecuteToolByGateway` provides governed runtime calls. These evidence types are complementary and should not be interpreted as equivalent proof of tool execution."
            },
            "name": "ah-local-h"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"AgentsInfo\\r\\n| where Platform == 'LocalAgents'\\r\\n| summarize arg_max(Timestamp, Name, Version, LifecycleStatus, RawAgentInfo) by AgentId\\r\\n| where LifecycleStatus !in~ ('Deleted', 'Uninstalled')\\r\\n| extend AgentMetadata = RawAgentInfo.localAgentMetadata\\r\\n| extend Vendor = tostring(AgentMetadata.vendor), Process = tostring(AgentMetadata.relatedProcess), Device = tostring(AgentMetadata.deviceName), Account = tostring(AgentMetadata.accountName)\\r\\n| where '{AgentSearch}' == '' or Name has '{AgentSearch}' or Vendor has '{AgentSearch}' or Device has '{AgentSearch}' or Account has '{AgentSearch}'\\r\\n| summarize Installations = count(), DeviceCount = dcount(Device), Devices = make_set(Device, 100), Versions = make_set(Version, 20), Accounts = make_set_if(Account, isnotempty(Account), 50) by Agent = Name, Vendor, Process\\r\\n| sort by DeviceCount desc, Installations desc\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 0,
              "title": "Local AI agent inventory and deployment footprint",
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-local-inventory"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"let localAgentProfiles = AgentsInfo | where Platform == 'LocalAgents' | extend AgentMetadata = RawAgentInfo.localAgentMetadata | project Timestamp, Agent = Name, Device = tostring(AgentMetadata.deviceName), Account = tostring(AgentMetadata.accountName), McpServers, DeclaredTools, LocalServers = AgentMetadata.localMcps;\\r\\nlet remoteMcpServers = localAgentProfiles | mv-expand Server = McpServers | project Timestamp, Agent, Device, Account, McpServer = tostring(Server.name), Origin = 'Remote MCP server', Transport = tostring(Server.type), Location = tostring(Server.endpoint);\\r\\nlet agentDeclaredTools = localAgentProfiles | mv-expand Tool = DeclaredTools | project Timestamp, Agent, Device, Account, McpServer = tostring(Tool.name), Origin = 'Declared tool', Transport = tostring(Tool.type), Location = tostring(Tool.endpoint);\\r\\nlet localMcpServers = localAgentProfiles | mv-expand Server = LocalServers | project Timestamp, Agent, Device, Account, McpServer = tostring(Server.name), Origin = 'Local MCP server', Transport = tostring(Server.transportType), Location = tostring(Server.commandName);\\r\\nremoteMcpServers\\r\\n| union agentDeclaredTools, localMcpServers\\r\\n| where isnotempty(McpServer)\\r\\n| where '{AgentSearch}' == '' or Agent has '{AgentSearch}' or Device has '{AgentSearch}' or Account has '{AgentSearch}' or McpServer has '{AgentSearch}'\\r\\n| summarize LastSeen = max(Timestamp), Agents = make_set(Agent, 20), Devices = make_set(Device, 20), Accounts = make_set_if(Account, isnotempty(Account), 20) by McpServer, Origin, Transport, Location\\r\\n| sort by McpServer asc, Origin asc\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 0,
              "title": "Local agents: remote MCP, local MCP, and declared tools",
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-local-mcp"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"AgentsInfo\\r\\n| where Platform == 'LocalAgents'\\r\\n| summarize arg_max(Timestamp, Name, Version, LifecycleStatus, RawAgentInfo) by AgentId\\r\\n| where LifecycleStatus !in~ ('Deleted', 'Uninstalled')\\r\\n| extend AgentMetadata = RawAgentInfo.localAgentMetadata\\r\\n| extend AutoApprove = tostring(AgentMetadata.autoApprove), TrustedProcess = tostring(AgentMetadata.trustedProcess), Vendor = tostring(AgentMetadata.vendor), Process = tostring(AgentMetadata.relatedProcess), Device = tostring(AgentMetadata.deviceName), Account = tostring(AgentMetadata.accountName)\\r\\n| where AutoApprove =~ 'true' or TrustedProcess =~ 'false'\\r\\n| where '{AgentSearch}' == '' or Name has '{AgentSearch}' or Device has '{AgentSearch}' or Account has '{AgentSearch}'\\r\\n| extend RiskReason = case(AutoApprove =~ 'true' and TrustedProcess =~ 'false', 'Acts without approval, and host process is not trusted', AutoApprove =~ 'true', 'Acts without approval', 'Host process is not trusted')\\r\\n| project Agent = Name, Vendor, Version, Process, Device, Account, AutoApprove, TrustedProcess, RiskReason, LastSeen = Timestamp\\r\\n| sort by Device asc, Agent asc\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 0,
              "title": "Risky local agents: auto-approval or untrusted host process",
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-local-risky-config"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"let deviceLabels = dynamic(['device', 'ec2.instance', 'microsoft.compute/virtualmachines']);\\r\\nlet riskyAgentProfiles = AgentsInfo | where Platform == 'LocalAgents' | summarize arg_max(Timestamp, Name, Version, LifecycleStatus, RawAgentInfo) by AgentId | where LifecycleStatus !in~ ('Deleted', 'Uninstalled') | extend AgentMetadata = RawAgentInfo.localAgentMetadata | extend AutoApprove = tostring(AgentMetadata.autoApprove), TrustedProcess = tostring(AgentMetadata.trustedProcess) | where AutoApprove =~ 'true' or TrustedProcess =~ 'false' | project AgentId = tostring(AgentId), Agent = Name, Version, Vendor = tostring(AgentMetadata.vendor), Account = tostring(AgentMetadata.accountName), AutoApprove, TrustedProcess;\\r\\nlet localAgentNodes = ExposureGraphNodes | where NodeLabel == 'ai-agent' | where tostring(NodeProperties.rawData.aiAgentMetadata.platform) == 'LocalAgents' | project AgentNodeId = NodeId, AgentId = tostring(NodeProperties.rawData.aiAgentMetadata.id);\\r\\nlet agentDeviceEdges = ExposureGraphEdges | where SourceNodeLabel == 'ai-agent' and EdgeLabel =~ 'runs on' and TargetNodeLabel in (deviceLabels) | project AgentNodeId = SourceNodeId, DeviceId = TargetNodeId, Device = TargetNodeName, DeviceType = TargetNodeLabel;\\r\\nlet criticalDevices = ExposureGraphNodes | where NodeLabel in (deviceLabels) and NodeProperties has 'criticalityLevel' | extend CriticalityLevel = toint(NodeProperties.rawData.criticalityLevel.criticalityLevel) | where CriticalityLevel between (0 .. 3) | extend Criticality = case(CriticalityLevel == 0, 'Very high', CriticalityLevel == 1, 'High', CriticalityLevel == 2, 'Medium', 'Low') | project DeviceId = NodeId, CriticalityLevel, Criticality, CriticalityReason = tostring(NodeProperties.rawData.criticalityLevel.ruleNames);\\r\\nriskyAgentProfiles\\r\\n| join kind=inner localAgentNodes on AgentId\\r\\n| join kind=inner agentDeviceEdges on AgentNodeId\\r\\n| join kind=inner criticalDevices on DeviceId\\r\\n| where '{AgentSearch}' == '' or Agent has '{AgentSearch}' or Device has '{AgentSearch}' or Account has '{AgentSearch}'\\r\\n| project Device, DeviceType, Criticality, CriticalityReason, Agent, Vendor, Version, Account, AutoApprove, TrustedProcess, CriticalityLevel\\r\\n| sort by CriticalityLevel asc, Device asc, Agent asc\\r\\n| project-away CriticalityLevel\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 0,
              "title": "Risky local agents running on critical devices",
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-local-critical-devices"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"let deviceLabels = dynamic(['device', 'ec2.instance', 'microsoft.compute/virtualmachines']);\\r\\nlet localAgents = ExposureGraphNodes | where NodeLabel == 'ai-agent' | where tostring(NodeProperties.rawData.aiAgentMetadata.platform) == 'LocalAgents' | project AgentNodeId = NodeId, AIAgent = NodeName;\\r\\nlet agentDeviceEdges = ExposureGraphEdges | where SourceNodeLabel == 'ai-agent' and EdgeLabel =~ 'runs on' and TargetNodeLabel in (deviceLabels) | project AgentNodeId = SourceNodeId, Device = TargetNodeName;\\r\\nlet agentUserEdges = ExposureGraphEdges | where SourceNodeLabel == 'ai-agent' and EdgeLabel =~ 'used by' | project AgentNodeId = SourceNodeId, UserId = TargetNodeId, User = TargetNodeName;\\r\\nlet userReach = ExposureGraphEdges | where EdgeLabel in~ ('has permissions to', 'has role on') | project UserId = SourceNodeId, AssetId = TargetNodeId | union (ExposureGraphNodes | where NodeLabel == 'user' | project UserId = NodeId, AssetId = NodeId);\\r\\nlet sensitiveAssets = ExposureGraphNodes | where NodeProperties has 'criticalityLevel' or NodeProperties has 'containsSensitiveData' | extend CriticalityLevel = toint(NodeProperties.rawData.criticalityLevel.criticalityLevel), SensitiveDataRaw = tostring(NodeProperties.rawData.containsSensitiveData) | extend HasSensitiveData = iff(isnotempty(SensitiveDataRaw) and SensitiveDataRaw !~ 'false', 'Yes', 'No') | where CriticalityLevel between (0 .. 3) or HasSensitiveData == 'Yes' | extend CriticalityRank = iff(CriticalityLevel between (0 .. 3), CriticalityLevel, 4) | project AssetId = NodeId, AssetName = NodeName, CriticalityRank, HasSensitiveData;\\r\\nlet agentUsers = localAgents | join kind=inner agentDeviceEdges on AgentNodeId | join kind=inner agentUserEdges on AgentNodeId | project AIAgent, Device, UserId, User;\\r\\nagentUsers\\r\\n| join kind=inner userReach on UserId\\r\\n| join kind=inner sensitiveAssets on AssetId\\r\\n| summarize AIAgents = make_set(AIAgent, 20), Devices = make_set(Device, 20), ReachableAssets = dcountif(AssetId, AssetId != UserId), SensitiveAssets = dcountif(AssetId, AssetId != UserId and HasSensitiveData == 'Yes'), Assets = make_set_if(AssetName, AssetId != UserId, 50), UserRank = minif(CriticalityRank, AssetId == UserId), AssetRank = minif(CriticalityRank, AssetId != UserId) by User\\r\\n| extend UserCriticality = case(UserRank == 0, 'Very high', UserRank == 1, 'High', UserRank == 2, 'Medium', UserRank == 3, 'Low', 'Not classified'), HighestAssetCriticality = case(AssetRank == 0, 'Very high', AssetRank == 1, 'High', AssetRank == 2, 'Medium', AssetRank == 3, 'Low', AssetRank == 4, 'Sensitive data', 'None')\\r\\n| where '{AgentSearch}' == '' or User has '{AgentSearch}' or tostring(AIAgents) has '{AgentSearch}' or tostring(Devices) has '{AgentSearch}'\\r\\n| extend SortRank = coalesce(AssetRank, 99)\\r\\n| project User, UserCriticality, ReachableAssets, SensitiveAssets, HighestAssetCriticality, AIAgents, Devices, Assets, SortRank\\r\\n| sort by SortRank asc, ReachableAssets desc\\r\\n| project-away SortRank\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 0,
              "title": "Users whose local agents can reach critical or sensitive assets",
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-local-user-blast-radius"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"AgentsInfo\\r\\n| where Platform == 'LocalAgents'\\r\\n| summarize FirstSeen = min(Timestamp), LastSeen = max(Timestamp), arg_max(Timestamp, Name, Version, LifecycleStatus, RawAgentInfo) by AgentId\\r\\n| extend Metadata = RawAgentInfo.localAgentMetadata, Device = tostring(RawAgentInfo.localAgentMetadata.deviceName), Account = tostring(RawAgentInfo.localAgentMetadata.accountName)\\r\\n| where FirstSeen > ago(7d) or LifecycleStatus in~ ('Deleted', 'Uninstalled')\\r\\n| extend Change = case(LifecycleStatus in~ ('Deleted', 'Uninstalled'), strcat('Removed: ', LifecycleStatus), 'New profile')\\r\\n| where '{AgentSearch}' == '' or Name has '{AgentSearch}' or Device has '{AgentSearch}' or Account has '{AgentSearch}'\\r\\n| project Change, FirstSeen, LastSeen, Agent = Name, Version, LifecycleStatus, Vendor = tostring(Metadata.vendor), Process = tostring(Metadata.relatedProcess), Device, Account, AgentId\\r\\n| sort by LastSeen desc\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 0,
              "title": "Local agent profile changes: new and removed in 7 days",
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-local-lifecycle"
          },
          {
            "type": 1,
            "content": {
              "json": "#### Visual Studio Code and coding-agent MCP discovery & runtime (Preview)\n\nThis subsection extends local-agent discovery for supported VS Code extensions such as GitHub Copilot, Claude Code, Cline, Codex, Gemini Code Assist, and Roo Code. It answers three different questions from three evidence planes: **configured MCPs** from `AgentsInfo.RawAgentInfo.localAgentMetadata.localMcps` and `McpServers`; **MCP server processes launched by VS Code** from `DeviceProcessEvents`; and **governed MCP tool calls** from `CloudAppEvents/ExecuteToolByGateway`. Configuration is not execution, a spawned process is not a tool invocation, and gateway telemetry covers only governed calls. Empty panels mean the required Defender capability or event is absent in the selected period, not proof that no MCP is used.",
              "style": "warning"
            },
            "name": "ah-vscode-mcp-h"
          },
          {
            "type": 1,
            "content": {
              "json": "#### Coverage health\n\nThese tiles show whether each evidence plane is producing data. Use the result to distinguish an empty inventory from a clean security state. Local profile discovery requires supported Windows or macOS endpoints and Defender for Endpoint; process evidence requires `DeviceProcessEvents`; governed invocation evidence requires Agent 365 MCP gateway events."
            },
            "name": "ah-vscode-mcp-coverage-desc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"let VsCodeProfiles = AgentsInfo\\n| where Platform == 'LocalAgents'\\n| summarize arg_max(Timestamp, *) by AgentId\\n| where LifecycleStatus !in~ ('Deleted', 'Uninstalled')\\n| extend Metadata = RawAgentInfo.localAgentMetadata,\\n    Process = tolower(tostring(RawAgentInfo.localAgentMetadata.relatedProcess)),\\n    RawText = tolower(tostring(RawAgentInfo))\\n| where Process has_any ('code.exe', 'code-insiders.exe', 'codium.exe', 'visual studio code')\\n    or RawText has_any ('vscode', 'visual studio code', 'code.exe', 'code-insiders.exe', 'codium.exe')\\n| extend Vendor = tostring(Metadata.vendor), Device = tostring(Metadata.deviceName),\\n    Account = tostring(Metadata.accountName), TrustedProcess = tostring(Metadata.trustedProcess),\\n    AutoApprove = tostring(Metadata.autoApprove), LocalMcps = Metadata.localMcps;\\n  let McpConfigs = union\\n(VsCodeProfiles\\n| mv-expand Server = LocalMcps\\n| extend McpServer = coalesce(tostring(Server.name), tostring(Server.label), tostring(Server.serverLabel), tostring(Server.commandName)),\\n    Transport = coalesce(tostring(Server.transportType), tostring(Server.type)),\\n    Location = coalesce(tostring(Server.url), tostring(Server.endpoint), tostring(Server.serverUrl), tostring(Server.commandName)),\\n    Origin = 'Local MCP configuration'\\n| project Timestamp, AgentId, Agent = Name, Vendor, Version, Device, Account,\\n    Process, TrustedProcess, AutoApprove, McpServer, Transport, Location, Origin,\\n    DeclaredTools = tostring(DeclaredTools)),\\n  (VsCodeProfiles\\n| mv-expand Server = McpServers\\n| extend McpServer = coalesce(tostring(Server.name), tostring(Server.label), tostring(Server.serverLabel), tostring(Server.url), tostring(Server.endpoint)),\\n    Transport = coalesce(tostring(Server.transportType), tostring(Server.type)),\\n    Location = coalesce(tostring(Server.url), tostring(Server.endpoint), tostring(Server.serverUrl)),\\n    Origin = 'Remote MCP configuration'\\n| project Timestamp, AgentId, Agent = Name, Vendor, Version, Device, Account,\\n    Process, TrustedProcess, AutoApprove, McpServer, Transport, Location, Origin,\\n    DeclaredTools = tostring(DeclaredTools))\\n| where isnotempty(McpServer) or isnotempty(Location);\\n  let McpConfigCount = McpConfigs | summarize Value = count();\\nlet McpProcesses = DeviceProcessEvents\\n| where Timestamp > ago(30d)\\n| where InitiatingProcessFileName in~ ('code.exe', 'code-insiders.exe', 'codium.exe') or InitiatingProcessParentFileName in~ ('code.exe', 'code-insiders.exe', 'codium.exe')\\n| where ProcessCommandLine has_any ('mcp', 'modelcontextprotocol', '@modelcontextprotocol', 'mcp-server', '--mcp') or FileName has_any ('mcp-server', 'mcp_server')\\n| summarize Value = count();\\nlet GatewayCalls = CloudAppEvents\\n| where Timestamp > ago(30d) and ActionType == 'ExecuteToolByGateway'\\n| extend Evidence = tolower(strcat(UserAgent, ' ', tostring(RawEventData), ' ', tostring(AdditionalFields)))\\n| where Evidence has_any ('visual studio code', 'vscode', 'github copilot')\\n| summarize Value = count();\\nunion\\n(VsCodeProfiles | summarize Value = count() | extend Metric = 'VS Code agent profiles', Order = 1),\\n(VsCodeProfiles | summarize Value = dcount(Device) | extend Metric = 'Devices', Order = 2),\\n(VsCodeProfiles | summarize Value = dcountif(Account, isnotempty(Account)) | extend Metric = 'Known accounts', Order = 3),\\n(McpConfigCount | extend Metric = 'Configured MCP entries', Order = 4),\\n(McpProcesses | extend Metric = 'MCP-like child processes', Order = 5),\\n(GatewayCalls | extend Metric = 'Governed VS Code tool calls', Order = 6)\\n| project Order, Metric, Value\\n| sort by Order asc\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 3,
              "visualization": "tiles",
              "title": "VS Code MCP coverage health (30 days)",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                }
              },
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-vscode-mcp-coverage"
          },
          {
            "type": 1,
            "content": {
              "json": "#### Which MCP servers and tools are configured?\n\nThis expands local and remote MCP configuration attached to VS Code local-agent profiles. `Location` can be a URL, endpoint, or local command; `DeclaredTools` is the capability inventory exposed by discovery. Review unexpected servers, workspace-specific commands, broad toolsets, missing ownership, and profiles whose host process is untrusted or auto-approves actions."
            },
            "name": "ah-vscode-mcp-inventory-desc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"let VsCodeProfiles = AgentsInfo\\n| where Platform == 'LocalAgents'\\n| summarize arg_max(Timestamp, *) by AgentId\\n| where LifecycleStatus !in~ ('Deleted', 'Uninstalled')\\n| extend Metadata = RawAgentInfo.localAgentMetadata,\\n    Process = tolower(tostring(RawAgentInfo.localAgentMetadata.relatedProcess)),\\n    RawText = tolower(tostring(RawAgentInfo))\\n| where Process has_any ('code.exe', 'code-insiders.exe', 'codium.exe', 'visual studio code')\\n    or RawText has_any ('vscode', 'visual studio code', 'code.exe', 'code-insiders.exe', 'codium.exe')\\n| extend Vendor = tostring(Metadata.vendor), Device = tostring(Metadata.deviceName),\\n    Account = tostring(Metadata.accountName), TrustedProcess = tostring(Metadata.trustedProcess),\\n    AutoApprove = tostring(Metadata.autoApprove), LocalMcps = Metadata.localMcps;\\n  union\\n(VsCodeProfiles\\n| mv-expand Server = LocalMcps\\n| extend McpServer = coalesce(tostring(Server.name), tostring(Server.label), tostring(Server.serverLabel), tostring(Server.commandName)),\\n    Transport = coalesce(tostring(Server.transportType), tostring(Server.type)),\\n    Location = coalesce(tostring(Server.url), tostring(Server.endpoint), tostring(Server.serverUrl), tostring(Server.commandName)),\\n    Origin = 'Local MCP configuration'\\n| project Timestamp, AgentId, Agent = Name, Vendor, Version, Device, Account,\\n    Process, TrustedProcess, AutoApprove, McpServer, Transport, Location, Origin,\\n    DeclaredTools = tostring(DeclaredTools)),\\n  (VsCodeProfiles\\n| mv-expand Server = McpServers\\n| extend McpServer = coalesce(tostring(Server.name), tostring(Server.label), tostring(Server.serverLabel), tostring(Server.url), tostring(Server.endpoint)),\\n    Transport = coalesce(tostring(Server.transportType), tostring(Server.type)),\\n    Location = coalesce(tostring(Server.url), tostring(Server.endpoint), tostring(Server.serverUrl)),\\n    Origin = 'Remote MCP configuration'\\n| project Timestamp, AgentId, Agent = Name, Vendor, Version, Device, Account,\\n    Process, TrustedProcess, AutoApprove, McpServer, Transport, Location, Origin,\\n    DeclaredTools = tostring(DeclaredTools))\\n| where isnotempty(McpServer) or isnotempty(Location)\\n| where '{AgentSearch}' == '' or Agent has '{AgentSearch}' or Device has '{AgentSearch}' or Account has '{AgentSearch}' or McpServer has '{AgentSearch}' or Location has '{AgentSearch}'\\n| summarize LastSeen = max(Timestamp), Agents = make_set(Agent, 20), Devices = make_set(Device, 30), Accounts = make_set_if(Account, isnotempty(Account), 30),\\n    Processes = make_set(Process, 10), Tools = make_set(DeclaredTools, 20), AutoApprove = make_set(AutoApprove, 5), TrustedProcess = make_set(TrustedProcess, 5)\\n    by McpServer, Origin, Transport, Location\\n| order by LastSeen desc\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 0,
              "title": "VS Code MCP configuration inventory",
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-vscode-mcp-inventory"
          },
          {
            "type": 1,
            "content": {
              "json": "#### Who has VS Code agents with MCP access, and where?\n\nThis profile-level view maps discovered agent extensions and MCP configuration counts to local account and device context. The account comes from endpoint discovery and may be a local name rather than a UPN; confirm identity before response. A profile is one agent type plus user plus device, not one project folder or one invocation."
            },
            "name": "ah-vscode-mcp-users-desc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"let VsCodeProfiles = AgentsInfo\\n| where Platform == 'LocalAgents'\\n| summarize arg_max(Timestamp, *) by AgentId\\n| where LifecycleStatus !in~ ('Deleted', 'Uninstalled')\\n| extend Metadata = RawAgentInfo.localAgentMetadata,\\n    Process = tolower(tostring(RawAgentInfo.localAgentMetadata.relatedProcess)),\\n    RawText = tolower(tostring(RawAgentInfo))\\n| where Process has_any ('code.exe', 'code-insiders.exe', 'codium.exe', 'visual studio code')\\n    or RawText has_any ('vscode', 'visual studio code', 'code.exe', 'code-insiders.exe', 'codium.exe')\\n| extend Vendor = tostring(Metadata.vendor), Device = tostring(Metadata.deviceName),\\n    Account = tostring(Metadata.accountName), TrustedProcess = tostring(Metadata.trustedProcess),\\n    AutoApprove = tostring(Metadata.autoApprove), LocalMcps = Metadata.localMcps;\\n  let McpConfigs = union\\n(VsCodeProfiles\\n| mv-expand Server = LocalMcps\\n| extend McpServer = coalesce(tostring(Server.name), tostring(Server.label), tostring(Server.serverLabel), tostring(Server.commandName)),\\n    Transport = coalesce(tostring(Server.transportType), tostring(Server.type)),\\n    Location = coalesce(tostring(Server.url), tostring(Server.endpoint), tostring(Server.serverUrl), tostring(Server.commandName)),\\n    Origin = 'Local MCP configuration'\\n| project Timestamp, AgentId, Agent = Name, Vendor, Version, Device, Account,\\n    Process, TrustedProcess, AutoApprove, McpServer, Transport, Location, Origin,\\n    DeclaredTools = tostring(DeclaredTools)),\\n  (VsCodeProfiles\\n| mv-expand Server = McpServers\\n| extend McpServer = coalesce(tostring(Server.name), tostring(Server.label), tostring(Server.serverLabel), tostring(Server.url), tostring(Server.endpoint)),\\n    Transport = coalesce(tostring(Server.transportType), tostring(Server.type)),\\n    Location = coalesce(tostring(Server.url), tostring(Server.endpoint), tostring(Server.serverUrl)),\\n    Origin = 'Remote MCP configuration'\\n| project Timestamp, AgentId, Agent = Name, Vendor, Version, Device, Account,\\n    Process, TrustedProcess, AutoApprove, McpServer, Transport, Location, Origin,\\n    DeclaredTools = tostring(DeclaredTools))\\n| where isnotempty(McpServer) or isnotempty(Location);\\n  let ConfigCounts = McpConfigs\\n  | summarize McpEntries = dcount(strcat(McpServer, '|', Location)), McpServers = make_set(McpServer, 20) by AgentId;\\nVsCodeProfiles\\n| join kind=leftouter ConfigCounts on AgentId\\n| where '{AgentSearch}' == '' or Name has '{AgentSearch}' or Device has '{AgentSearch}' or Account has '{AgentSearch}' or tostring(McpServers) has '{AgentSearch}'\\n| project LastSeen = Timestamp, Account, Device, Agent = Name, Vendor, Version, Process,\\n    McpEntries = coalesce(McpEntries, 0), McpServers, AutoApprove, TrustedProcess, AgentId\\n| order by McpEntries desc, LastSeen desc\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 0,
              "title": "VS Code MCP exposure by account and device",
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-vscode-mcp-users"
          },
          {
            "type": 1,
            "content": {
              "json": "#### What MCP server processes did VS Code start?\n\nThis process evidence finds MCP-like command lines or executable names launched directly or indirectly by VS Code. It shows user, device, binary path/hash, command line, integrity/elevation, and remote-session context. Command-line matching can include setup or diagnostic commands and can miss servers whose command contains no MCP marker; validate the process tree and signature before containment."
            },
            "name": "ah-vscode-mcp-process-desc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"DeviceProcessEvents\\n| where Timestamp > ago(30d)\\n| where InitiatingProcessFileName in~ ('code.exe', 'code-insiders.exe', 'codium.exe') or InitiatingProcessParentFileName in~ ('code.exe', 'code-insiders.exe', 'codium.exe')\\n| where ProcessCommandLine has_any ('mcp', 'modelcontextprotocol', '@modelcontextprotocol', 'mcp-server', '--mcp') or FileName has_any ('mcp-server', 'mcp_server')\\n| extend Account = coalesce(AccountUpn, AccountName, InitiatingProcessAccountUpn, InitiatingProcessAccountName),\\n    VSCodeProcess = iff(InitiatingProcessFileName in~ ('code.exe', 'code-insiders.exe', 'codium.exe'), InitiatingProcessFileName, InitiatingProcessParentFileName)\\n| where '{AgentSearch}' == '' or DeviceName has '{AgentSearch}' or Account has '{AgentSearch}' or FileName has '{AgentSearch}' or ProcessCommandLine has '{AgentSearch}'\\n| project Timestamp, DeviceName, Account, VSCodeProcess, FileName, FolderPath,\\n    ProcessCommandLine, SHA1, ProcessTokenElevation, ProcessIntegrityLevel,\\n    InitiatingProcessFileName, InitiatingProcessCommandLine,\\n    IsProcessRemoteSession, ProcessRemoteSessionDeviceName, ProcessRemoteSessionIP,\\n    DeviceId, ReportId\\n| order by Timestamp desc\\n| take 300\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 0,
              "title": "MCP-like processes launched by VS Code (30 days)",
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-vscode-mcp-processes"
          },
          {
            "type": 1,
            "content": {
              "json": "#### What governed MCP tools did VS Code invoke?\n\n`ExecuteToolByGateway` is runtime evidence for MCP calls routed through the Agent 365 gateway. Because preview event property names can vary, the panel retains `RawEventData` for analyst expansion and derives best-effort client, agent, server, and tool fields. It filters for VS Code or GitHub Copilot client markers; direct local and unmanaged MCP calls do not appear here."
            },
            "name": "ah-vscode-mcp-calls-desc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"CloudAppEvents\\n| where Timestamp > ago(30d) and ActionType == 'ExecuteToolByGateway'\\n| extend Raw = todynamic(RawEventData), Extra = todynamic(AdditionalFields)\\n| extend Client = coalesce(UserAgent, tostring(Raw.clientName), tostring(Raw.client.name), tostring(Extra.clientName)),\\n    Agent = coalesce(tostring(Raw.agentName), tostring(Raw.agent.name), tostring(Extra.agentName)),\\n    McpServer = coalesce(tostring(Raw.mcpServerName), tostring(Raw.serverName), tostring(Raw.server.name), tostring(Extra.mcpServerName), ObjectName),\\n    Tool = coalesce(tostring(Raw.toolName), tostring(Raw.tool.name), tostring(Extra.toolName), ActivityType),\\n    Evidence = tolower(strcat(UserAgent, ' ', tostring(RawEventData), ' ', tostring(AdditionalFields)))\\n| where Evidence has_any ('visual studio code', 'vscode', 'github copilot')\\n| where '{AgentSearch}' == '' or Agent has '{AgentSearch}' or AccountDisplayName has '{AgentSearch}' or AccountId has '{AgentSearch}' or McpServer has '{AgentSearch}' or Tool has '{AgentSearch}'\\n| project Timestamp, AccountDisplayName, AccountId, AccountObjectId, Client,\\n    Agent, McpServer, Tool, Application, IPAddress, CountryCode, OSPlatform,\\n    DeviceType, ReportId, RawEventData, AdditionalFields\\n| order by Timestamp desc\\n| take 300\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 0,
              "title": "Governed MCP tool calls from VS Code (30 days)",
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-vscode-mcp-calls"
          },
          {
            "type": 1,
            "content": {
              "json": "#### Prioritized VS Code MCP risk\n\nThis combines risky discovered configuration with suspicious VS Code-spawned processes. High-risk configuration includes auto-approval, an untrusted host process, external URLs, or command-capable server/tool metadata. Process findings include elevated MCP-like children and shell, command, SSH, or offensive-tool markers. These are prioritization signals, not confirmation that a tool action succeeded."
            },
            "name": "ah-vscode-mcp-risk-desc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"let VsCodeProfiles = AgentsInfo\\n| where Platform == 'LocalAgents'\\n| summarize arg_max(Timestamp, *) by AgentId\\n| where LifecycleStatus !in~ ('Deleted', 'Uninstalled')\\n| extend Metadata = RawAgentInfo.localAgentMetadata,\\n    Process = tolower(tostring(RawAgentInfo.localAgentMetadata.relatedProcess)),\\n    RawText = tolower(tostring(RawAgentInfo))\\n| where Process has_any ('code.exe', 'code-insiders.exe', 'codium.exe', 'visual studio code')\\n    or RawText has_any ('vscode', 'visual studio code', 'code.exe', 'code-insiders.exe', 'codium.exe')\\n| extend Vendor = tostring(Metadata.vendor), Device = tostring(Metadata.deviceName),\\n    Account = tostring(Metadata.accountName), TrustedProcess = tostring(Metadata.trustedProcess),\\n    AutoApprove = tostring(Metadata.autoApprove), LocalMcps = Metadata.localMcps;\\n  let McpConfigs = union\\n(VsCodeProfiles\\n| mv-expand Server = LocalMcps\\n| extend McpServer = coalesce(tostring(Server.name), tostring(Server.label), tostring(Server.serverLabel), tostring(Server.commandName)),\\n    Transport = coalesce(tostring(Server.transportType), tostring(Server.type)),\\n    Location = coalesce(tostring(Server.url), tostring(Server.endpoint), tostring(Server.serverUrl), tostring(Server.commandName)),\\n    Origin = 'Local MCP configuration'\\n| project Timestamp, AgentId, Agent = Name, Vendor, Version, Device, Account,\\n    Process, TrustedProcess, AutoApprove, McpServer, Transport, Location, Origin,\\n    DeclaredTools = tostring(DeclaredTools)),\\n  (VsCodeProfiles\\n| mv-expand Server = McpServers\\n| extend McpServer = coalesce(tostring(Server.name), tostring(Server.label), tostring(Server.serverLabel), tostring(Server.url), tostring(Server.endpoint)),\\n    Transport = coalesce(tostring(Server.transportType), tostring(Server.type)),\\n    Location = coalesce(tostring(Server.url), tostring(Server.endpoint), tostring(Server.serverUrl)),\\n    Origin = 'Remote MCP configuration'\\n| project Timestamp, AgentId, Agent = Name, Vendor, Version, Device, Account,\\n    Process, TrustedProcess, AutoApprove, McpServer, Transport, Location, Origin,\\n    DeclaredTools = tostring(DeclaredTools))\\n| where isnotempty(McpServer) or isnotempty(Location);\\n  let ConfigRisk = McpConfigs\\n  | extend Search = tolower(strcat(McpServer, ' ', Location, ' ', DeclaredTools)),\\n    IsExternal = Location startswith 'http://' or Location startswith 'https://'\\n| where AutoApprove =~ 'true' or TrustedProcess =~ 'false' or IsExternal\\n    or Search matches regex @'(run[_ -]?(shell|command|code)|execute[_ -]?(shell|command|code)|powershell|cmd.exe|terminal|reverse[_ -]?shell|metasploit|kali|ssh[_ -]?exec)'\\n| extend Risk = case(AutoApprove =~ 'true' and TrustedProcess =~ 'false', 'CRITICAL', Search has_any ('reverse shell', 'metasploit', 'kali'), 'CRITICAL', AutoApprove =~ 'true' or TrustedProcess =~ 'false', 'HIGH', IsExternal, 'MEDIUM', 'HIGH'),\\n    EvidenceType = 'Discovered configuration', Detail = strcat(McpServer, ' | ', Location), FileHash = '', Elevated = ''\\n| project Timestamp, Risk, EvidenceType, Agent, Device, Account, Detail, FileHash, Elevated, AutoApprove, TrustedProcess;\\nlet ProcessRisk = DeviceProcessEvents\\n| where Timestamp > ago(30d)\\n| where InitiatingProcessFileName in~ ('code.exe', 'code-insiders.exe', 'codium.exe') or InitiatingProcessParentFileName in~ ('code.exe', 'code-insiders.exe', 'codium.exe')\\n| where ProcessCommandLine has_any ('mcp', 'modelcontextprotocol', '@modelcontextprotocol', 'mcp-server', '--mcp')\\n| extend Search = tolower(strcat(FileName, ' ', ProcessCommandLine)),\\n    Elevated = tostring(ProcessTokenElevation),\\n    Account = coalesce(AccountUpn, AccountName, InitiatingProcessAccountUpn, InitiatingProcessAccountName)\\n| where ProcessTokenElevation =~ 'TokenElevationTypeFull' or Search matches regex @'(powershell|cmd.exe|bash|sh |terminal|reverse[_ -]?shell|metasploit|kali|ssh)'\\n| extend Risk = iff(ProcessTokenElevation =~ 'TokenElevationTypeFull' or Search has_any ('reverse shell', 'metasploit', 'kali'), 'CRITICAL', 'HIGH'),\\n    EvidenceType = 'VS Code child process', Agent = 'Visual Studio Code', Device = DeviceName,\\n    Detail = ProcessCommandLine, FileHash = SHA1, AutoApprove = '', TrustedProcess = ''\\n| project Timestamp, Risk, EvidenceType, Agent, Device, Account, Detail, FileHash, Elevated, AutoApprove, TrustedProcess;\\nunion ConfigRisk, ProcessRisk\\n| where '{AgentSearch}' == '' or Agent has '{AgentSearch}' or Device has '{AgentSearch}' or Account has '{AgentSearch}' or Detail has '{AgentSearch}'\\n| order by Timestamp desc\\n| take 300\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 0,
              "title": "Risky VS Code MCP configuration and processes",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Risk",
                    "formatter": 0
                  }
                ]
              },
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-vscode-mcp-risk"
          },
          {
            "type": 1,
            "content": {
              "json": "### 🛑 Entra Agent ID risk (AADAgentRiskEvents)\n\n`AADAgentRiskEvents` reports Microsoft Entra Agent ID risk with level, state, type, detail, and evidence. Prioritize `atRisk` or `confirmedCompromised` events, inspect the latest state per event ID, and correlate the agent identity with sign-ins, owners, tools, and affected resources. Dismissed, remediated, or confirmed-safe states are lifecycle outcomes, not new detections."
            },
            "name": "ah-h3"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"AADAgentRiskEvents\\r\\n| where '{AgentSearch}' == '' or AgentDisplayName has '{AgentSearch}' or AgentId has '{AgentSearch}'\\r\\n| summarize arg_max(TimeGenerated, *) by Id\\r\\n| extend RiskLevel = case(RiskLevel =~ 'high', strcat('🔴 ', RiskLevel), RiskLevel =~ 'medium', strcat('🟠 ', RiskLevel), RiskLevel =~ 'low', strcat('🟡 ', RiskLevel), RiskLevel)\\r\\n| project DetectedDateTime, AgentDisplayName, AgentId, RiskLevel, RiskState, RiskEventType, RiskDetail, RiskEvidence, DetectionTimingType, IdentityType, LastModifiedDateTime\\r\\n| order by DetectedDateTime desc\\r\\n| take 100\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 0,
              "title": "Agent risk events (latest state per event)",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "RiskLevel",
                    "formatter": 0
                  }
                ]
              },
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-risk"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"AADAgentRiskEvents\\r\\n| summarize arg_max(TimeGenerated, *) by Id\\r\\n| summarize Events = count() by RiskState, RiskLevel\\r\\n| order by Events desc\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 1,
              "visualization": "barchart",
              "title": "Agent risk by state / level",
              "queryType": "advancedHunting",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ah-riskstate"
          }
        ]
      },
      "name": "group-advhunt"
    },
    {
      "type": 12,
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "datalake"
      },
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## 🗄️ Data Lake — Agent Observability (usage-based billing)\r\n\r\n> ⚠️ **Lake tier.** These tiles query **data-lake** tables — *querying the lake (or copying to the Analytics tier) incurs usage-based charges*. Widen the time range carefully.\r\n\r\nReads **UnifiedAgentObservability** (agent **AISpanOutput** spans: `SrcAgentName`, `TargetAgent*`, `EventOriginalResultDetails`, `AdditionalFields.ConversationId` / `ChannelName`) plus the **Entra Agent Identity** governance tables (`EntraAgentIdentities`, `EntraAgentIdentityBlueprints`, `EntraAgentIdentityBlueprintPrincipals`, `EntraAgentUsers`). The same queries run in the **Sentinel data lake** KQL editor or **Defender Advanced hunting**.\n\n**How to read this tab:** begin with source and agent volume, then review guardrail decisions, agent-to-agent paths, tool drift, unattended activity, and Entra agent identity inventory. Lake queries are billed when scanned, so keep the time range narrow and promote recurring detections to the appropriate analytics or hunting surface. Text and regex panels are hypotheses over recorded content, can produce false positives, and should not display secrets beyond the minimum needed for investigation.",
              "style": "warning"
            },
            "name": "dl-note"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"workspaces\":[],\"query\":\"union isfuzzy=true\\r\\n(UnifiedAgentObservability | summarize Value = sum(EventCount) | extend Metric = 'Agent spans', Order = 1),\\r\\n(UnifiedAgentObservability | summarize Value = dcount(SrcAgentName) | extend Metric = 'Distinct agents', Order = 2),\\r\\n(UnifiedAgentObservability | summarize Value = dcount(tostring(todynamic(AdditionalFields).ConversationId)) | extend Metric = 'Conversations', Order = 3),\\r\\n(UnifiedAgentObservability | where EventOriginalType == 'AISpanOutput' | summarize Value = count() | extend Metric = 'Output spans', Order = 4),\\r\\n(UnifiedAgentObservability | extend Reply = tostring(parse_json(EventOriginalResultDetails)[0].parts[0].content) | where Reply has_any ('Declined', 'Blocked') or Reply contains 'unable to' | summarize Value = count() | extend Metric = 'Guardrail blocks', Order = 5),\\r\\n(EntraAgentIdentities | summarize Value = count() | extend Metric = 'Entra agent identities', Order = 6)\\r\\n| project Order, Metric, Value\\r\\n| sort by Order asc\"}",
              "size": 3,
              "visualization": "tiles",
              "title": "Agent Observability metrics (lake)",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                }
              },
              "queryType": "sentinelDataLake",
              "crossComponentResources": [],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "dl-kpi"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"workspaces\":[],\"query\":\"UnifiedAgentObservability\\r\\n| summarize Spans = sum(EventCount) by bin(TimeGenerated, 1h), EventProduct\"}",
              "size": 0,
              "visualization": "timechart",
              "title": "Agent spans over time (by product)",
              "queryType": "sentinelDataLake",
              "crossComponentResources": [],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "dl-time"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"workspaces\":[],\"query\":\"UnifiedAgentObservability\\r\\n| where '{AgentSearch}' == '' or SrcAgentName has '{AgentSearch}'\\r\\n| summarize Spans = sum(EventCount), Conversations = dcount(tostring(todynamic(AdditionalFields).ConversationId)), LastSeen = max(TimeGenerated) by SrcAgentName, SrcAgentId\\r\\n| top 25 by Spans desc\"}",
              "size": 0,
              "title": "Top agents by spans",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Spans",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  }
                ]
              },
              "queryType": "sentinelDataLake",
              "crossComponentResources": [],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "dl-agents"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"workspaces\":[],\"query\":\"UnifiedAgentObservability\\r\\n| where '{AgentSearch}' == '' or SrcAgentName has '{AgentSearch}'\\r\\n| extend Reply = tostring(parse_json(EventOriginalResultDetails)[0].parts[0].content)\\r\\n| where Reply has_any ('Declined', 'Blocked') or Reply contains 'unable to'\\r\\n| extend Verdict = extract(@'\\\\*\\\\*([^*]*(?:Declined|Blocked|Detected)[^*]*)\\\\*\\\\*', 1, Reply)\\r\\n| extend Technique = extract(@'(?i)\\\\*\\\\*([^*]*(?:injection|jailbreak|exfiltration|homoglyph|leetspeak|base64|obfuscat|phishing|credential)[^*]*)\\\\*\\\\*', 1, Reply)\\r\\n| project TimeGenerated, SrcAgentName, EventProduct,\\r\\n          Verdict = iff(isempty(Verdict), 'Refused (polite)', Verdict), Technique,\\r\\n          Reply = substring(Reply, 0, 400)\\r\\n| sort by TimeGenerated desc\\r\\n| take 200\"}",
              "size": 0,
              "title": "🛡️ Blocked / refused content (agent guardrail decisions)",
              "queryType": "sentinelDataLake",
              "crossComponentResources": [],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "dl-blocks"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"workspaces\":[],\"query\":\"UnifiedAgentObservability\\r\\n| where '{AgentSearch}' == '' or SrcAgentName has '{AgentSearch}'\\r\\n| extend Reply = tostring(parse_json(EventOriginalResultDetails)[0].parts[0].content)\\r\\n| where Reply has_any ('Declined', 'Blocked') or Reply contains 'unable to'\\r\\n| extend Verdict = case(\\r\\n    Reply contains 'Detected and Blocked', 'Detected & Blocked',\\r\\n    Reply contains 'Declined', 'Declined',\\r\\n    Reply contains 'Blocked', 'Blocked',\\r\\n    'Refused (polite)')\\r\\n| summarize Blocks = count() by Verdict, bin(TimeGenerated, 1d)\\r\\n| sort by TimeGenerated asc\"}",
              "size": 1,
              "visualization": "barchart",
              "title": "Blocks over time by verdict",
              "queryType": "sentinelDataLake",
              "crossComponentResources": [],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "dl-blocks-trend"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"workspaces\":[],\"query\":\"UnifiedAgentObservability\\r\\n| extend Target = tostring(column_ifexists('TargetAgentName', ''))\\r\\n| where isnotempty(Target)\\r\\n| summarize Calls = sum(EventCount), Conversations = dcount(tostring(todynamic(AdditionalFields).ConversationId)), LastSeen = max(TimeGenerated) by SrcAgentName, Target\\r\\n| order by Calls desc\\r\\n| take 100\"}",
              "size": 0,
              "title": "🔗 Agent-to-agent invocations (Src → Target)",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Calls",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "orange"
                    }
                  }
                ]
              },
              "queryType": "sentinelDataLake",
              "crossComponentResources": [],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "dl-cross"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"workspaces\":[],\"query\":\"UnifiedAgentObservability\\r\\n| where EventOriginalType == 'AISpanOutput'\\r\\n| extend detail = tostring(EventOriginalResultDetails)\\r\\n| where detail matches regex @'(?i)(malicious instruction|will not comply|jailbreak|ignore (all|previous|above)|system prompt|prompt injection)'\\r\\n| project TimeGenerated, SrcAgentName, Conversation = tostring(todynamic(AdditionalFields).ConversationId), Channel = tostring(todynamic(AdditionalFields).ChannelName), Snippet = substring(detail, 0, 240)\\r\\n| order by TimeGenerated desc\\r\\n| take 100\"}",
              "size": 0,
              "title": "🚨 Refusals / injection markers in agent output",
              "queryType": "sentinelDataLake",
              "crossComponentResources": [],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "dl-content"
          },
          {
            "type": 1,
            "content": {
              "json": "### 🎯 Agent 365 use-case hunts\n\nMapped to the Agent 365 connector use cases — sensitive-data exposure, access drift, lateral movement, prompt injection, investigation, governance & proactive hunting. Filter any of these with **Agent contains** above."
            },
            "name": "dl-h3"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"workspaces\":[],\"query\":\"UnifiedAgentObservability\\r\\n| where '{AgentSearch}' == '' or SrcAgentName has '{AgentSearch}'\\r\\n| extend Tool = tostring(column_ifexists('ToolName', ''))\\r\\n| where isnotempty(Tool)\\r\\n| summarize Calls = sum(EventCount), Agents = dcount(SrcAgentName), LastUsed = max(TimeGenerated) by Tool\\r\\n| top 25 by Calls desc\"}",
              "size": 0,
              "title": "🔧 Tool usage — tools invoked by agents (sensitive actions)",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Calls",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  }
                ]
              },
              "queryType": "sentinelDataLake",
              "crossComponentResources": [],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "dl-tools"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"workspaces\":[],\"query\":\"UnifiedAgentObservability\\r\\n| where '{AgentSearch}' == '' or SrcAgentName has '{AgentSearch}'\\r\\n| extend Prompt = tostring(column_ifexists('EventOriginalRequestDetails', ''))\\r\\n| where Prompt matches regex @'(?i)(ignore (all|previous|above)|disregard.{0,20}instruction|system prompt|jailbreak|do anything now|DAN mode|developer mode|reveal.{0,20}prompt|exfiltrat)'\\r\\n| project TimeGenerated, SrcAgentName, EventProduct, Actor = tostring(column_ifexists('ActorUsername', '')), Snippet = substring(Prompt, 0, 300)\\r\\n| sort by TimeGenerated desc\\r\\n| take 200\"}",
              "size": 0,
              "title": "🧨 Prompt-injection attempts (inbound prompts)",
              "queryType": "sentinelDataLake",
              "crossComponentResources": [],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "dl-injection"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"workspaces\":[],\"query\":\"UnifiedAgentObservability\\r\\n| where '{AgentSearch}' == '' or SrcAgentName has '{AgentSearch}'\\r\\n| extend Blob = strcat(tostring(column_ifexists('EventOriginalRequestDetails', '')), ' ', tostring(EventOriginalResultDetails))\\r\\n| where Blob matches regex @'(AKIA[0-9A-Z]{16}|BEGIN [A-Z ]*PRIVATE KEY|eyJ[A-Za-z0-9_-]{10,}\\\\.[A-Za-z0-9_-]{10,}|(?i)(password|secret|connectionstring|connstring)\\\\s*[:=]|\\\\b\\\\d{3}-\\\\d{2}-\\\\d{4}\\\\b)'\\r\\n| project TimeGenerated, SrcAgentName, EventProduct, Tool = tostring(column_ifexists('ToolName', '')), Actor = tostring(column_ifexists('ActorUsername', '')), Snippet = substring(Blob, 0, 200)\\r\\n| sort by TimeGenerated desc\\r\\n| take 100\"}",
              "size": 0,
              "title": "🔐 Possible sensitive-data exposure (secrets / PII in prompt or output)",
              "queryType": "sentinelDataLake",
              "crossComponentResources": [],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "dl-sensitive"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"workspaces\":[],\"query\":\"UnifiedAgentObservability\\r\\n| extend Tool = tostring(column_ifexists('ToolName', ''))\\r\\n| where isnotempty(Tool)\\r\\n| where '{AgentSearch}' == '' or SrcAgentName has '{AgentSearch}'\\r\\n| summarize FirstUsed = min(TimeGenerated), Calls = sum(EventCount) by SrcAgentName, Tool\\r\\n| where FirstUsed > ago(7d)\\r\\n| project SrcAgentName, Tool, FirstUsed, Calls\\r\\n| sort by FirstUsed desc\\r\\n| take 100\"}",
              "size": 0,
              "title": "📈 Access drift — tools newly used by an agent (last 7 days)",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Calls",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "orange"
                    }
                  }
                ]
              },
              "queryType": "sentinelDataLake",
              "crossComponentResources": [],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "dl-drift"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"workspaces\":[],\"query\":\"let edges = UnifiedAgentObservability\\r\\n    | extend Target = tostring(column_ifexists('TargetAgentName', ''))\\r\\n    | where isnotempty(Target) and isnotempty(SrcAgentName)\\r\\n    | summarize Calls = sum(EventCount) by SrcAgentName, Target;\\r\\nlet outbound = edges | summarize CallsOut = sum(Calls) by Agent = SrcAgentName;\\r\\nlet inbound = edges | summarize CallsIn = sum(Calls) by Agent = Target;\\r\\noutbound\\r\\n| join kind=inner inbound on Agent\\r\\n| extend Total = CallsIn + CallsOut\\r\\n| project Agent, CallsIn, CallsOut, Total\\r\\n| sort by Total desc\\r\\n| take 50\"}",
              "size": 0,
              "title": "🕸️ Lateral movement — delegation intermediaries (calls in & out)",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Total",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": "sentinelDataLake",
              "crossComponentResources": [],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "dl-lateral"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"workspaces\":[],\"query\":\"UnifiedAgentObservability\\r\\n| where '{AgentSearch}' == '' or SrcAgentName has '{AgentSearch}'\\r\\n| where isempty(tostring(column_ifexists('ActorUsername', ''))) and isempty(tostring(column_ifexists('ActorUserId', '')))\\r\\n| summarize Spans = sum(EventCount), Tools = dcount(tostring(column_ifexists('ToolName', ''))), LastSeen = max(TimeGenerated) by SrcAgentName, EventProduct\\r\\n| top 30 by Spans desc\"}",
              "size": 1,
              "visualization": "barchart",
              "title": "🤖 Activity without human context (autonomous / unattended)",
              "queryType": "sentinelDataLake",
              "crossComponentResources": [],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "dl-nohuman"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"workspaces\":[],\"query\":\"UnifiedAgentObservability\\r\\n| where '{AgentSearch}' == '' or SrcAgentName has '{AgentSearch}'\\r\\n| extend hh = datetime_part('Hour', TimeGenerated), dw = dayofweek(TimeGenerated)\\r\\n| where hh < 7 or hh >= 19 or dw == 0d or dw == 6d\\r\\n| summarize OffHoursSpans = sum(EventCount), LastSeen = max(TimeGenerated) by SrcAgentName, EventProduct\\r\\n| top 30 by OffHoursSpans desc\"}",
              "size": 1,
              "visualization": "barchart",
              "title": "🌙 Off-hours agent activity (nights / weekends)",
              "queryType": "sentinelDataLake",
              "crossComponentResources": [],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "dl-offhours"
          },
          {
            "type": 1,
            "content": {
              "json": "### 🪪 Entra Agent Identity governance\n\nThese lake tables describe the Entra agent identity plane: reusable blueprints, blueprint principals, individual agent identities, and agent users. Counts are inventory, not evidence that an identity was used. Review ownership, lifecycle, credentials or federation, permissions, and sign-in activity in the authoritative Entra and Defender surfaces before concluding an identity is orphaned or risky."
            },
            "name": "dl-h2"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"workspaces\":[],\"query\":\"union isfuzzy=true\\r\\n(EntraAgentIdentities | summarize Value = count() | extend Metric = 'Agent identities', Order = 1),\\r\\n(EntraAgentIdentityBlueprints | summarize Value = count() | extend Metric = 'Blueprints', Order = 2),\\r\\n(EntraAgentIdentityBlueprintPrincipals | summarize Value = count() | extend Metric = 'Blueprint principals', Order = 3),\\r\\n(EntraAgentUsers | summarize Value = count() | extend Metric = 'Agent users', Order = 4)\\r\\n| project Order, Metric, Value\\r\\n| sort by Order asc\"}",
              "size": 3,
              "visualization": "tiles",
              "title": "Entra agent identity inventory",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                }
              },
              "queryType": "sentinelDataLake",
              "crossComponentResources": [],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "dl-entra-kpi"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"workspaces\":[],\"query\":\"EntraAgentIdentities\\r\\n| take 100\"}",
              "size": 0,
              "title": "Entra agent identities (sample)",
              "queryType": "sentinelDataLake",
              "crossComponentResources": [],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "dl-entra"
          }
        ]
      },
      "name": "group-datalake"
    },
    {
      "type": 12,
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "telemetry"
      },
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## 📡 Telemetry Health & Cost\n\nIs each AI-agent source flowing, when was it last seen, and which table drives ingestion? This page explicitly tracks `AppRequests`, `AppDependencies`, `AppExceptions`, `AppTraces`, and `AppMetrics`, plus agent-content, Copilot, and OpenAI connector sources. Use the summary tiles for posture, the table for source-specific expectations, and the charts for volume shape and cost concentration.\n\n**How to read this tab:** the summary tiles and table show whether each expected source is flowing, the hourly chart exposes gaps or abrupt volume changes, and the mix chart highlights which Application Insights table dominates ingestion. Freshness uses operational defaults: active under two hours, delayed from two to 24 hours, and stale after 24 hours. `AppExceptions` is event-driven and can be empty in a healthy system; `AppTraces`, `AppMetrics`, and `AppGenAIContent` depend on configuration. Billed size shows ingestion pressure, while content coverage explains whether text-based detections can work. Observability telemetry is sampled and is not an immutable audit log.",
              "style": "info"
            },
            "name": "tel-h"
          },
          {
            "type": 1,
            "content": {
              "json": "#### Collection health summary\n\nThe tiles count expected sources, sources with data, fresh sources, stale/delayed sources, selected-range events, and estimated ingestion volume. Freshness thresholds are operational defaults: active under two hours, delayed from two to 24 hours, and stale after 24 hours. Event-driven tables such as `AppExceptions` can legitimately have no rows."
            },
            "name": "tel-summary-desc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let ExpectedTables=datatable(Sort:int, Table:string, Plane:string, Purpose:string, Expected:string)\n[\n  1, \"AppRequests\", \"Application Insights\", \"APIM and application request traffic\", \"Core when request instrumentation is enabled\",\n  2, \"AppDependencies\", \"Application Insights\", \"Backends plus agent/model/tool spans\", \"Core for traced agents and APIM backends\",\n  3, \"AppExceptions\", \"Application Insights\", \"Exception diagnostics and root cause\", \"Event-driven; zero can be healthy\",\n  4, \"AppTraces\", \"Application Insights\", \"Application and APIM policy traces\", \"Configuration-dependent\",\n  5, \"AppMetrics\", \"Application Insights\", \"Custom and token metrics\", \"Policy/instrumentation-dependent\",\n  6, \"AppEvents\", \"Application Insights\", \"Copilot Studio and custom events\", \"Core for Studio telemetry\",\n  7, \"AppGenAIContent\", \"Application Insights\", \"Protected GenAI content\", \"Optional and access-restricted\",\n  8, \"CopilotActivity\", \"Microsoft 365\", \"Copilot and agent audit activity\", \"Core for M365 Copilot\",\n  9, \"ASimAgentEventLogs\", \"OpenAI connector\", \"Normalized agent events\", \"Connector-dependent\",\n  10, \"OpenAIAuditLogs\", \"OpenAI connector\", \"OpenAI administrative audit\", \"Connector-dependent\"\n];\nlet Observed=union isfuzzy=true\n(AppRequests | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"AppRequests\"),\n(AppDependencies | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"AppDependencies\"),\n(AppExceptions | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"AppExceptions\"),\n(AppTraces | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"AppTraces\"),\n(AppMetrics | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"AppMetrics\"),\n(AppEvents | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"AppEvents\"),\n(AppGenAIContent | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"AppGenAIContent\"),\n(CopilotActivity | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"CopilotActivity\"),\n(ASimAgentEventLogs | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"ASimAgentEventLogs\"),\n(OpenAIAuditLogs | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"OpenAIAuditLogs\")\n| project Table, Events, GB, Last;\nlet Inventory=ExpectedTables\n| join kind=leftouter Observed on Table\n| extend Events=coalesce(Events, 0), GB=round(coalesce(GB, 0.0), 4)\n| extend Status=case(Events == 0, \"⚪ No data in range\", Last < ago(24h), \"🔴 Stale >24h\", Last < ago(2h), \"🟡 Delayed 2-24h\", \"🟢 Active <2h\");\nunion\n(Inventory | summarize Value=todouble(countif(Events > 0)) | extend Metric=\"Sources with data\", Order=1),\n(Inventory | summarize Value=todouble(countif(Status startswith \"🟢\")) | extend Metric=\"Fresh <2h\", Order=2),\n(Inventory | summarize Value=todouble(countif(Status startswith \"🟡\" or Status startswith \"🔴\")) | extend Metric=\"Delayed or stale\", Order=3),\n(Inventory | summarize Value=todouble(countif(Plane == \"Application Insights\" and Events > 0)) | extend Metric=\"App Insights tables flowing\", Order=4),\n(Inventory | summarize Value=todouble(sum(Events)) | extend Metric=\"Events in range\", Order=5),\n(Inventory | summarize Value=round(sum(GB), 4) | extend Metric=\"Estimated GB\", Order=6)\n| project Order, Metric, Value\n| order by Order asc",
              "size": 3,
              "visualization": "tiles",
              "title": "Telemetry collection health",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                }
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "tel-summary"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let ExpectedTables=datatable(Sort:int, Table:string, Plane:string, Purpose:string, Expected:string)\n[\n  1, \"AppRequests\", \"Application Insights\", \"APIM and application request traffic\", \"Core when request instrumentation is enabled\",\n  2, \"AppDependencies\", \"Application Insights\", \"Backends plus agent/model/tool spans\", \"Core for traced agents and APIM backends\",\n  3, \"AppExceptions\", \"Application Insights\", \"Exception diagnostics and root cause\", \"Event-driven; zero can be healthy\",\n  4, \"AppTraces\", \"Application Insights\", \"Application and APIM policy traces\", \"Configuration-dependent\",\n  5, \"AppMetrics\", \"Application Insights\", \"Custom and token metrics\", \"Policy/instrumentation-dependent\",\n  6, \"AppEvents\", \"Application Insights\", \"Copilot Studio and custom events\", \"Core for Studio telemetry\",\n  7, \"AppGenAIContent\", \"Application Insights\", \"Protected GenAI content\", \"Optional and access-restricted\",\n  8, \"CopilotActivity\", \"Microsoft 365\", \"Copilot and agent audit activity\", \"Core for M365 Copilot\",\n  9, \"ASimAgentEventLogs\", \"OpenAI connector\", \"Normalized agent events\", \"Connector-dependent\",\n  10, \"OpenAIAuditLogs\", \"OpenAI connector\", \"OpenAI administrative audit\", \"Connector-dependent\"\n];\nlet Observed=union isfuzzy=true\n(AppRequests | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"AppRequests\"),\n(AppDependencies | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"AppDependencies\"),\n(AppExceptions | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"AppExceptions\"),\n(AppTraces | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"AppTraces\"),\n(AppMetrics | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"AppMetrics\"),\n(AppEvents | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"AppEvents\"),\n(AppGenAIContent | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"AppGenAIContent\"),\n(CopilotActivity | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"CopilotActivity\"),\n(ASimAgentEventLogs | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"ASimAgentEventLogs\"),\n(OpenAIAuditLogs | summarize Events=count(), GB=sum(toreal(column_ifexists(\"_BilledSize\", 0.0)))/1073741824.0, Last=max(TimeGenerated) | extend Table=\"OpenAIAuditLogs\")\n| project Table, Events, GB, Last;\nlet Inventory=ExpectedTables\n| join kind=leftouter Observed on Table\n| extend Events=coalesce(Events, 0), GB=round(coalesce(GB, 0.0), 4)\n| extend Status=case(Events == 0, \"⚪ No data in range\", Last < ago(24h), \"🔴 Stale >24h\", Last < ago(2h), \"🟡 Delayed 2-24h\", \"🟢 Active <2h\");\nInventory\n| project Table, Plane, Status, Events, GB, Last, Purpose, Expected, Sort\n| order by Sort asc\n| project-away Sort",
              "size": 0,
              "title": "Per-table volume, cost & freshness",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Status",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "Events",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  },
                  {
                    "columnMatch": "GB",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "tel-tables"
          },
          {
            "type": 1,
            "content": {
              "json": "#### Application Insights signal shape\n\nThe trend and mix charts cover `AppRequests`, `AppDependencies`, `AppExceptions`, `AppTraces`, and `AppMetrics`. Use the trend to identify ingestion gaps or sudden signal shifts and the mix to spot a high-volume table dominating ingestion. Counts are telemetry rows, not unique agent runs, and sampling changes the apparent distribution."
            },
            "name": "tel-appinsights-visuals-desc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true\n(AppRequests | summarize Events=count() by bin(TimeGenerated, 1h) | extend Table=\"AppRequests\"),\n(AppDependencies | summarize Events=count() by bin(TimeGenerated, 1h) | extend Table=\"AppDependencies\"),\n(AppExceptions | summarize Events=count() by bin(TimeGenerated, 1h) | extend Table=\"AppExceptions\"),\n(AppTraces | summarize Events=count() by bin(TimeGenerated, 1h) | extend Table=\"AppTraces\"),\n(AppMetrics | summarize Events=count() by bin(TimeGenerated, 1h) | extend Table=\"AppMetrics\")\n| order by TimeGenerated asc",
              "size": 0,
              "visualization": "timechart",
              "title": "Application Insights table volume over time",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "tel-appinsights-trend"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true\n(AppRequests | summarize Events=count() | extend Table=\"AppRequests\"),\n(AppDependencies | summarize Events=count() | extend Table=\"AppDependencies\"),\n(AppExceptions | summarize Events=count() | extend Table=\"AppExceptions\"),\n(AppTraces | summarize Events=count() | extend Table=\"AppTraces\"),\n(AppMetrics | summarize Events=count() | extend Table=\"AppMetrics\")\n| where Events > 0\n| project Table, Events\n| order by Events desc",
              "size": 1,
              "visualization": "piechart",
              "title": "Application Insights telemetry mix",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "tel-appinsights-mix"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppDependencies\r\n| extend IsAgentSpan = isnotempty(tostring(Properties['gen_ai.system'])) or isnotempty(tostring(Properties['gen_ai.agent.name']))\r\n| summarize Rows = count(), GB = round(sum(_BilledSize) / 1073741824.0, 3) by SpanType = iff(IsAgentSpan, '🟢 gen_ai agent spans (keep)', '⚪ other dependency telemetry (filterable to cut cost)')",
              "size": 1,
              "visualization": "piechart",
              "title": "AppDependencies — agent spans vs other telemetry (cost lever)",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "tel-split"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true\n(CopilotActivity\n| where RecordType == 'CopilotInteraction'\n| summarize Total = count(), WithText = countif(isnotempty(tostring(LLMEventData.Prompt)) or isnotempty(tostring(LLMEventData.Response)))\n| extend Source = 'M365 Copilot (LLMEventData.Prompt/Response)'),\n(AppEvents\n| where Name startswith 'BotMessage'\n| summarize Total = count(), WithText = countif(isnotempty(tostring(Properties['text'])))\n| extend Source = 'Copilot Studio (Properties.text - Log sensitive properties)'),\n(union isfuzzy=true\n    (AppDependencies\n    | where isnotempty(tostring(Properties['gen_ai.agent.name']))\n    | extend ContentKey = strcat(OperationId, \":\", Id), HasText = isnotempty(tostring(Properties['gen_ai.input.messages'])) or isnotempty(tostring(Properties['gen_ai.output.messages']))\n    | project ContentKey, HasText),\n    (AppGenAIContent\n    | extend ContentKey = strcat(TraceId, \":\", SpanId), HasText = isnotempty(InputMessages) or isnotempty(OutputMessages)\n    | project ContentKey, HasText)\n| summarize HasText = max(toint(HasText)) by ContentKey\n| summarize Total = count(), WithText = countif(HasText == 1)\n| extend Source = 'Foundry / agent OTel (protected AppGenAIContent)')\n| extend TextCoveragePct = iff(Total == 0, 0.0, round(100.0 * WithText / Total, 1))\n| project Source, Total, WithText, TextCoveragePct",
              "size": 0,
              "title": "Content-recording coverage (drives text detections)",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "TextCoveragePct",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "green"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "tel-content"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "CopilotActivity\r\n| summarize Events = count(), GB = round(sum(_BilledSize) / 1073741824.0, 3) by RecordType\r\n| extend Tier = iff(RecordType == 'CopilotInteraction', 'bulk → Auxiliary/lake candidate', 'admin/config → keep on Analytics')\r\n| order by Events desc",
              "size": 0,
              "title": "CopilotActivity RecordType mix (tiering guidance)",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Events",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  },
                  {
                    "columnMatch": "GB",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "tel-rectype"
          }
        ]
      },
      "name": "group-telemetry"
    },
    {
      "type": 12,
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "exec"
      },
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## 🧭 Executive Overview — AI estate at a glance\n\nUnified KPIs across all AI platforms (AIRequests = M365 Copilot + Copilot Studio + Foundry + OpenAI), plus the composite **AI Risk Score**, requests by platform / business unit, and top identities. Business unit is resolved via an `IdentityInfo` join on the actor UPN.\n\n**How to read this tab:** use the KPIs for scale and direction, then use platform, department, and identity panels to find concentration or unexplained change. The unified request abstraction combines different event grains: a Copilot interaction, Studio inbound turn, Foundry span, and OpenAI event are not identical units. Cost covers sources with token telemetry only; department attribution depends on an exact identity-to-`IdentityInfo.AccountUPN` match; the risk score is a prioritization index, not a compliance grade or probability of compromise.",
              "style": "info"
            },
            "name": "ex-h"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let AIRequests = union isfuzzy=true\r\n(datatable(TimeGenerated:datetime, Platform:string, AgentName:string, Identity:string, Model:string, InTok:real, OutTok:real, LatencyMs:real, ConversationId:string)[]),\r\n(CopilotActivity | where RecordType == 'CopilotInteraction' | extend Platform = 'M365 Copilot', AgentName = tostring(AgentName), Identity = tostring(ActorName), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(LLMEventData.ConversationId)),\r\n(AppEvents | where Name == 'BotMessageReceived' | extend Platform = 'Copilot Studio', AgentName = tostring(UserId), Identity = tostring(UserId), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(Properties['conversationId'])),\r\n(AppDependencies | where isnotempty(tostring(Properties['gen_ai.agent.name'])) | extend Platform = 'Azure AI Foundry', AgentName = tostring(Properties['gen_ai.agent.name']), Identity = tostring(Properties['gen_ai.agent.name']), Model = tostring(Properties['gen_ai.request.model']), InTok = toreal(tolong(Properties['gen_ai.usage.input_tokens'])), OutTok = toreal(tolong(Properties['gen_ai.usage.output_tokens'])), LatencyMs = toreal(DurationMs), ConversationId = tostring(Properties['gen_ai.conversation.id'])),\r\n(ASimAgentEventLogs | extend Platform = 'OpenAI', AgentName = coalesce(tostring(TargetAgentName), tostring(SrcAgentName), tostring(ModelName)), Identity = coalesce(tostring(ActorUsername), tostring(ActorUserId)), Model = tostring(ModelName), InTok = toreal(tolong(InputTokensUsed)), OutTok = toreal(tolong(OutputTokensUsed)), LatencyMs = iff(isnotempty(EventStartTime) and isnotempty(EventEndTime), toreal(datetime_diff('millisecond', EventEndTime, EventStartTime)), toreal(0)), ConversationId = tostring(EventSessionId))\r\n| project TimeGenerated, Platform, AgentName, Identity, Model, InTok, OutTok, LatencyMs, ConversationId;let A = AgentsInfo | summarize arg_max(TimeGenerated, *) by AgentId;\r\nlet totReq   = toscalar(AIRequests | summarize count());\r\nlet totAg    = toscalar(A | summarize count());\r\nlet active24 = toscalar(AIRequests | where TimeGenerated > ago(24h) | summarize dcount(AgentName));\r\nlet newAg    = toscalar(A | where CreatedDateTime > ago(7d) | summarize count());\r\nlet disAg    = toscalar(A | where PublishedStatus !~ 'Published' or tostring(LifecycleStatus) has 'Disabled' | summarize count());\r\nlet inj      = toscalar(union isfuzzy=true (union isfuzzy=true\n(AppDependencies\n| extend ContentKey = strcat(OperationId, \":\", Id), RecordedInput = tostring(Properties['gen_ai.input.messages'])\n| where isnotempty(RecordedInput)\n| project TimeGenerated, ContentKey, RecordedInput),\n(AppGenAIContent\n| extend ContentKey = strcat(TraceId, \":\", SpanId), RecordedInput = tostring(InputMessages)\n| where isnotempty(RecordedInput)\n| project TimeGenerated, ContentKey, RecordedInput)\n| summarize arg_max(TimeGenerated, RecordedInput) by ContentKey\n| where RecordedInput matches regex @'(?i)(ignore (all|previous)|jailbreak|system prompt)'), (CopilotActivity | mv-expand m = LLMEventData.Messages | where tobool(m.JailbreakDetected) == true) | summarize count());\r\nlet safe     = toscalar(AppDependencies | where isnotempty(tostring(Properties['microsoft.foundry.content_filter.results'])) | summarize count());\r\nlet sens     = toscalar(union isfuzzy=true (CopilotActivity | mv-expand r = LLMEventData.AccessedResources | where tobool(r.XPIADetected) == true), (AppEvents | where Name == 'BotMessageSend' and tostring(Properties['text']) matches regex @'(AKIA[0-9A-Z]{16}|BEGIN [A-Z ]*PRIVATE KEY)') | summarize count());\r\nlet plug     = toscalar(CopilotActivity | where RecordType has 'Plugin' | summarize count());\r\nlet tool     = toscalar(union isfuzzy=true (AppDependencies | where isnotempty(tostring(Properties['gen_ai.tool.name']))), (ASimAgentEventLogs | where isnotempty(ToolName)) | summarize count());\r\nlet ftool    = toscalar(AppDependencies | where Success == false and (AppRoleName == 'Microsoft Copilot Studio' or isnotempty(tostring(Properties['gen_ai.tool.name']))) | summarize count());\r\nlet hrs      = toscalar(union isfuzzy=true (AppDependencies | where isnotempty(tostring(Properties['microsoft.foundry.content_filter.results'])) | extend cid = tostring(Properties['gen_ai.conversation.id'])), (CopilotActivity | mv-expand m = LLMEventData.Messages | where tobool(m.JailbreakDetected) == true | extend cid = tostring(LLMEventData.ConversationId)) | summarize dcount(cid));\r\nlet third    = toscalar(union isfuzzy=true (datatable(Application:string)[]), (CloudAppEvents | where Application has_any ('OpenAI','ChatGPT','Claude','Anthropic','Gemini','Perplexity','Mistral') | project Application) | summarize dcount(Application));\r\nlet cost     = toscalar(AIRequests | summarize InTok = sum(InTok), OutTok = sum(OutTok) | extend c = round((todouble(coalesce(InTok, 0.0)) / 1000.0) * toreal('{PriceInput}') + (todouble(coalesce(OutTok, 0.0)) / 1000.0) * toreal('{PriceOutput}'), 2) | project c);\r\nlet lat      = toscalar(AppDependencies | where isnotempty(tostring(Properties['gen_ai.agent.name'])) and DurationMs > 0 | summarize round(avg(DurationMs), 0));\r\nunion\r\n(print Order = 1,  Metric = 'Total AI requests',            Value = todouble(totReq)),\r\n(print Order = 2,  Metric = 'Total AI agents',              Value = todouble(totAg)),\r\n(print Order = 3,  Metric = 'Active agents (24h)',          Value = todouble(active24)),\r\n(print Order = 4,  Metric = 'New agents (7d)',              Value = todouble(newAg)),\r\n(print Order = 5,  Metric = 'Disabled / unpublished',       Value = todouble(disAg)),\r\n(print Order = 6,  Metric = 'Prompt injection / jailbreak', Value = todouble(inj)),\r\n(print Order = 7,  Metric = 'Content-safety blocks',        Value = todouble(safe)),\r\n(print Order = 8,  Metric = 'Sensitive-data events',        Value = todouble(sens)),\r\n(print Order = 9,  Metric = 'Plugin executions',            Value = todouble(plug)),\r\n(print Order = 10, Metric = 'Tool executions',              Value = todouble(tool)),\r\n(print Order = 11, Metric = 'Failed tool executions',       Value = todouble(ftool)),\r\n(print Order = 12, Metric = 'High-risk sessions',           Value = todouble(hrs)),\r\n(print Order = 13, Metric = 'Third-party AI apps',          Value = todouble(third)),\r\n(print Order = 14, Metric = 'Est. token cost (USD)',        Value = todouble(cost)),\r\n(print Order = 15, Metric = 'Avg latency (ms)',             Value = todouble(lat))\r\n| project Order, Metric, Value\r\n| sort by Order asc",
              "size": 4,
              "visualization": "tiles",
              "title": "Executive KPIs",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                }
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ex-kpi"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let AIRequests = union isfuzzy=true\r\n(datatable(TimeGenerated:datetime, Platform:string, AgentName:string, Identity:string, Model:string, InTok:real, OutTok:real, LatencyMs:real, ConversationId:string)[]),\r\n(CopilotActivity | where RecordType == 'CopilotInteraction' | extend Platform = 'M365 Copilot', AgentName = tostring(AgentName), Identity = tostring(ActorName), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(LLMEventData.ConversationId)),\r\n(AppEvents | where Name == 'BotMessageReceived' | extend Platform = 'Copilot Studio', AgentName = tostring(UserId), Identity = tostring(UserId), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(Properties['conversationId'])),\r\n(AppDependencies | where isnotempty(tostring(Properties['gen_ai.agent.name'])) | extend Platform = 'Azure AI Foundry', AgentName = tostring(Properties['gen_ai.agent.name']), Identity = tostring(Properties['gen_ai.agent.name']), Model = tostring(Properties['gen_ai.request.model']), InTok = toreal(tolong(Properties['gen_ai.usage.input_tokens'])), OutTok = toreal(tolong(Properties['gen_ai.usage.output_tokens'])), LatencyMs = toreal(DurationMs), ConversationId = tostring(Properties['gen_ai.conversation.id'])),\r\n(ASimAgentEventLogs | extend Platform = 'OpenAI', AgentName = coalesce(tostring(TargetAgentName), tostring(SrcAgentName), tostring(ModelName)), Identity = coalesce(tostring(ActorUsername), tostring(ActorUserId)), Model = tostring(ModelName), InTok = toreal(tolong(InputTokensUsed)), OutTok = toreal(tolong(OutputTokensUsed)), LatencyMs = iff(isnotempty(EventStartTime) and isnotempty(EventEndTime), toreal(datetime_diff('millisecond', EventEndTime, EventStartTime)), toreal(0)), ConversationId = tostring(EventSessionId))\r\n| project TimeGenerated, Platform, AgentName, Identity, Model, InTok, OutTok, LatencyMs, ConversationId;let inj = toscalar(union isfuzzy=true (union isfuzzy=true\n(AppDependencies\n| extend ContentKey = strcat(OperationId, \":\", Id), RecordedInput = tostring(Properties['gen_ai.input.messages'])\n| where isnotempty(RecordedInput)\n| project TimeGenerated, ContentKey, RecordedInput),\n(AppGenAIContent\n| extend ContentKey = strcat(TraceId, \":\", SpanId), RecordedInput = tostring(InputMessages)\n| where isnotempty(RecordedInput)\n| project TimeGenerated, ContentKey, RecordedInput)\n| summarize arg_max(TimeGenerated, RecordedInput) by ContentKey\n| where RecordedInput matches regex @'(?i)(ignore (all|previous)|jailbreak|system prompt)'), (CopilotActivity | mv-expand m = LLMEventData.Messages | where tobool(m.JailbreakDetected) == true) | summarize count());\r\nlet safety = toscalar(AppDependencies | where isnotempty(tostring(Properties['microsoft.foundry.content_filter.results'])) | summarize count());\r\nlet sens = toscalar(union isfuzzy=true (CopilotActivity | mv-expand r = LLMEventData.AccessedResources | where tobool(r.XPIADetected) == true), (AppEvents | where Name == 'BotMessageSend' and tostring(Properties['text']) matches regex @'(AKIA[0-9A-Z]{16}|BEGIN [A-Z ]*PRIVATE KEY)') | summarize count());\r\nlet tool = toscalar(union isfuzzy=true (AppDependencies | where isnotempty(tostring(Properties['gen_ai.tool.name']))), (ASimAgentEventLogs | where isnotempty(ToolName)) | summarize count());\r\nlet alerts = toscalar(union isfuzzy=true (SecurityAlert | where TimeGenerated > ago(7d) and AlertName has_any ('Copilot','Foundry','OpenAI','Agent','Prompt','Jailbreak','AI')) | summarize count());\r\nlet ext = toscalar(union isfuzzy=true (CloudAppEvents | where Application has_any ('OpenAI','ChatGPT','Claude','Anthropic','Gemini','Perplexity','Mistral')) | summarize count());\r\nlet gov = toscalar(AgentsInfo | summarize arg_max(TimeGenerated, *) by AgentId | where isempty(tostring(Owners)) or tostring(Owners) in ('', '[]') | summarize count());\r\nlet sc = (v:long, cap:real) { min_of(100.0, todouble(v) / cap * 100.0) };\r\nlet s_inj = sc(inj, 50.0); let s_safe = sc(safety, 50.0); let s_sens = sc(sens, 20.0); let s_tool = sc(tool, 500.0); let s_alert = sc(alerts, 10.0); let s_ext = sc(ext, 20.0); let s_gov = sc(gov, 10.0);\r\nlet overall = round(0.22 * s_inj + 0.18 * s_safe + 0.18 * s_sens + 0.10 * s_tool + 0.14 * s_alert + 0.09 * s_ext + 0.09 * s_gov, 0);\r\nunion\r\n(print Metric = 'AI Risk Score', Value = overall, Order = 1),\r\n(print Metric = 'Prompt injection', Value = round(s_inj, 0), Order = 2),\r\n(print Metric = 'Content safety', Value = round(s_safe, 0), Order = 3),\r\n(print Metric = 'Sensitive data', Value = round(s_sens, 0), Order = 4),\r\n(print Metric = 'Tool / plugin risk', Value = round(s_tool, 0), Order = 5),\r\n(print Metric = 'Detection alerts', Value = round(s_alert, 0), Order = 6),\r\n(print Metric = 'Third-party AI', Value = round(s_ext, 0), Order = 7),\r\n(print Metric = 'Governance', Value = round(s_gov, 0), Order = 8)\r\n| project Order, Metric, Value\r\n| sort by Order asc",
              "size": 2,
              "visualization": "tiles",
              "title": "🎯 AI Risk Score (0-100, weighted composite)",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "red"
                  }
                },
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                }
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "ex-risk"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let AIRequests = union isfuzzy=true\r\n(datatable(TimeGenerated:datetime, Platform:string, AgentName:string, Identity:string, Model:string, InTok:real, OutTok:real, LatencyMs:real, ConversationId:string)[]),\r\n(CopilotActivity | where RecordType == 'CopilotInteraction' | extend Platform = 'M365 Copilot', AgentName = tostring(AgentName), Identity = tostring(ActorName), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(LLMEventData.ConversationId)),\r\n(AppEvents | where Name == 'BotMessageReceived' | extend Platform = 'Copilot Studio', AgentName = tostring(UserId), Identity = tostring(UserId), Model = '', InTok = toreal(0), OutTok = toreal(0), LatencyMs = toreal(0), ConversationId = tostring(Properties['conversationId'])),\r\n(AppDependencies | where isnotempty(tostring(Properties['gen_ai.agent.name'])) | extend Platform = 'Azure AI Foundry', AgentName = tostring(Properties['gen_ai.agent.name']), Identity = tostring(Properties['gen_ai.agent.name']), Model = tostring(Properties['gen_ai.request.model']), InTok = toreal(tolong(Properties['gen_ai.usage.input_tokens'])), OutTok = toreal(tolong(Properties['gen_ai.usage.output_tokens'])), LatencyMs = toreal(DurationMs), ConversationId = tostring(Properties['gen_ai.conversation.id'])),\r\n(ASimAgentEventLogs | extend Platform = 'OpenAI', AgentName = coalesce(tostring(TargetAgentName), tostring(SrcAgentName), tostring(ModelName)), Identity = coalesce(tostring(ActorUsername), tostring(ActorUserId)), Model = tostring(ModelName), InTok = toreal(tolong(InputTokensUsed)), OutTok = toreal(tolong(OutputTokensUsed)), LatencyMs = iff(isnotempty(EventStartTime) and isnotempty(EventEndTime), toreal(datetime_diff('millisecond', EventEndTime, EventStartTime)), toreal(0)), ConversationId = tostring(EventSessionId))\r\n| project TimeGenerated, Platform, AgentName, Identity, Model, InTok, OutTok, LatencyMs, ConversationId;AIRequests | summarize Requests = count() by bin(TimeGenerated, 1h), Platform",
              "size": 0,
              "visualization": "timechart",
