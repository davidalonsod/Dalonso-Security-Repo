          {
            "type": 1,
            "content": {
              "json": "#### Command-capable tool definitions\n\nReplicates `APIMCommandCapableToolDefinition` by inspecting captured request tool definitions for shell, command, code execution, PowerShell, terminal, SSH, reverse-shell, or offensive-tool capability. This proves exposure of a dangerous tool surface, not invocation or successful execution."
            },
            "name": "apim-command-tools-desc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppRequests\n| where SDKVersion startswith \"apim:\" or tostring(Properties[\"Service Type\"]) =~ \"API Management\"\n| extend RequestBody = tostring(Properties[\"Request-Body\"]), ResponseBody = tostring(Properties[\"Response-Body\"]), RequestJson = parse_json(tostring(Properties[\"Request-Body\"]))\n| extend Input = tostring(RequestJson.input), Instructions = tostring(RequestJson.instructions), Model = tostring(RequestJson.model), Tools = tostring(RequestJson.tools)\n| where Tools matches regex @\"(?i)(run[_ -]?(shell|command|code)|execute[_ -]?(shell|command|code)|powershell|cmd.exe|terminal|reverse[_ -]?shell|metasploit|kali|ssh[_ -]?exec|remote[_ -]?code[_ -]?execution)\"\n| extend Caller = coalesce(UserAuthenticatedId, UserId, ClientIP, \"unknown\"), RequestId = tostring(Properties[\"Request Id\"]), APIName = tostring(Properties[\"API Name\"])\n| project TimeGenerated, Signal = \"COMMAND-CAPABLE TOOL EXPOSED\", Caller, Success, ResultCode, APIName, Name, Url, Model, Input, Instructions, Tools, RequestBody, ResponseBody, RequestId, OperationId\n| order by TimeGenerated desc\n| take 250",
              "size": 0,
              "title": "Command-capable tools exposed through APIM",
              "gridSettings": {
