          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let SafetyEvents = AppTraces\n| where SDKVersion startswith \"apim:\"\n| extend MatchText = strcat(Message, \" \", tostring(Properties))\n| where MatchText has_any (\"prompt_injection_blocked\", \"prompt shield\", \"prompt injection\", \"jailbreak\", \"content safety\")\n| extend Signal = case(MatchText has_any (\"prompt_injection_blocked\", \"prompt shield\", \"prompt injection\", \"jailbreak\"), \"Prompt attack blocked\", \"Content safety event\"),\n    Severity = case(SeverityLevel >= 4, \"CRITICAL\", SeverityLevel == 3, \"HIGH\", SeverityLevel == 2, \"MEDIUM\", \"INFORMATIONAL\"),\n    Control = tostring(Properties[\"control\"]),\n    ContentLogged = tostring(Properties[\"content_logged\"]),\n    ServiceName = tostring(Properties[\"Service Name\"]),\n    Region = tostring(Properties[\"Region\"])\n| project TimeGenerated, OperationId, Signal, Severity, SeverityLevel,\n    Message, Control, ContentLogged, ServiceName, Region, AppRoleName, SDKVersion;\nlet Requests = AppRequests\n| where SDKVersion startswith \"apim:\"\n| summarize arg_max(TimeGenerated, *) by OperationId\n| project OperationId, RequestResult = ResultCode, RequestBlocked = Success == false,\n    RequestOperation = Name, RequestUrl = Url,\n    Caller = coalesce(UserAuthenticatedId, UserId, ClientIP, \"unknown\"),\n    RequestId = tostring(Properties[\"Request Id\"]);\nSafetyEvents\n| join kind=leftouter Requests on OperationId\n| project TimeGenerated, Signal, Severity, Message, Control, ContentLogged,\n    RequestResult, RequestBlocked, Caller, RequestOperation, RequestUrl,\n    RequestId, OperationId, ServiceName, Region, AppRoleName\n| order by TimeGenerated desc\n| take 250",
              "size": 0,
              "title": "APIM Prompt Shield / content-safety policy events",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Signal",
                    "formatter": 0
