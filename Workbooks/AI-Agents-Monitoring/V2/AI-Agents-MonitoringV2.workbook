, \"R10\", \"Model Exploitation\", \"Model Poisoning\", \"Unauthorized or malicious model replacement or behavior change\", \"Persistent model compromise\", \"LLM04\", \"AML.T0020\", \"PARTIAL\", \"fo-agents; mo-grid\", \"FoundryNewModelFirstSeen; CopilotStudioNewModelFirstSeen; CopilotSystemPromptOverride\", \"First-seen or configuration drift detects model change, not poisoned weights\",\n  11, \"R11\", \"Data & Knowledge\", \"Data Poisoning\", \"Manipulated knowledge or input data\", \"Persistent contamination\", \"LLM04\", \"AML.T0020\", \"PARTIAL\", \"cp-rag; dl-drift; gv-ext\", \"RagSourcePoisoningWrites; FoundrySessionContextContamination\", \"No direct data-integrity or lineage proof for every source\",\n  12, \"R12\", \"Data & Knowledge\", \"RAG Poisoning\", \"Malicious content in retrieval and grounding sources\", \"Persistent contamination\", \"LLM04 / LLM08\", \"AML.T0020\", \"OBSERVABLE\", \"cp-rag; fo-mcp-external; dl-content\", \"FoundryUntrustedToolSource; RagSourcePoisoningWrites; FoundryAgentMemoryPoisoning\", \"Often inferred from source and context behavior rather than document truth\",\n  13, \"R13\", \"Data & Knowledge\", \"Vector Database Poisoning\", \"Manipulated embeddings, index entries, or nearest-neighbor results\", \"Persistent contamination\", \"LLM08\", \"AML.T0020\", \"CONDITIONAL\", \"Evidence contract only; no live panel\", \"Azure AI Search Indexing.Index audit required\", \"Requires Search diagnostic logs plus content integrity, provenance, and caller attribution\",\n  14, \"R14\", \"Runtime\", \"Insecure Output Handling\", \"Unsafe HTML, Markdown, scripts, commands, or active content consumed downstream\", \"Operational compromise\", \"LLM05\", \"AML.T0050\", \"OBSERVABLE\", \"apim-unsafe-active-output; apim-verdict; st-sens; dl-content\", \"APIMUnsafeActiveContentResponse; FoundryUnsafeActiveContentInOutput; CopilotStudioUnsafeActiveContentInResponse; CopilotUnsafeActiveContentInResponse\", \"Output visibility does not show whether a downstream renderer executed it\",\n  15, \"R15\", \"Tools & APIs\", \"SSRF\", \"Agent or tool reaches internal, metadata, loopback, or unapproved endpoints\", \"Action or lateral movement\", \"LLM05 / LLM06\", \"AML.T0049\", \"OBSERVABLE\", \"fo-mcp-external; tm-verdict-events; st-mcp-external; apim-recon\", \"FoundryInternalNetworkTargetToolCall; CopilotStudioInternalNetworkTargetCall\", \"A successful URL-bearing tool span does not prove that the target returned data; M365 lacks target telemetry\",\n  16, \"R16\", \"Runtime\", \"Sandbox Escape\", \"Agent or tool escapes container, VM, browser, or execution boundary\", \"Operational compromise\", \"LLM05\", \"AML.T0011\", \"PARTIAL\", \"ah-vscode-mcp-processes; ah-vscode-mcp-risk\", \"VSCodeMcpCommandCapableProcess\", \"Endpoint process evidence does not cover every cloud sandbox or prove escape\",\n  17, \"R17\", \"Agent Decision\", \"Excessive Agency\", \"Autonomous action beyond intended scope or approval\", \"Privilege abuse\", \"LLM06\", \"AML.T0047 / AML.T0050\", \"COVERED\", \"apim-volume-anomaly; apim-new-operation; apim-operation-combination; fo-tools; dl-nohuman\", \"APIMAbnormalRequestVolume; APIMNewOperationFirstSeen; FoundryExcessiveToolChaining; CopilotStudioExcessiveToolAgency; CopilotTraceLevelAnomaly\", \"Gateway activity shows behavioral drift but not whether agent authorization was appropriate\",\n  18, \"R18\", \"Tools & APIs\", \"Unauthorized Tool Invocation\", \"Unapproved server, tool, connector, or operation is invoked\", \"Action or lateral movement\", \"LLM06\", \"AML.T0040\", \"COVERED\", \"apim-command-tools; fo-mcp-allowlist; st-mcp-allowlist; ah-vscode-mcp-calls\", \"FoundryMcpUnapprovedServerExecution; CopilotStudioUntrustedMcpTarget; APIMCommandCapableToolDefinition\", \"APIM shows dangerous capability exposure but not invocation unless agent spans are correlated\",\n  19, \"R19\", \"Tools & APIs\", \"Function Call Manipulation\", \"Manipulated tool name, arguments, schema, routing, or result\", \"Action or lateral movement\", \"LLM06\", \"AML.T0053\", \"COVERED\", \"fo-mcp-exploit-chain; st-mcp-exploit-intent; apim-body-events\", \"FoundryMcpExploitIntentExecutionChain; CopilotStudioMcpExploitExecutionChain\", \"Content recording is required for argument/intent evidence\",\n  20, \"R20\", \"Agent Decision\", \"Confused Deputy\", \"Agent misuses its identity or permissions on behalf of a lower-privileged actor\", \"Privilege abuse\", \"LLM06\", \"AML.T0047\", \"PARTIAL\", \"apim-new-operation; apim-new-country; apim-request-dependency; fo-mcp-trace-chain; dl-lateral\", \"APIMNewOperationFirstSeen; APIMNewCountryForKnownCaller; FoundryInterAgentPermissionMismatch; CopilotStudioInterAgentPermissionMismatch\", \"APIM detects identity behavior drift but not effective delegated authorization; M365 lacks inter-agent authorization telemetry\",\n  21, \"R21\", \"Confidentiality\", \"Context Leakage\", \"Conversation, tenant, session, memory, or retrieved context crosses boundaries\", \"Data loss\", \"LLM07\", \"AML.T0056\", \"PARTIAL\", \"dl-content; iv-feed; fo-mcp-trace-chain\", \"FoundrySessionContextContamination; CopilotStudioSessionContextContamination\", \"Requires stable tenant/session identifiers and content access\",\n  22, \"R22\", \"Confidentiality\", \"System Prompt Leakage\", \"System/developer instructions or tool architecture are disclosed\", \"Data loss\", \"LLM07\", \"AML.T0056\", \"COVERED\", \"apim-system-prompt-disclosure; apim-verdict; fo-inj; tl-feed\", \"APIMSystemPromptDisclosure; FoundrySystemPromptDisclosure; CopilotStudioSystemPromptDisclosure; CopilotSystemPromptDisclosure\", \"Full prompt visibility is sensitive and opt-in\",\n  23, \"R23\", \"Model Exploitation\", \"Hallucination\", \"Unsupported or factually incorrect output\", \"Wrong decision\", \"LLM09\", \"AML.T0015\", \"CONDITIONAL\", \"Evidence contract only; no live panel\", \"Foundry Groundedness / Groundedness Pro evaluation required\", \"Continuous evaluation can score sampled outputs; evaluator failure is evidence of ungroundedness, not universal factual truth\",\n  24, \"R24\", \"Model Exploitation\", \"Adversarial Hallucination\", \"Attacker intentionally induces false but plausible output\", \"Wrong decision\", \"LLM09\", \"AML.T0015\", \"CONDITIONAL\", \"Evidence contract only; no live panel\", \"Foundry red-team scan and evaluation output required\", \"Attack-success and groundedness results are test evidence; production causation still requires trace correlation\",\n  25, \"R25\", \"Runtime\", \"Agent Looping\", \"Repeated tool/model calls or non-terminating workflow\", \"Operational or economic impact\", \"LLM10\", \"AML.T0050\", \"COVERED\", \"apim-volume-anomaly; apim-high-failure; apim-request-dependency; fo-tokens; fo-time\", \"APIMAbnormalRequestVolume; APIMHighFailureRate; FoundryExcessiveToolChaining; CopilotStudioExcessiveToolAgency; CopilotTraceLevelAnomaly\", \"APIM request patterns can indicate loops but agent/tool spans provide stronger proof\",\n  26, \"R26\", \"Runtime\", \"Cost Amplification Attack\", \"Token, tool, retrieval, or model-call amplification\", \"Economic impact\", \"LLM10\", \"AML.T0029 / AML.T0034\", \"COVERED\", \"apim-volume-anomaly; apim-tokens; fo-tokens; mo-cost\", \"APIMAbnormalRequestVolume; FoundryTokenCostSpike; OpenAITokenCostSpike; AgentCostAnomalyByDimension\", \"Missing or streaming token usage can undercount cost; request volume is only a cost proxy\",\n  27, \"R27\", \"Runtime\", \"Denial of Service\", \"Flooding, quota exhaustion, timeouts, or resource starvation\", \"Availability impact\", \"LLM10\", \"AML.T0029\", \"COVERED\", \"apim-availability-pressure; apim-high-failure; apim-latency-anomaly; apim-api-enumeration; st-err\", \"APIMAvailabilityPressure; APIMHighFailureRate; APIMApiEnumeration; FoundryToolErrorStorm; CopilotStudioConnectorErrorStorm; CopilotRedTeamPacingAnomaly\", \"Errors, latency, and 429s can be working controls or operational faults rather than attacks\",\n  28, \"R28\", \"Memory & State\", \"Memory Poisoning\", \"Malicious content written to or recalled from persistent memory\", \"Persistence between interactions\", \"LLM04 / LLM07\", \"AML.T0018\", \"COVERED\", \"dl-content; dl-drift\", \"FoundryAgentMemoryPoisoning; AgentMemoryOperations\", \"Memory semantic conventions are evolving and may be absent\",\n  29, \"R29\", \"Memory & State\", \"State Manipulation\", \"Session, workflow, identity, or authorization state is altered\", \"Persistence or privilege abuse\", \"LLM04 / LLM06\", \"AML.T0018\", \"PARTIAL\", \"iv-feed; dl-lateral; ah-risk\", \"FoundrySessionContextContamination; CopilotStudioSessionContextContamination\", \"No universal state-change schema across platforms\",\n  30, \"R30\", \"Supply Chain\", \"AI Package Hallucination\", \"Model recommends a nonexistent or attacker-controlled package\", \"Structural compromise\", \"LLM03\", \"AML.T0010\", \"CONDITIONAL\", \"Evidence contract only; no live panel\", \"Defender package execution plus registry/SBOM validation required\", \"Install commands are endpoint evidence only; proving hallucination requires correlation to model output and authoritative package provenance\"\n]\n| project RiskId, ThreatDomain, Risk, Examples, DominantConsequence, OWASP, MITREAtlas, Coverage, WorkbookEvidence, DetectionEvidence, Limitation, Order\n| order by Order asc\n| project-away Order",
              "size": 0,
              "title": "Thirty-risk coverage, evidence, and limitations",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Coverage",
                    "formatter": 0
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "tm-catalog"
          },
          {
            "type": 1,
            "content": {
              "json": "### Evidence contracts for six conditional or partial risks\n\nThe table documents the telemetry needed to investigate R6, R7, R13, R23, R24, and R30. Only R6/R7 have a live workbook hunt because their APIM request source is selectable and validated. R13, R23, R24, and R30 remain documented evidence contracts until their Search diagnostics, Foundry evaluation exports, or package-provenance correlation are onboarded into a stable queryable source. Do not treat required enablement as observed evidence.",
              "style": "warning"
            },
            "name": "tm-gap-closure-h"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "datatable(Order:int, RiskId:string, Risk:string, Coverage:string, AvailableSignal:string, RequiredEnablement:string, ProofBoundary:string)\n[\n  1, \"R6\", \"Training Data Extraction\", \"PARTIAL\", \"Captured prompts requesting memorized, verbatim, corpus, or training examples\", \"APIM request-body logging or protected agent content\", \"Intent is observable; successful extraction needs output validation against protected/reference data\",\n  2, \"R7\", \"Model Inversion\", \"PARTIAL\", \"Membership-inference, private-attribute inference, reconstruction, confidence, or logits probing\", \"Captured prompt telemetry and stable caller/session IDs\", \"Probing is observable; inversion success needs ground truth or model-internal sensitivity evidence\",\n  3, \"R13\", \"Vector Database Poisoning\", \"OBSERVABLE\", \"Azure AI Search Indexing.Index operations, index name, document count, status, and duration\", \"Search OperationLogs diagnostic setting to the Sentinel workspace\", \"Mutation is observable; Search logs omit caller identity and document content integrity\",\n  4, \"R23\", \"Hallucination\", \"CONDITIONAL\", \"Groundedness, Groundedness Pro, relevance, response completeness, and retrieval evaluation results\", \"Foundry recurring/continuous evaluation over traces with query, response, and context\", \"Evaluator scores sampled responses and can be imperfect; human/domain truth remains authoritative\",\n  5, \"R24\", \"Adversarial Hallucination\", \"CONDITIONAL\", \"Red-team attack success plus groundedness or custom adversarial factuality evaluation\", \"Foundry scheduled red-team scans and evaluator results\", \"Test findings do not prove the same failure occurred in production without trace correlation\",\n  6, \"R30\", \"AI Package Hallucination\", \"CONDITIONAL\", \"Package-manager process commands and installed-software evidence\", \"Defender for Endpoint plus package registry, lockfile, SBOM, or approved-package provenance\", \"An install is not proof of an AI recommendation or nonexistent package without cross-source correlation\"\n]\n| order by Order asc\n| project-away Order",
              "size": 0,
              "title": "Evidence contracts for R6, R7, R13, R23, R24, and R30",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Coverage",
                    "formatter": 0
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "tm-gap-closure-map"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppRequests\n| extend RequestBody = tostring(Properties[\"Request-Body\"]), ResponseBody = tostring(Properties[\"Response-Body\"]), RequestJson = parse_json(tostring(Properties[\"Request-Body\"]))\n| where isnotempty(RequestBody)\n| extend Prompt = coalesce(tostring(RequestJson.input[0].content[0].text), tostring(RequestJson.messages[0].content), tostring(RequestJson.input), tostring(RequestJson.instructions)), Search = tolower(RequestBody)\n| extend RiskId = case(\n    Search matches regex @\"(training (data|dataset|corpus|example)|memorized (data|example|text|record)|reproduce.{0,40}(training|dataset|corpus)|recite.{0,40}(verbatim|exact)|verbatim.{0,40}(training|dataset|corpus)|canary (token|string))\", \"R6\",\n    Search matches regex @\"(membership inference|was.{0,60}in.{0,30}training|infer.{0,60}(private|sensitive|hidden).{0,30}(attribute|record|profile)|reconstruct.{0,60}(record|profile|sample|image)|return.{0,40}(logits|confidence scores?|token probabilities))\", \"R7\",\n    \"\")\n| where isnotempty(RiskId)\n| extend Risk = iff(RiskId == \"R6\", \"Training Data Extraction\", \"Model Inversion\"), Caller = coalesce(UserAuthenticatedId, UserId, ClientIP, \"unknown\"), APIName = coalesce(tostring(Properties[\"API Name\"]), Name), Model = tostring(RequestJson.model), Outcome = iff(Success == true or toint(ResultCode) between (200 .. 299), \"ALLOWED / REVIEW\", \"BLOCKED / FAILED\")\n| where \"{AgentSearch}\" == \"\" or APIName has \"{AgentSearch}\" or Model has \"{AgentSearch}\" or Caller has \"{AgentSearch}\"\n| project TimeGenerated, RiskId, Risk, Evidence = \"HEURISTIC ATTEMPT\", Outcome, Caller, APIName, Model, Prompt, ResultCode, OperationId, DurationMs\n| order by TimeGenerated desc\n| take 250",
              "size": 0,
              "title": "Training-data extraction and model-inversion attempts",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "RiskId",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "Evidence",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "Outcome",
                    "formatter": 0
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{APIMWorkspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "tm-extraction-inversion",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "workspace"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "requests\n| extend RequestBody = tostring(customDimensions[\"Request-Body\"]), ResponseBody = tostring(customDimensions[\"Response-Body\"]), RequestJson = parse_json(tostring(customDimensions[\"Request-Body\"]))\n| where isnotempty(RequestBody)\n| extend Prompt = coalesce(tostring(RequestJson.input[0].content[0].text), tostring(RequestJson.messages[0].content), tostring(RequestJson.input), tostring(RequestJson.instructions)), Search = tolower(RequestBody)\n| extend RiskId = case(\n    Search matches regex @\"(training (data|dataset|corpus|example)|memorized (data|example|text|record)|reproduce.{0,40}(training|dataset|corpus)|recite.{0,40}(verbatim|exact)|verbatim.{0,40}(training|dataset|corpus)|canary (token|string))\", \"R6\",\n    Search matches regex @\"(membership inference|was.{0,60}in.{0,30}training|infer.{0,60}(private|sensitive|hidden).{0,30}(attribute|record|profile)|reconstruct.{0,60}(record|profile|sample|image)|return.{0,40}(logits|confidence scores?|token probabilities))\", \"R7\",\n    \"\")\n| where isnotempty(RiskId)\n| extend Risk = iff(RiskId == \"R6\", \"Training Data Extraction\", \"Model Inversion\"), Caller = coalesce(user_AuthenticatedId, user_Id, client_IP, \"unknown\"), APIName = coalesce(tostring(customDimensions[\"API Name\"]), name), Model = tostring(RequestJson.model), Outcome = iff(success == true or toint(resultCode) between (200 .. 299), \"ALLOWED / REVIEW\", \"BLOCKED / FAILED\")\n| where \"{AgentSearch}\" == \"\" or APIName has \"{AgentSearch}\" or Model has \"{AgentSearch}\" or Caller has \"{AgentSearch}\"\n| project timestamp, RiskId, Risk, Evidence = \"HEURISTIC ATTEMPT\", Outcome, Caller, APIName, Model, Prompt, resultCode, operation_Id, duration\n| order by timestamp desc\n| take 250",
              "size": 0,
              "title": "Training-data extraction and model-inversion attempts",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "RiskId",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "Evidence",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "Outcome",
                    "formatter": 0
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{APIMApplicationInsights}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "tm-extraction-inversion-appinsights",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "applicationInsights"
            }
          },
          {
            "type": 1,
            "content": {
              "json": "### Detection parity by platform\n\nThis table names the scheduled rule, hunt, or telemetry limitation for every risk across **Foundry**, **Copilot Studio**, and **Microsoft 365 Copilot**. **RULE** is deployable scheduled analytics, **OBSERVABLE** is a related but incomplete signal, **HUNT / SCHEMA-DEPENDENT** requires analyst execution and tenant schema validation, and **UNSUPPORTED** means that platform does not emit evidence sufficient for the claim."
            },
            "name": "tm-platform-parity-desc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "datatable(Order:int, RiskId:string, Risk:string, Foundry:string, CopilotStudio:string, M365Copilot:string, TelemetryLimit:string)\n[\n  1, \"R1\", \"Prompt Injection\", \"RULE: FoundryPromptInjectionPatterns\", \"RULE: CopilotStudioPromptInjectionPatterns\", \"RULE: CopilotPromptInjectionPatterns\", \"Lexical matches require analyst validation\",\n  2, \"R2\", \"Indirect Prompt Injection\", \"RULE: FoundryGuardrailJailbreakDetected\", \"RULE: CopilotStudioIndirectPromptInjectionInResponse\", \"RULE: CopilotIndirectPromptInjection\", \"Source attribution requires retrieval or XPIA metadata\",\n  3, \"R3\", \"Jailbreaking\", \"RULE: FoundryGuardrailJailbreakDetected\", \"RULE: CopilotStudioJailbreakOrModelProbing\", \"RULE: CopilotJailbreakAttemptDetection\", \"A classifier or phrase hit does not prove bypass\",\n  4, \"R4\", \"Sensitive Information Disclosure\", \"RULE: FoundrySensitiveDataInOutput\", \"RULE: CopilotStudioSensitiveDataInResponse\", \"RULE: CopilotSensitiveDataExposure\", \"Content or DLP telemetry must be enabled\",\n  5, \"R5\", \"Data Exfiltration\", \"RULE: FoundryBulkDataExfiltrationIntent\", \"RULE: CopilotStudioBulkDataExfiltrationIntent\", \"RULE: CopilotExfiltrationPattern\", \"Intent and sensitive output do not always prove transfer\",\n  6, \"R6\", \"Training Data Extraction\", \"UNSUPPORTED\", \"UNSUPPORTED\", \"UNSUPPORTED\", \"Requires provider or model evaluation evidence\",\n  7, \"R7\", \"Model Inversion\", \"UNSUPPORTED\", \"UNSUPPORTED\", \"UNSUPPORTED\", \"Requires repeated-query evaluation and reference truth\",\n  8, \"R8\", \"Supply Chain Attack\", \"RULE: FoundryMcpToolDescriptionChange\", \"RULE: CopilotStudioNewConnectorFirstSeen\", \"RULE: CopilotPluginLifecycleAnomaly\", \"Provenance and signing remain external controls\",\n  9, \"R9\", \"Tool / Plugin Poisoning\", \"RULE: FoundryMcpCrossServerOverride\", \"RULE: CopilotStudioMcpExploitExecutionChain\", \"OBSERVABLE: CopilotPluginLifecycleAnomaly\", \"M365 does not emit tool descriptions or results\",\n  10, \"R10\", \"Model Poisoning\", \"RULE: FoundryNewModelFirstSeen\", \"RULE: CopilotStudioNewModelFirstSeen\", \"OBSERVABLE: CopilotSystemPromptOverride\", \"Model drift is not proof of poisoned weights\",\n  11, \"R11\", \"Data Poisoning\", \"HUNT: RagSourcePoisoningWrites\", \"OBSERVABLE: CopilotStudioSessionContextContamination\", \"RULE: CopilotRagUntrustedSource\", \"No universal source-integrity or lineage proof\",\n  12, \"R12\", \"RAG Poisoning\", \"RULE: FoundryUntrustedToolSource\", \"RULE: CopilotStudioSessionContextContamination\", \"RULE: CopilotRagUntrustedSource\", \"Often inferred from source and context behavior\",\n  13, \"R13\", \"Vector Database Poisoning\", \"UNSUPPORTED\", \"UNSUPPORTED\", \"UNSUPPORTED\", \"Requires vector-store mutation and retrieval-score telemetry\",\n  14, \"R14\", \"Insecure Output Handling\", \"RULE: FoundryUnsafeActiveContentInOutput\", \"RULE: CopilotStudioUnsafeActiveContentInResponse\", \"RULE: CopilotUnsafeActiveContentInResponse\", \"Output telemetry cannot prove downstream execution\",\n  15, \"R15\", \"SSRF\", \"RULE: FoundryInternalNetworkTargetToolCall\", \"RULE: CopilotStudioInternalNetworkTargetCall\", \"UNSUPPORTED\", \"M365 does not emit connector targets or tool arguments\",\n  16, \"R16\", \"Sandbox Escape\", \"UNSUPPORTED\", \"UNSUPPORTED\", \"UNSUPPORTED\", \"Requires endpoint container browser or process-boundary telemetry\",\n  17, \"R17\", \"Excessive Agency\", \"RULE: FoundryExcessiveToolChaining\", \"RULE: CopilotStudioExcessiveToolAgency\", \"OBSERVABLE: CopilotTraceLevelAnomaly\", \"M365 exposes interaction cardinality rather than per-tool execution\",\n  18, \"R18\", \"Unauthorized Tool Invocation\", \"RULE: FoundryMcpUnapprovedServerExecution\", \"RULE: CopilotStudioUntrustedMcpTarget\", \"OBSERVABLE: CopilotAccessDriftDetection\", \"M365 lacks runtime tool allowlist enforcement evidence\",\n  19, \"R19\", \"Function Call Manipulation\", \"RULE: FoundryMcpExploitIntentExecutionChain\", \"RULE: CopilotStudioMcpExploitExecutionChain\", \"UNSUPPORTED\", \"M365 does not expose tool arguments or results\",\n  20, \"R20\", \"Confused Deputy\", \"RULE: FoundryInterAgentPermissionMismatch\", \"RULE: CopilotStudioInterAgentPermissionMismatch\", \"UNSUPPORTED\", \"M365 lacks effective inter-agent authorization telemetry\",\n  21, \"R21\", \"Context Leakage\", \"RULE: FoundrySessionContextContamination\", \"RULE: CopilotStudioSessionContextContamination\", \"HUNT / SCHEMA-DEPENDENT: CopilotCrossTenantGuestLeak\", \"Stable tenant session and participant identifiers are required\",\n  22, \"R22\", \"System Prompt Leakage\", \"RULE: FoundrySystemPromptDisclosure\", \"RULE: CopilotStudioSystemPromptDisclosure\", \"RULE: CopilotSystemPromptDisclosure\", \"Prompt and response content is sensitive and optional\",\n  23, \"R23\", \"Hallucination\", \"UNSUPPORTED\", \"UNSUPPORTED\", \"UNSUPPORTED\", \"Requires groundedness scores citations reference truth or labels\",\n  24, \"R24\", \"Adversarial Hallucination\", \"UNSUPPORTED\", \"UNSUPPORTED\", \"UNSUPPORTED\", \"Attack intent is not proof of a false model claim\",\n  25, \"R25\", \"Agent Looping\", \"RULE: FoundryExcessiveToolChaining\", \"RULE: CopilotStudioExcessiveToolAgency\", \"RULE: CopilotTraceLevelAnomaly\", \"Thresholds require workload-specific tuning\",\n  26, \"R26\", \"Cost Amplification Attack\", \"RULE: FoundryTokenCostSpike\", \"OBSERVABLE: CopilotStudioConversationFloodingDoW\", \"OBSERVABLE: CopilotTokenCostSpike\", \"Studio and M365 may use activity proxies when token counts are absent\",\n  27, \"R27\", \"Denial of Service\", \"RULE: FoundryToolErrorStorm\", \"RULE: CopilotStudioConnectorErrorStorm\", \"RULE: CopilotRedTeamPacingAnomaly; CopilotTraceLevelAnomaly\", \"Errors and throttles can be working controls or operational faults\",\n  28, \"R28\", \"Memory Poisoning\", \"RULE: FoundryAgentMemoryPoisoning\", \"UNSUPPORTED\", \"HUNT / SCHEMA-DEPENDENT: CopilotMemoryContextPoisoning\", \"Persistent-memory telemetry is not universally emitted\",\n  29, \"R29\", \"State Manipulation\", \"RULE: FoundrySessionContextContamination\", \"RULE: CopilotStudioSessionContextContamination\", \"OBSERVABLE: CopilotSystemPromptOverride\", \"No universal state-change schema exists across platforms\",\n  30, \"R30\", \"AI Package Hallucination\", \"UNSUPPORTED\", \"UNSUPPORTED\", \"UNSUPPORTED\", \"Requires package resolution provenance and install correlation\"\n]\n| order by Order asc\n| project RiskId, Risk, Foundry, CopilotStudio, M365Copilot, TelemetryLimit",
              "size": 0,
              "title": "Thirty-risk detection parity across agent platforms",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "tm-platform-parity"
          },
          {
            "type": 1,
            "content": {
              "json": "### Defense zones and control families\n\nThe control map shows the expected defense at each architectural zone. Family codes: **IDN** identity, **GTW** gateway, **PRM** prompt/model guardrails, **DAT** data protection, **RUN** runtime enforcement, **MCP** model-context/tool governance, **API** API security, **OBS** observability, **OPS** resilience/operations, **GOV** governance, and **ARCH** architecture."
            },
            "name": "tm-controls-desc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "datatable(Order:int, Zone:string, ExpectedDefense:string, ControlFamilies:string, WorkbookVisibility:string)\n[\n  1, \"Input\", \"Authentication, classification, schema validation, prompt security, DLP, size and rate limits\", \"IDN, GTW, PRM, DAT, RUN\", \"APIM payload/security; M365 Copilot; Foundry/Copilot input hunts\",\n  2, \"Core agent\", \"Policy engine, allowlists, contextual authorization, limits, loop detection, and kill switch\", \"MCP, IDN, RUN\", \"Agent inventory; MCP allowlists; tool chains; excessive agency\",\n  3, \"Memory & RAG\", \"Tenant isolation, source provenance, anti-injection, DLP, TTL, and traceability\", \"DAT, MCP, PRM, OBS\", \"RAG sources; memory operations; context contamination; access drift\",\n  4, \"Tools & APIs\", \"Workload identity, exact schemas, tool lifecycle, SSRF/egress controls, and mTLS\", \"MCP, IDN, GTW, RUN, API\", \"MCP inventory/execution; external targets; APIM; connector telemetry\",\n  5, \"Runtime\", \"Quotas, circuit breakers, timeouts, concurrency, availability, and fallback\", \"GTW, RUN, OPS\", \"429/5xx; token/cost; latency; loops; error storms\",\n  6, \"Output\", \"DLP, output allowlists, structural validation, and active-content neutralization\", \"DAT, PRM, GTW\", \"Response bodies; sensitive output; content safety; disclosure hunts\",\n  7, \"Cross-cutting\", \"Catalog, audit, intelligence, versions, evidence, and governance\", \"GOV, OBS, OPS, ARCH\", \"Telemetry health; detections; incidents; inventory; governance; risk score\"\n]\n| order by Order asc\n| project-away Order",
              "size": 0,
              "title": "Defense zones and control-family mapping",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "tm-controls"
          },
          {
            "type": 1,
            "content": {
              "json": "### Runtime verdict evidence\n\nThis feed evaluates observed events in the main Sentinel workspace only. APIM resources selected through the independent APIM scope have their own verdict panel on the APIM tab. A missing row means no matching evidence was observed or the required telemetry was not collected; it is never an automatic PASS.",
              "style": "warning"
            },
            "name": "tm-verdict-desc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let ProtectedToolContent = union isfuzzy=true\n(datatable(OperationId:string, SpanId:string, ProtectedArgs:string, ProtectedResult:string)[]),\n(AppGenAIContent\n| project OperationId = TraceId, SpanId, ProtectedArgs = tostring(ToolCallArguments), ProtectedResult = tostring(ToolCallResult));\nlet VerdictEvidence = union isfuzzy=true\n(datatable(TimeGenerated:datetime, RiskId:string, Risk:string, Verdict:string, EvidenceSource:string, Entity:string, Result:string, Detail:string)[]),\n(AppRequests\n| where SDKVersion startswith \"apim:\" or tostring(Properties[\"Service Type\"]) =~ \"API Management\"\n| extend RequestBody = tostring(Properties[\"Request-Body\"]), ResponseBody = tostring(Properties[\"Response-Body\"]), ResponseJson = parse_json(tostring(Properties[\"Response-Body\"]))\n| extend PolicyMessage = coalesce(tostring(ResponseJson.message), ResponseBody), Search = tolower(RequestBody), ResponseSearch = tolower(ResponseBody), Entity = coalesce(UserAuthenticatedId, UserId, ClientIP, \"unknown\"), IsSuccess = Success == true or toint(ResultCode) between (200 .. 299)\n| extend HasInjection = Search matches regex @\"(?i)(ignore (all|previous|above).{0,40}instruction|disregard.{0,40}instruction|system prompt|developer mode|jailbreak|do anything now|you are now|olvida.{0,40}instrucci)\", AskedForPrompt = Search has_any (\"system prompt\", \"developer message\", \"hidden instructions\", \"initial instructions\", \"reveal your prompt\", \"repeat the words above\", \"show me your prompt\", \"print your system\", \"everything above this line\", \"verbatim instructions\"), LeakMarker = ResponseSearch has_any (\"you are an\", \"your role is\", \"# system\", \"system prompt\", \"you must never\", \"do not reveal\", \"your instructions are\", \"you have access to the following tools\", \"your available tools\", \"you should always\", \"never disclose\"), ActiveContent = ResponseBody matches regex @\"(?i)(<script(?:s|>)|javascripts*:|datas*:s*text/html|<iframe(?:s|>)|<object(?:s|>)|<embed(?:s|>)|on(?:error|load|click)s*=|document.cookie|window.locations*=)\"\n| extend HasPromptDisclosure = IsSuccess and AskedForPrompt and LeakMarker\n| where (ResultCode == \"403\" and PolicyMessage has \"content safety\") or ResultCode == \"429\" or HasPromptDisclosure or (IsSuccess and ActiveContent) or (IsSuccess and HasInjection) or toint(ResultCode) >= 500 or HasInjection\n| extend RiskId = case(ResultCode == \"429\" or toint(ResultCode) >= 500, \"R27\", HasPromptDisclosure, \"R22\", IsSuccess and ActiveContent, \"R14\", \"R1\"), Risk = case(RiskId == \"R27\", \"Denial of Service\", RiskId == \"R22\", \"System Prompt Leakage\", RiskId == \"R14\", \"Insecure Output Handling\", \"Prompt Injection\"), Verdict = case(ResultCode == \"403\" and PolicyMessage has \"content safety\", \"PASS\", ResultCode == \"429\", \"PASS\", HasPromptDisclosure, \"FAIL\", IsSuccess and ActiveContent, \"INCONCLUSIVE\", IsSuccess and HasInjection, \"FAIL\", toint(ResultCode) >= 500, \"ERROR\", \"INCONCLUSIVE\"), EvidenceSource = \"APIM AppRequests\", Result = ResultCode, Detail = case(ResultCode == \"403\" and PolicyMessage has \"content safety\", \"Content-safety rejection confirmed\", ResultCode == \"429\", \"Rate/token limit rejection confirmed\", HasPromptDisclosure, \"Prompt-disclosure markers returned successfully\", IsSuccess and ActiveContent, \"Active content returned; downstream execution unknown\", Verdict == \"FAIL\", \"Injection-pattern payload was allowed\", Verdict == \"ERROR\", \"Gateway/backend operational failure\", \"Suspicious payload failed without attributable control evidence\")\n| project TimeGenerated, RiskId, Risk, Verdict, EvidenceSource, Entity, Result, Detail),\n(AppDependencies\n| where isnotempty(tostring(Properties[\"microsoft.foundry.content_filter.results\"]))\n| extend Filter = tostring(Properties[\"microsoft.foundry.content_filter.results\"]), Entity = tostring(Properties[\"gen_ai.agent.name\"])\n| extend RiskId = case(Filter has \"indirect_attack\", \"R2\", Filter has_any (\"jailbreak\", \"prompt_shield\"), \"R3\", \"R4\"), Risk = case(RiskId == \"R2\", \"Indirect Prompt Injection\", RiskId == \"R3\", \"Jailbreaking\", \"Sensitive Information Disclosure\"), ExplicitBlock = Filter contains '\"blocked\":true' or Filter contains '\"blocked\": true' or Filter contains '\"filtered\":true' or Filter contains '\"filtered\": true'\n| extend Verdict = iff(ExplicitBlock, \"PASS\", \"INCONCLUSIVE\"), EvidenceSource = \"Foundry content filter\", Result = tostring(Success), Detail = iff(ExplicitBlock, \"Guardrail metadata reports blocked/filtered\", \"Guardrail hit recorded; enforcement outcome not explicit\")\n| project TimeGenerated, RiskId, Risk, Verdict, EvidenceSource, Entity, Result, Detail),\n(AppDependencies\n| where Success == true and isnotempty(tostring(Properties[\"gen_ai.tool.name\"]))\n| extend Entity = tostring(Properties[\"gen_ai.agent.name\"]), ToolName = tostring(Properties[\"gen_ai.tool.name\"]), LegacyArgs = tostring(Properties[\"gen_ai.tool.call.arguments\"]), LegacyResult = tostring(Properties[\"gen_ai.tool.call.result\"]), SpanId = Id\n| join kind=leftouter ProtectedToolContent on OperationId, SpanId\n| extend ToolArgs = coalesce(ProtectedArgs, LegacyArgs), ToolResult = coalesce(ProtectedResult, LegacyResult)\n| extend TargetUrl = extract(@\"(?i)https?://[A-Za-z0-9.-:[]]+\", 0, strcat(ToolArgs, \" \", ToolResult))\n| where isnotempty(TargetUrl)\n| extend TargetHost = tolower(tostring(parse_url(TargetUrl)[\"Host\"]))\n| extend TargetClass = case(TargetHost in (\"localhost\", \"::1\", \"[::1]\") or TargetHost matches regex @\"^127.\", \"Loopback\", TargetHost matches regex @\"^169.254.\" or TargetHost in (\"metadata.google.internal\", \"metadata.azure.internal\"), \"Link-local or metadata service\", TargetHost matches regex @\"^10.\" or TargetHost matches regex @\"^192.168.\" or TargetHost matches regex @\"^172.(1[6-9]|2[0-9]|3[01]).\", \"RFC1918 private network\", \"Public\")\n| where TargetClass != \"Public\"\n| project TimeGenerated, RiskId = \"R15\", Risk = \"SSRF\", Verdict = \"INCONCLUSIVE\", EvidenceSource = \"Foundry successful tool span\", Entity, Result = \"Success=true\", Detail = strcat(\"Completed \", ToolName, \" span carried \", TargetClass, \" target \", TargetHost)),\n(CopilotActivity\n| where RecordType == \"CopilotInteraction\"\n| mv-expand Event = LLMEventData.Messages\n| where tobool(Event.JailbreakDetected) == true\n| project TimeGenerated, RiskId = \"R3\", Risk = \"Jailbreaking\", Verdict = \"INCONCLUSIVE\", EvidenceSource = \"M365 Copilot JailbreakDetected\", Entity = tostring(ActorName), Result = \"Detected\", Detail = \"Detection flag present; enforcement or downstream action is not explicit\"),\n(CopilotActivity\n| where RecordType == \"CopilotInteraction\"\n| mv-expand Event = LLMEventData.AccessedResources\n| where tobool(Event.XPIADetected) == true\n| project TimeGenerated, RiskId = \"R2\", Risk = \"Indirect Prompt Injection\", Verdict = \"INCONCLUSIVE\", EvidenceSource = \"M365 Copilot XPIADetected\", Entity = tostring(ActorName), Result = \"Detected\", Detail = \"XPIA flag present; model influence and action outcome require investigation\"),\n(AppEvents\n| where Name == \"BotMessageSend\"\n| extend Output = tostring(Properties[\"text\"])\n| where Output matches regex @\"(AKIA[0-9A-Z]{16}|BEGIN [A-Z ]*PRIVATE KEY|eyJ[A-Za-z0-9_-]{8,}.[A-Za-z0-9_-]{8,}.[A-Za-z0-9_-]{8,})\"\n| project TimeGenerated, RiskId = \"R4\", Risk = \"Sensitive Information Disclosure\", Verdict = \"FAIL\", EvidenceSource = \"Copilot Studio response\", Entity = tostring(UserId), Result = \"Sensitive marker emitted\", Detail = \"Agent response contains a secret-like value\"),\n(AppDependencies\n| where isnotempty(tostring(Properties[\"gen_ai.agent.name\"])) and Success == false\n| where toint(ResultCode) >= 500 or ResultCode has \"timeout\"\n| project TimeGenerated, RiskId = \"R27\", Risk = \"Denial of Service\", Verdict = \"ERROR\", EvidenceSource = \"Agent dependency\", Entity = tostring(Properties[\"gen_ai.agent.name\"]), Result = tostring(ResultCode), Detail = \"Operational failure; not evidence of an AI security bypass\");\nVerdictEvidence\n| summarize Value = count() by Verdict\n| extend Order = case(Verdict == \"PASS\", 1, Verdict == \"FAIL\", 2, Verdict == \"ERROR\", 3, 4), Metric = Verdict\n| project Order, Metric, Value\n| order by Order asc",
              "size": 3,
              "visualization": "tiles",
              "title": "Runtime verdicts in the selected period",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                }
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "tm-verdict-kpi"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let ProtectedToolContent = union isfuzzy=true\n(datatable(OperationId:string, SpanId:string, ProtectedArgs:string, ProtectedResult:string)[]),\n(AppGenAIContent\n| project OperationId = TraceId, SpanId, ProtectedArgs = tostring(ToolCallArguments), ProtectedResult = tostring(ToolCallResult));\nlet VerdictEvidence = union isfuzzy=true\n(datatable(TimeGenerated:datetime, RiskId:string, Risk:string, Verdict:string, EvidenceSource:string, Entity:string, Result:string, Detail:string)[]),\n(AppRequests\n| where SDKVersion startswith \"apim:\" or tostring(Properties[\"Service Type\"]) =~ \"API Management\"\n| extend RequestBody = tostring(Properties[\"Request-Body\"]), ResponseBody = tostring(Properties[\"Response-Body\"]), ResponseJson = parse_json(tostring(Properties[\"Response-Body\"]))\n| extend PolicyMessage = coalesce(tostring(ResponseJson.message), ResponseBody), Search = tolower(RequestBody), ResponseSearch = tolower(ResponseBody), Entity = coalesce(UserAuthenticatedId, UserId, ClientIP, \"unknown\"), IsSuccess = Success == true or toint(ResultCode) between (200 .. 299)\n| extend HasInjection = Search matches regex @\"(?i)(ignore (all|previous|above).{0,40}instruction|disregard.{0,40}instruction|system prompt|developer mode|jailbreak|do anything now|you are now|olvida.{0,40}instrucci)\", AskedForPrompt = Search has_any (\"system prompt\", \"developer message\", \"hidden instructions\", \"initial instructions\", \"reveal your prompt\", \"repeat the words above\", \"show me your prompt\", \"print your system\", \"everything above this line\", \"verbatim instructions\"), LeakMarker = ResponseSearch has_any (\"you are an\", \"your role is\", \"# system\", \"system prompt\", \"you must never\", \"do not reveal\", \"your instructions are\", \"you have access to the following tools\", \"your available tools\", \"you should always\", \"never disclose\"), ActiveContent = ResponseBody matches regex @\"(?i)(<script(?:s|>)|javascripts*:|datas*:s*text/html|<iframe(?:s|>)|<object(?:s|>)|<embed(?:s|>)|on(?:error|load|click)s*=|document.cookie|window.locations*=)\"\n| extend HasPromptDisclosure = IsSuccess and AskedForPrompt and LeakMarker\n| where (ResultCode == \"403\" and PolicyMessage has \"content safety\") or ResultCode == \"429\" or HasPromptDisclosure or (IsSuccess and ActiveContent) or (IsSuccess and HasInjection) or toint(ResultCode) >= 500 or HasInjection\n| extend RiskId = case(ResultCode == \"429\" or toint(ResultCode) >= 500, \"R27\", HasPromptDisclosure, \"R22\", IsSuccess and ActiveContent, \"R14\", \"R1\"), Risk = case(RiskId == \"R27\", \"Denial of Service\", RiskId == \"R22\", \"System Prompt Leakage\", RiskId == \"R14\", \"Insecure Output Handling\", \"Prompt Injection\"), Verdict = case(ResultCode == \"403\" and PolicyMessage has \"content safety\", \"PASS\", ResultCode == \"429\", \"PASS\", HasPromptDisclosure, \"FAIL\", IsSuccess and ActiveContent, \"INCONCLUSIVE\", IsSuccess and HasInjection, \"FAIL\", toint(ResultCode) >= 500, \"ERROR\", \"INCONCLUSIVE\"), EvidenceSource = \"APIM AppRequests\", Result = ResultCode, Detail = case(ResultCode == \"403\" and PolicyMessage has \"content safety\", \"Content-safety rejection confirmed\", ResultCode == \"429\", \"Rate/token limit rejection confirmed\", HasPromptDisclosure, \"Prompt-disclosure markers returned successfully\", IsSuccess and ActiveContent, \"Active content returned; downstream execution unknown\", Verdict == \"FAIL\", \"Injection-pattern payload was allowed\", Verdict == \"ERROR\", \"Gateway/backend operational failure\", \"Suspicious payload failed without attributable control evidence\")\n| project TimeGenerated, RiskId, Risk, Verdict, EvidenceSource, Entity, Result, Detail),\n(AppDependencies\n| where isnotempty(tostring(Properties[\"microsoft.foundry.content_filter.results\"]))\n| extend Filter = tostring(Properties[\"microsoft.foundry.content_filter.results\"]), Entity = tostring(Properties[\"gen_ai.agent.name\"])\n| extend RiskId = case(Filter has \"indirect_attack\", \"R2\", Filter has_any (\"jailbreak\", \"prompt_shield\"), \"R3\", \"R4\"), Risk = case(RiskId == \"R2\", \"Indirect Prompt Injection\", RiskId == \"R3\", \"Jailbreaking\", \"Sensitive Information Disclosure\"), ExplicitBlock = Filter contains '\"blocked\":true' or Filter contains '\"blocked\": true' or Filter contains '\"filtered\":true' or Filter contains '\"filtered\": true'\n| extend Verdict = iff(ExplicitBlock, \"PASS\", \"INCONCLUSIVE\"), EvidenceSource = \"Foundry content filter\", Result = tostring(Success), Detail = iff(ExplicitBlock, \"Guardrail metadata reports blocked/filtered\", \"Guardrail hit recorded; enforcement outcome not explicit\")\n| project TimeGenerated, RiskId, Risk, Verdict, EvidenceSource, Entity, Result, Detail),\n(AppDependencies\n| where Success == true and isnotempty(tostring(Properties[\"gen_ai.tool.name\"]))\n| extend Entity = tostring(Properties[\"gen_ai.agent.name\"]), ToolName = tostring(Properties[\"gen_ai.tool.name\"]), LegacyArgs = tostring(Properties[\"gen_ai.tool.call.arguments\"]), LegacyResult = tostring(Properties[\"gen_ai.tool.call.result\"]), SpanId = Id\n| join kind=leftouter ProtectedToolContent on OperationId, SpanId\n| extend ToolArgs = coalesce(ProtectedArgs, LegacyArgs), ToolResult = coalesce(ProtectedResult, LegacyResult)\n| extend TargetUrl = extract(@\"(?i)https?://[A-Za-z0-9.-:[]]+\", 0, strcat(ToolArgs, \" \", ToolResult))\n| where isnotempty(TargetUrl)\n| extend TargetHost = tolower(tostring(parse_url(TargetUrl)[\"Host\"]))\n| extend TargetClass = case(TargetHost in (\"localhost\", \"::1\", \"[::1]\") or TargetHost matches regex @\"^127.\", \"Loopback\", TargetHost matches regex @\"^169.254.\" or TargetHost in (\"metadata.google.internal\", \"metadata.azure.internal\"), \"Link-local or metadata service\", TargetHost matches regex @\"^10.\" or TargetHost matches regex @\"^192.168.\" or TargetHost matches regex @\"^172.(1[6-9]|2[0-9]|3[01]).\", \"RFC1918 private network\", \"Public\")\n| where TargetClass != \"Public\"\n| project TimeGenerated, RiskId = \"R15\", Risk = \"SSRF\", Verdict = \"INCONCLUSIVE\", EvidenceSource = \"Foundry successful tool span\", Entity, Result = \"Success=true\", Detail = strcat(\"Completed \", ToolName, \" span carried \", TargetClass, \" target \", TargetHost)),\n(CopilotActivity\n| where RecordType == \"CopilotInteraction\"\n| mv-expand Event = LLMEventData.Messages\n| where tobool(Event.JailbreakDetected) == true\n| project TimeGenerated, RiskId = \"R3\", Risk = \"Jailbreaking\", Verdict = \"INCONCLUSIVE\", EvidenceSource = \"M365 Copilot JailbreakDetected\", Entity = tostring(ActorName), Result = \"Detected\", Detail = \"Detection flag present; enforcement or downstream action is not explicit\"),\n(CopilotActivity\n| where RecordType == \"CopilotInteraction\"\n| mv-expand Event = LLMEventData.AccessedResources\n| where tobool(Event.XPIADetected) == true\n| project TimeGenerated, RiskId = \"R2\", Risk = \"Indirect Prompt Injection\", Verdict = \"INCONCLUSIVE\", EvidenceSource = \"M365 Copilot XPIADetected\", Entity = tostring(ActorName), Result = \"Detected\", Detail = \"XPIA flag present; model influence and action outcome require investigation\"),\n(AppEvents\n| where Name == \"BotMessageSend\"\n| extend Output = tostring(Properties[\"text\"])\n| where Output matches regex @\"(AKIA[0-9A-Z]{16}|BEGIN [A-Z ]*PRIVATE KEY|eyJ[A-Za-z0-9_-]{8,}.[A-Za-z0-9_-]{8,}.[A-Za-z0-9_-]{8,})\"\n| project TimeGenerated, RiskId = \"R4\", Risk = \"Sensitive Information Disclosure\", Verdict = \"FAIL\", EvidenceSource = \"Copilot Studio response\", Entity = tostring(UserId), Result = \"Sensitive marker emitted\", Detail = \"Agent response contains a secret-like value\"),\n(AppDependencies\n| where isnotempty(tostring(Properties[\"gen_ai.agent.name\"])) and Success == false\n| where toint(ResultCode) >= 500 or ResultCode has \"timeout\"\n| project TimeGenerated, RiskId = \"R27\", Risk = \"Denial of Service\", Verdict = \"ERROR\", EvidenceSource = \"Agent dependency\", Entity = tostring(Properties[\"gen_ai.agent.name\"]), Result = tostring(ResultCode), Detail = \"Operational failure; not evidence of an AI security bypass\");\nVerdictEvidence\n| where \"{AgentSearch}\" == \"\" or Entity has \"{AgentSearch}\" or Risk has \"{AgentSearch}\" or EvidenceSource has \"{AgentSearch}\"\n| order by TimeGenerated desc\n| take 300",
              "size": 0,
              "title": "PASS / FAIL / ERROR / INCONCLUSIVE evidence",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Verdict",
                    "formatter": 0
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "tm-verdict-events"
          }
        ]
      },
      "name": "group-soc"
    },
    {
      "type": 12,
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "safety"
      },
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## 🛡️ Cross-Platform Content Safety & Jailbreak Detection\n\nA consolidated investigation surface for Microsoft 365 Copilot, Microsoft Foundry, Copilot Studio, and APIM AI Gateway. Each platform emits different evidence: service detection flags, content-filter metadata, text heuristics, or gateway policy outcomes. Compare signals only after checking the evidence type and limitation matrix below.\n\n**How to read this tab:** use category counts to understand which controls fire, then compare trend, agent, and model concentration to distinguish a broad campaign from one noisy workload. Prompt Shields cover direct user-prompt attacks and indirect attacks embedded in grounding documents; harm categories and blocklists are separate controls. A hit can be audit-only, blocked, or allowed depending on policy thresholds, so verify the underlying verdict/action before declaring prevention or compromise.",
              "style": "info"
            },
            "name": "cs-h"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "datatable(Order:int, Platform:string, DirectJailbreak:string, IndirectInjection:string, ContentSafety:string, OutcomeEvidence:string, Confidence:string, Limitation:string)\n[\n  1, \"Microsoft 365 Copilot\", \"NATIVE: Messages[].JailbreakDetected\", \"NATIVE: AccessedResources[].XPIADetected\", \"Not emitted as a general content-safety verdict\", \"Detection flags only\", \"HIGH for detection; outcome INCONCLUSIVE\", \"Flags do not prove blocking, model influence, or downstream action\",\n  2, \"Microsoft Foundry\", \"HEURISTIC: recorded-input pattern plus guardrail metadata\", \"NATIVE/POLICY: indirect_attack or Prompt Shield metadata\", \"microsoft.foundry.content_filter.results\", \"blocked/filtered when explicitly emitted\", \"HIGH for explicit filter metadata; heuristic otherwise\", \"SDK/provider metadata can omit enforcement outcome\",\n  3, \"Copilot Studio\", \"HEURISTIC: BotMessageReceived text pattern\", \"No universal XPIA field\", \"No universal native verdict in current AppEvents schema\", \"No content-policy outcome\", \"HEURISTIC\", \"Requires Log sensitive properties; empty results are not a clean state\",\n  4, \"APIM AI Gateway\", \"HEURISTIC request-body pattern plus sanitized policy traces\", \"Not observable at gateway without backend metadata\", \"403 body evidence and AppTraces policy events\", \"PASS/FAIL/ERROR/INCONCLUSIVE in APIM verdict logic\", \"HIGH for explicit policy result; heuristic otherwise\", \"Uses independent APIM telemetry scope and can expose captured payloads\"\n]\n| order by Order asc\n| project-away Order",
              "size": 0,
              "title": "Jailbreak and content-safety evidence by platform",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-platform-map"
          },
          {
            "type": 1,
            "content": {
              "json": "### 🟦 Microsoft 365 Copilot — native jailbreak and XPIA flags\n\n`JailbreakDetected` identifies direct user-prompt attacks; `XPIADetected` identifies indirect instructions in accessed grounding resources. These are Microsoft detection flags, not proof that the content was blocked, followed by the model, or executed by a tool."
            },
            "name": "cs-m365-h"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "CopilotActivity\r\n| where RecordType == 'CopilotInteraction'\r\n| mv-expand m = LLMEventData.Messages\r\n| where tobool(m.JailbreakDetected) == true\r\n| where '{AgentSearch}' == '' or AgentName has '{AgentSearch}' or ActorName has '{AgentSearch}'\n| project TimeGenerated, ThreatLevel = '🔴 Jailbreak', AgentName, ActorName, ConversationId = tostring(LLMEventData.ConversationId), MessageId = tostring(m.Id)\r\n| order by TimeGenerated desc\r\n| take 100",
              "size": 0,
              "title": "M365 Copilot direct jailbreak detections",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "ThreatLevel",
                    "formatter": 0
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-m365-jailbreak"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "CopilotActivity\r\n| where RecordType == 'CopilotInteraction'\r\n| mv-expand r = LLMEventData.AccessedResources\r\n| where tobool(r.XPIADetected) == true\r\n| where '{AgentSearch}' == '' or AgentName has '{AgentSearch}' or ActorName has '{AgentSearch}'\n| project TimeGenerated, ThreatLevel = '🔴 XPIA', AgentName, ActorName, SiteUrl = tostring(r.SiteUrl), Action = tostring(r.Action), Type = tostring(r.Type)\r\n| order by TimeGenerated desc\r\n| take 100",
              "size": 0,
              "title": "M365 Copilot indirect prompt injection (XPIA)",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "ThreatLevel",
                    "formatter": 0
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-m365-xpia"
          },
          {
            "type": 1,
            "content": {
              "json": "### 🟪 Microsoft Foundry — content filters, Prompt Shield, and jailbreak evidence\n\nThese existing panels read `microsoft.foundry.content_filter.results` from agent spans. Explicit blocked/filtered fields are stronger evidence than lexical matches in recorded input; missing outcome metadata remains inconclusive."
            },
            "name": "cs-foundry-h"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let CF = AppDependencies | where isnotempty(tostring(Properties['microsoft.foundry.content_filter.results'])) | extend cf = tostring(Properties['microsoft.foundry.content_filter.results']);\r\nunion isfuzzy=true\r\n(CF | where cf has 'jailbreak' | summarize Value = count() | extend Metric = 'Jailbreak', Order = 1),\r\n(CF | where cf has 'prompt_shield' | summarize Value = count() | extend Metric = 'Prompt Shield', Order = 2),\r\n(CF | where cf has 'indirect_attack' | summarize Value = count() | extend Metric = 'Indirect injection', Order = 3),\r\n(CF | where cf has 'hate' | summarize Value = count() | extend Metric = 'Hate', Order = 4),\r\n(CF | where cf has 'sexual' | summarize Value = count() | extend Metric = 'Sexual', Order = 5),\r\n(CF | where cf has 'violence' | summarize Value = count() | extend Metric = 'Violence', Order = 6),\r\n(CF | where cf has 'self_harm' | summarize Value = count() | extend Metric = 'Self-harm', Order = 7),\r\n(CF | where cf has_any ('protected_material', 'custom_blocklists') | summarize Value = count() | extend Metric = 'Protected / blocklist', Order = 8)\r\n| project Order, Metric, Value\r\n| sort by Order asc",
              "size": 3,
              "visualization": "tiles",
              "title": "Foundry safety category counts",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                }
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-kpi"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppDependencies\r\n| where isnotempty(tostring(Properties['microsoft.foundry.content_filter.results']))\r\n| summarize Hits = count() by bin(TimeGenerated, 1h)",
              "size": 0,
              "visualization": "timechart",
              "title": "Foundry content-safety hits over time",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-trend"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppDependencies\r\n| where isnotempty(tostring(Properties['microsoft.foundry.content_filter.results']))\r\n| summarize Hits = count() by Agent = tostring(Properties['gen_ai.agent.name'])\r\n| top 15 by Hits desc",
              "size": 1,
              "visualization": "barchart",
              "title": "Foundry agents with the most safety hits",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-agents"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppDependencies\r\n| where isnotempty(tostring(Properties['microsoft.foundry.content_filter.results']))\r\n| summarize Hits = count() by Model = tostring(Properties['gen_ai.request.model'])\r\n| top 15 by Hits desc",
              "size": 1,
              "visualization": "barchart",
              "title": "Foundry models with the most safety hits",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-models"
          },
          {
            "type": 1,
            "content": {
              "json": "### 🟨 Copilot Studio — heuristic jailbreak detection\n\nCopilot Studio `AppEvents` currently provides no universal native jailbreak or Prompt Shield verdict. This panel searches recorded inbound message text and therefore requires **Log sensitive properties**. Matches are investigation leads and may include quoted or approved test content.",
              "style": "warning"
            },
            "name": "cs-studio-h"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppEvents\r\n| where Name == 'BotMessageReceived'\r\n| extend msg = tostring(Properties['text'])\r\n| where isnotempty(msg)\r\n| where msg matches regex @'(?i)(ignore (all|previous|above)|disregard .*instruction|system prompt|developer mode|jailbreak|do anything now|reveal your (instructions|prompt))'\r\n| project TimeGenerated, ThreatLevel = '🟠 Injection marker', BotId = UserId, Channel = tostring(Properties['channelId']), Conversation = tostring(Properties['conversationId']), Snippet = substring(msg, 0, 200)\r\n| order by TimeGenerated desc\r\n| take 100",
              "size": 0,
              "title": "Copilot Studio heuristic jailbreak / direct injection markers",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "ThreatLevel",
                    "formatter": 0
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-studio-jailbreak"
          },
          {
            "type": 1,
            "content": {
              "json": "### 🌐 APIM AI Gateway — AI Safety Control Center\n\nA dense English operational view inspired by the supplied dashboard: unified control events first, then calls, latency, failures, injection outcomes, policy traces, and blocked payload evidence. These panels use the global **APIM telemetry source** selector and query either the APIM Application Insights component or linked Log Analytics workspace. Sanitized `AppTraces` policy metadata and explicit `403` responses provide enforcement evidence; request-body patterns are heuristic. Blocked-request panels can display sensitive captured payloads, so restrict workbook access and exports.",
              "style": "warning"
            },
            "name": "cs-apim-h"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let PolicyEvents = AppTraces\n| where SDKVersion startswith \"apim:\"\n| extend Search = strcat(Message, \" \", tostring(Properties)), Action = tolower(coalesce(tostring(Properties[\"action\"]), tostring(Properties[\"outcome\"]), tostring(Properties[\"decision\"])))\n| where Search has_any (\"content safety\", \"prompt shield\", \"prompt injection\", \"jailbreak\", \"redact\", \"mask\", \"pii\")\n| summarize PolicyEvents = count(), ExplicitBlocks = countif(Action has_any (\"block\", \"deny\", \"reject\")), PiiOrRedactionEvents = countif(Search has_any (\"pii\", \"redact\", \"mask\"));\nlet InjectionRequests = AppRequests\n| where SDKVersion startswith \"apim:\" or tostring(Properties[\"Service Type\"]) =~ \"API Management\"\n| extend RequestBody = tostring(Properties[\"Request-Body\"])\n| extend Search = strcat(tostring(parse_json(RequestBody).input), \" \", RequestBody)\n| where Search matches regex @\"(?i)(ignore (all|any|the|previous|prior|above).{0,40}instruction|disregard.{0,40}instruction|system prompt|developer mode|jailbreak|do anything now|you are now|act as.{0,30}(admin|administrator|system)|olvida.{0,40}instrucci)\"\n| summarize InjectionAttempts = count(), AllowedForReview = countif(Success == true or toint(ResultCode) between (200 .. 299)), BlockedOrFailed = countif(Success == false and not(toint(ResultCode) between (200 .. 299)));\nPolicyEvents\n| extend JoinKey = 1\n| join kind=fullouter (InjectionRequests | extend JoinKey = 1) on JoinKey\n| project PolicyEvents = coalesce(PolicyEvents, 0), ExplicitBlocks = coalesce(ExplicitBlocks, 0), InjectionAttempts = coalesce(InjectionAttempts, 0), AllowedForReview = coalesce(AllowedForReview, 0), BlockedOrFailed = coalesce(BlockedOrFailed, 0), PiiOrRedactionEvents = coalesce(PiiOrRedactionEvents, 0)\n| mv-expand Metric = pack_array(\"Policy events\", \"Explicit policy blocks\", \"Injection attempts\", \"Allowed / review\", \"Blocked / failed\", \"Explicit PII policy events\"), Value = pack_array(PolicyEvents, ExplicitBlocks, InjectionAttempts, AllowedForReview, BlockedOrFailed, PiiOrRedactionEvents)\n| project Metric = tostring(Metric), Value = todouble(Value)",
              "size": 3,
              "visualization": "tiles",
              "title": "APIM AI safety summary",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                }
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{APIMWorkspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-apim-safety-kpis",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "workspace"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let PolicyEvents = traces\n| where sdkVersion startswith \"apim:\"\n| extend Search = strcat(message, \" \", tostring(customDimensions)), Action = tolower(coalesce(tostring(customDimensions[\"action\"]), tostring(customDimensions[\"outcome\"]), tostring(customDimensions[\"decision\"])))\n| where Search has_any (\"content safety\", \"prompt shield\", \"prompt injection\", \"jailbreak\", \"redact\", \"mask\", \"pii\")\n| summarize PolicyEvents = count(), ExplicitBlocks = countif(Action has_any (\"block\", \"deny\", \"reject\")), PiiOrRedactionEvents = countif(Search has_any (\"pii\", \"redact\", \"mask\"));\nlet InjectionRequests = requests\n| where sdkVersion startswith \"apim:\" or tostring(customDimensions[\"Service Type\"]) =~ \"API Management\"\n| extend RequestBody = tostring(customDimensions[\"Request-Body\"])\n| extend Search = strcat(tostring(parse_json(RequestBody).input), \" \", RequestBody)\n| where Search matches regex @\"(?i)(ignore (all|any|the|previous|prior|above).{0,40}instruction|disregard.{0,40}instruction|system prompt|developer mode|jailbreak|do anything now|you are now|act as.{0,30}(admin|administrator|system)|olvida.{0,40}instrucci)\"\n| summarize InjectionAttempts = count(), AllowedForReview = countif(success == true or toint(resultCode) between (200 .. 299)), BlockedOrFailed = countif(success == false and not(toint(resultCode) between (200 .. 299)));\nPolicyEvents\n| extend JoinKey = 1\n| join kind=fullouter (InjectionRequests | extend JoinKey = 1) on JoinKey\n| project PolicyEvents = coalesce(PolicyEvents, 0), ExplicitBlocks = coalesce(ExplicitBlocks, 0), InjectionAttempts = coalesce(InjectionAttempts, 0), AllowedForReview = coalesce(AllowedForReview, 0), BlockedOrFailed = coalesce(BlockedOrFailed, 0), PiiOrRedactionEvents = coalesce(PiiOrRedactionEvents, 0)\n| mv-expand Metric = pack_array(\"Policy events\", \"Explicit policy blocks\", \"Injection attempts\", \"Allowed / review\", \"Blocked / failed\", \"Explicit PII policy events\"), Value = pack_array(PolicyEvents, ExplicitBlocks, InjectionAttempts, AllowedForReview, BlockedOrFailed, PiiOrRedactionEvents)\n| project Metric = tostring(Metric), Value = todouble(Value)",
              "size": 3,
              "visualization": "tiles",
              "title": "APIM AI safety summary",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                }
              },
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{APIMApplicationInsights}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-apim-safety-kpis-appinsights",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "applicationInsights"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let PolicyEvents = AppTraces\n| where SDKVersion startswith \"apim:\"\n| extend Search = strcat(Message, \" \", tostring(Properties))\n| where Search has_any (\"content safety\", \"prompt shield\", \"prompt injection\", \"jailbreak\", \"redact\", \"mask\", \"pii\")\n| extend Category = coalesce(tostring(Properties[\"category\"]), tostring(Properties[\"Category\"]), tostring(Properties[\"content_safety_category\"]), \"Not emitted\"),\n    Severity = coalesce(toupper(tostring(Properties[\"severity\"])), toupper(tostring(Properties[\"Severity\"])), case(SeverityLevel >= 4, \"CRITICAL\", SeverityLevel == 3, \"HIGH\", SeverityLevel == 2, \"MEDIUM\", \"INFORMATIONAL\")),\n    Control = coalesce(tostring(Properties[\"control\"]), tostring(Properties[\"policy\"]), \"APIM policy trace\"),\n    Action = coalesce(toupper(tostring(Properties[\"action\"])), toupper(tostring(Properties[\"outcome\"])), toupper(tostring(Properties[\"decision\"])), \"OBSERVED\")\n| project TimeGenerated, OperationId, Layer = \"APIM policy\", Evidence = \"EXPLICIT POLICY TRACE\", Category, Severity, Control, Action, Detail = Message;\nlet InjectionRequests = AppRequests\n| where SDKVersion startswith \"apim:\" or tostring(Properties[\"Service Type\"]) =~ \"API Management\"\n| extend RequestBody = tostring(Properties[\"Request-Body\"]), ResponseBody = tostring(Properties[\"Response-Body\"])\n| extend Search = strcat(tostring(parse_json(RequestBody).input), \" \", RequestBody)\n| where Search matches regex @\"(?i)(ignore (all|any|the|previous|prior|above).{0,40}instruction|disregard.{0,40}instruction|system prompt|developer mode|jailbreak|do anything now|you are now|act as.{0,30}(admin|administrator|system)|olvida.{0,40}instrucci)\"\n| extend IsAllowed = Success == true or toint(ResultCode) between (200 .. 299)\n| project TimeGenerated, OperationId, Layer = \"APIM request\", Evidence = \"HEURISTIC CONTENT MATCH\", Category = \"Prompt injection / jailbreak\", Severity = iff(IsAllowed, \"HIGH\", \"MEDIUM\"), Control = \"Gateway response\", Action = iff(IsAllowed, \"ALLOWED / REVIEW\", \"BLOCKED / FAILED\"), Detail = strcat(\"HTTP \", ResultCode, \" - \", Name);\nunion PolicyEvents, InjectionRequests\n| order by TimeGenerated desc\n| take 250",
              "size": 0,
              "title": "Unified APIM safety control events",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Evidence",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "Severity",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "Action",
                    "formatter": 0
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{APIMWorkspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-apim-unified-events",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "workspace"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let PolicyEvents = traces\n| where sdkVersion startswith \"apim:\"\n| extend Search = strcat(message, \" \", tostring(customDimensions))\n| where Search has_any (\"content safety\", \"prompt shield\", \"prompt injection\", \"jailbreak\", \"redact\", \"mask\", \"pii\")\n| extend Category = coalesce(tostring(customDimensions[\"category\"]), tostring(customDimensions[\"Category\"]), tostring(customDimensions[\"content_safety_category\"]), \"Not emitted\"),\n    Severity = coalesce(toupper(tostring(customDimensions[\"severity\"])), toupper(tostring(customDimensions[\"Severity\"])), case(severityLevel >= 4, \"CRITICAL\", severityLevel == 3, \"HIGH\", severityLevel == 2, \"MEDIUM\", \"INFORMATIONAL\")),\n    Control = coalesce(tostring(customDimensions[\"control\"]), tostring(customDimensions[\"policy\"]), \"APIM policy trace\"),\n    Action = coalesce(toupper(tostring(customDimensions[\"action\"])), toupper(tostring(customDimensions[\"outcome\"])), toupper(tostring(customDimensions[\"decision\"])), \"OBSERVED\")\n| project timestamp, operation_Id, Layer = \"APIM policy\", Evidence = \"EXPLICIT POLICY TRACE\", Category, Severity, Control, Action, Detail = message;\nlet InjectionRequests = requests\n| where sdkVersion startswith \"apim:\" or tostring(customDimensions[\"Service Type\"]) =~ \"API Management\"\n| extend RequestBody = tostring(customDimensions[\"Request-Body\"]), ResponseBody = tostring(customDimensions[\"Response-Body\"])\n| extend Search = strcat(tostring(parse_json(RequestBody).input), \" \", RequestBody)\n| where Search matches regex @\"(?i)(ignore (all|any|the|previous|prior|above).{0,40}instruction|disregard.{0,40}instruction|system prompt|developer mode|jailbreak|do anything now|you are now|act as.{0,30}(admin|administrator|system)|olvida.{0,40}instrucci)\"\n| extend IsAllowed = success == true or toint(resultCode) between (200 .. 299)\n| project timestamp, operation_Id, Layer = \"APIM request\", Evidence = \"HEURISTIC CONTENT MATCH\", Category = \"Prompt injection / jailbreak\", Severity = iff(IsAllowed, \"HIGH\", \"MEDIUM\"), Control = \"Gateway response\", Action = iff(IsAllowed, \"ALLOWED / REVIEW\", \"BLOCKED / FAILED\"), Detail = strcat(\"HTTP \", resultCode, \" - \", name);\nunion PolicyEvents, InjectionRequests\n| order by timestamp desc\n| take 250",
              "size": 0,
              "title": "Unified APIM safety control events",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Evidence",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "Severity",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "Action",
                    "formatter": 0
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{APIMApplicationInsights}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-apim-unified-events-appinsights",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "applicationInsights"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true\n(AppRequests\n| where SDKVersion startswith \"apim:\" or tostring(Properties[\"Service Type\"]) =~ \"API Management\"\n| summarize Calls = count(), Failures = countif(Success == false), AvgMs = round(avg(DurationMs), 1), P95Ms = round(percentile(DurationMs, 95), 1)\n| extend Layer = \"Gateway request\"),\n(AppDependencies\n| where SDKVersion startswith \"apim:\"\n| summarize Calls = count(), Failures = countif(Success == false), AvgMs = round(avg(DurationMs), 1), P95Ms = round(percentile(DurationMs, 95), 1)\n| extend Layer = \"Backend dependency\"),\n(AppTraces\n| where SDKVersion startswith \"apim:\"\n| extend Search = strcat(Message, \" \", tostring(Properties))\n| where Search has_any (\"content safety\", \"prompt shield\", \"prompt injection\", \"jailbreak\", \"redact\", \"mask\", \"pii\")\n| summarize Calls = count(), Failures = countif(SeverityLevel >= 3), AvgMs = real(null), P95Ms = real(null)\n| extend Layer = \"Safety policy trace\")\n| extend FailurePct = iff(Calls == 0, 0.0, round(100.0 * Failures / Calls, 1))\n| project Layer, Calls, Failures, FailurePct, AvgMs, P95Ms\n| order by Layer asc",
              "size": 0,
              "title": "Calls, latency, and failures by APIM safety layer",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Requests",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  },
                  {
                    "columnMatch": "FailurePct",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  },
                  {
                    "columnMatch": "P95Ms",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "yellow"
                    }
                  },
                  {
                    "columnMatch": "P99Ms",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{APIMWorkspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-apim-layer-health",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "workspace"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true\n(requests\n| where sdkVersion startswith \"apim:\" or tostring(customDimensions[\"Service Type\"]) =~ \"API Management\"\n| summarize Calls = count(), Failures = countif(success == false), AvgMs = round(avg(duration), 1), P95Ms = round(percentile(duration, 95), 1)\n| extend Layer = \"Gateway request\"),\n(dependencies\n| where sdkVersion startswith \"apim:\"\n| summarize Calls = count(), Failures = countif(success == false), AvgMs = round(avg(duration), 1), P95Ms = round(percentile(duration, 95), 1)\n| extend Layer = \"Backend dependency\"),\n(traces\n| where sdkVersion startswith \"apim:\"\n| extend Search = strcat(message, \" \", tostring(customDimensions))\n| where Search has_any (\"content safety\", \"prompt shield\", \"prompt injection\", \"jailbreak\", \"redact\", \"mask\", \"pii\")\n| summarize Calls = count(), Failures = countif(severityLevel >= 3), AvgMs = real(null), P95Ms = real(null)\n| extend Layer = \"Safety policy trace\")\n| extend FailurePct = iff(Calls == 0, 0.0, round(100.0 * Failures / Calls, 1))\n| project Layer, Calls, Failures, FailurePct, AvgMs, P95Ms\n| order by Layer asc",
              "size": 0,
              "title": "Calls, latency, and failures by APIM safety layer",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Requests",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  },
                  {
                    "columnMatch": "FailurePct",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  },
                  {
                    "columnMatch": "P95Ms",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "yellow"
                    }
                  },
                  {
                    "columnMatch": "P99Ms",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{APIMApplicationInsights}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-apim-layer-health-appinsights",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "applicationInsights"
            }
          },
          {
            "type": 1,
            "content": {
              "json": "#### Content category and severity\n\nThese views use the APIM content-safety enforcement evidence emitted as `AppExceptions` where `ExceptionType == 'ContentSafetyPolicyViolated'`. Category, severity, threshold, and stage are parsed from the exception fields, then correlated to blocked `AppRequests` by `OperationId`. The detail grid exposes the blocked prompt for investigation; treat workbook access and exports as sensitive. Aggregates count policy violations, not unique users or attacks.",
              "style": "warning"
            },
            "name": "cs-apim-category-h"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let Blocks = AppExceptions\n| where ExceptionType == \"ContentSafetyPolicyViolated\" and OuterMessage has \"detected with severity\"\n| extend Category = extract(@\"violation:\\s+(\\w+)\\s+detected with severity\", 1, OuterMessage),\n    Severity = toint(extract(@\"severity\\s+(\\d+)\", 1, OuterMessage)),\n    Threshold = toint(extract(@\"threshold\\s+(\\d+)\", 1, OuterMessage)),\n    Stage = tostring(split(ProblemId, \" at \")[-1])\n| summarize arg_max(TimeGenerated, Category, Severity, Threshold, Stage) by OperationId;\nAppRequests\n| where ResultCode == \"403\"\n| extend RequestBody = tostring(Properties[\"Request-Body\"]), APIName = coalesce(tostring(Properties[\"API Name\"]), Name), RequestId = tostring(Properties[\"Request Id\"])\n| extend RequestJson = parse_json(RequestBody)\n| extend Prompt = coalesce(tostring(RequestJson.input[0].content[0].text), tostring(RequestJson.messages[0].content), tostring(RequestJson.input), tostring(RequestJson.instructions)), Model = tostring(RequestJson.model), Caller = coalesce(UserAuthenticatedId, UserId, ClientIP, \"unknown\")\n| join kind=inner Blocks on OperationId\n| where \"{AgentSearch}\" == \"\" or APIName has \"{AgentSearch}\" or Model has \"{AgentSearch}\" or Caller has \"{AgentSearch}\"\n| project TimeGenerated, BlockedBy = \"Content Safety\", Category, Severity, Threshold, Prompt, Stage, Model, APIName, Caller, DurationMs, RequestId, OperationId\n| order by Severity desc, TimeGenerated desc\n| take 250",
              "size": 0,
              "title": "Content-safety blocks — category, severity, and prompt",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "BlockedBy",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "Severity",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  },
                  {
                    "columnMatch": "Threshold",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "yellow"
                    }
                  },
                  {
                    "columnMatch": "DurationMs",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{APIMWorkspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-apim-content-safety-block-details",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "workspace"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let Blocks = exceptions\n| where type == \"ContentSafetyPolicyViolated\" and outerMessage has \"detected with severity\"\n| extend Category = extract(@\"violation:\\s+(\\w+)\\s+detected with severity\", 1, outerMessage),\n    Severity = toint(extract(@\"severity\\s+(\\d+)\", 1, outerMessage)),\n    Threshold = toint(extract(@\"threshold\\s+(\\d+)\", 1, outerMessage)),\n    Stage = tostring(split(problemId, \" at \")[-1])\n| summarize arg_max(timestamp, Category, Severity, Threshold, Stage) by operation_Id;\nrequests\n| where resultCode == \"403\"\n| extend RequestBody = tostring(customDimensions[\"Request-Body\"]), APIName = coalesce(tostring(customDimensions[\"API Name\"]), name), RequestId = tostring(customDimensions[\"Request Id\"])\n| extend RequestJson = parse_json(RequestBody)\n| extend Prompt = coalesce(tostring(RequestJson.input[0].content[0].text), tostring(RequestJson.messages[0].content), tostring(RequestJson.input), tostring(RequestJson.instructions)), Model = tostring(RequestJson.model), Caller = coalesce(user_AuthenticatedId, user_Id, client_IP, \"unknown\")\n| join kind=inner Blocks on operation_Id\n| where \"{AgentSearch}\" == \"\" or APIName has \"{AgentSearch}\" or Model has \"{AgentSearch}\" or Caller has \"{AgentSearch}\"\n| project timestamp, BlockedBy = \"Content Safety\", Category, Severity, Threshold, Prompt, Stage, Model, APIName, Caller, duration, RequestId, operation_Id\n| order by Severity desc, timestamp desc\n| take 250",
              "size": 0,
              "title": "Content-safety blocks — category, severity, and prompt",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "BlockedBy",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "Severity",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  },
                  {
                    "columnMatch": "Threshold",
                    "formatter": 4,
                    "formatOptions": {
