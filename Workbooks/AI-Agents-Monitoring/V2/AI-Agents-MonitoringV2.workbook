              "comparison": "isEqualTo",
              "value": "workspace"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "requests\n| where sdkVersion startswith \"apim:\" or tostring(customDimensions[\"Service Type\"]) =~ \"API Management\"\n| extend RequestBody = tostring(customDimensions[\"Request-Body\"]), ResponseBody = tostring(customDimensions[\"Response-Body\"]), RequestJson = parse_json(tostring(customDimensions[\"Request-Body\"])), ResponseJson = parse_json(tostring(customDimensions[\"Response-Body\"]))\n| extend PolicyMessage = coalesce(tostring(ResponseJson.message), ResponseBody), PolicyStatus = tostring(ResponseJson.statusCode)\n| where resultCode == \"403\" and PolicyMessage has \"content safety\"\n| extend Input = tostring(RequestJson.input), Instructions = tostring(RequestJson.instructions), Model = tostring(RequestJson.model), Tools = tostring(RequestJson.tools), Caller = coalesce(user_AuthenticatedId, user_Id, client_IP, \"unknown\"), RequestId = tostring(customDimensions[\"Request Id\"]), APIName = tostring(customDimensions[\"API Name\"]), ServiceName = tostring(customDimensions[\"Service Name\"]), Region = tostring(customDimensions[\"Region\"])\n| project timestamp, Signal = \"CONTENT SAFETY BLOCK\", Caller, resultCode, PolicyStatus, PolicyMessage, APIName, name, url, Model, Input, Instructions, Tools, RequestBody, ResponseBody, RequestId, operation_Id, duration, ServiceName, Region\n| order by timestamp desc\n| take 250",
              "size": 0,
