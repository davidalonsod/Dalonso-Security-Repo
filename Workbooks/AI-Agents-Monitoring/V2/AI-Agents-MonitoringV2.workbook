          {
            "type": 1,
            "content": {
              "json": "#### Prompt Shield and jailbreak outcomes\n\nTechnique labels are transparent lexical classifications of captured request bodies. The allowed-through table is intentionally high priority: a successful HTTP result after a heuristic match requires review, but it is not proof that the model followed the instruction.",
              "style": "warning"
            },
            "name": "cs-apim-injection-h"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppRequests\n| where SDKVersion startswith \"apim:\" or tostring(Properties[\"Service Type\"]) =~ \"API Management\"\n| extend RequestBody = tostring(Properties[\"Request-Body\"])\n| extend Search = tolower(strcat(tostring(parse_json(RequestBody).input), \" \", RequestBody))\n| extend Technique = case(Search matches regex @\"ignore (all|any|the|previous|prior|above).{0,40}instruction|disregard.{0,40}instruction|olvida.{0,40}instrucci\", \"Instruction override\", Search has_any (\"system prompt\", \"reveal your prompt\", \"hidden instructions\", \"developer message\"), \"Prompt extraction\", Search matches regex @\"act as.{0,30}(admin|administrator|system)|you are now\", \"Role / privilege override\", Search has_any (\"developer mode\", \"jailbreak\", \"do anything now\"), \"Jailbreak persona\", \"\")\n| where isnotempty(Technique)\n| extend Allowed = Success == true or toint(ResultCode) between (200 .. 299)\n| summarize Attempts = count(), AllowedForReview = countif(Allowed), BlockedOrFailed = countif(not(Allowed)), LastSeen = max(TimeGenerated) by Technique\n| extend AllowedPct = round(100.0 * AllowedForReview / Attempts, 1)\n| order by Attempts desc",
              "size": 0,
              "title": "Jailbreak and prompt-injection technique summary",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Attempts",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  },
                  {
                    "columnMatch": "AllowedForReview",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  },
                  {
                    "columnMatch": "AllowedPct",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{APIMWorkspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-apim-injection-techniques",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "workspace"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "requests\n| where sdkVersion startswith \"apim:\" or tostring(customDimensions[\"Service Type\"]) =~ \"API Management\"\n| extend RequestBody = tostring(customDimensions[\"Request-Body\"])\n| extend Search = tolower(strcat(tostring(parse_json(RequestBody).input), \" \", RequestBody))\n| extend Technique = case(Search matches regex @\"ignore (all|any|the|previous|prior|above).{0,40}instruction|disregard.{0,40}instruction|olvida.{0,40}instrucci\", \"Instruction override\", Search has_any (\"system prompt\", \"reveal your prompt\", \"hidden instructions\", \"developer message\"), \"Prompt extraction\", Search matches regex @\"act as.{0,30}(admin|administrator|system)|you are now\", \"Role / privilege override\", Search has_any (\"developer mode\", \"jailbreak\", \"do anything now\"), \"Jailbreak persona\", \"\")\n| where isnotempty(Technique)\n| extend Allowed = success == true or toint(resultCode) between (200 .. 299)\n| summarize Attempts = count(), AllowedForReview = countif(Allowed), BlockedOrFailed = countif(not(Allowed)), LastSeen = max(timestamp) by Technique\n| extend AllowedPct = round(100.0 * AllowedForReview / Attempts, 1)\n| order by Attempts desc",
              "size": 0,
              "title": "Jailbreak and prompt-injection technique summary",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Attempts",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  },
                  {
                    "columnMatch": "AllowedForReview",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  },
                  {
                    "columnMatch": "AllowedPct",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{APIMApplicationInsights}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-apim-injection-techniques-appinsights",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "applicationInsights"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppRequests\n| where SDKVersion startswith \"apim:\" or tostring(Properties[\"Service Type\"]) =~ \"API Management\"\n| extend RequestBody = tostring(Properties[\"Request-Body\"]), ResponseBody = tostring(Properties[\"Response-Body\"])\n| extend RequestJson = parse_json(RequestBody), Search = strcat(tostring(parse_json(RequestBody).input), \" \", RequestBody)\n| where Search matches regex @\"(?i)(ignore (all|any|the|previous|prior|above).{0,40}instruction|disregard.{0,40}instruction|system prompt|developer mode|jailbreak|do anything now|you are now|act as.{0,30}(admin|administrator|system)|olvida.{0,40}instrucci)\"\n| where Success == true or toint(ResultCode) between (200 .. 299)\n| extend Caller = coalesce(UserAuthenticatedId, UserId, ClientIP, \"unknown\"), Model = tostring(RequestJson.model), Input = tostring(RequestJson.input), APIName = tostring(Properties[\"API Name\"]), RequestId = tostring(Properties[\"Request Id\"])\n| project TimeGenerated, Verdict = \"FAIL / REVIEW\", Caller, ResultCode, APIName, Name, Model, Input, RequestBody, ResponseBody, RequestId, OperationId, DurationMs\n| order by TimeGenerated desc\n| take 250",
              "size": 0,
              "title": "Allowed-through injection attempts requiring review",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Verdict",
                    "formatter": 0
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{APIMWorkspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-apim-allowed-injection",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "workspace"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "requests\n| where sdkVersion startswith \"apim:\" or tostring(customDimensions[\"Service Type\"]) =~ \"API Management\"\n| extend RequestBody = tostring(customDimensions[\"Request-Body\"]), ResponseBody = tostring(customDimensions[\"Response-Body\"])\n| extend RequestJson = parse_json(RequestBody), Search = strcat(tostring(parse_json(RequestBody).input), \" \", RequestBody)\n| where Search matches regex @\"(?i)(ignore (all|any|the|previous|prior|above).{0,40}instruction|disregard.{0,40}instruction|system prompt|developer mode|jailbreak|do anything now|you are now|act as.{0,30}(admin|administrator|system)|olvida.{0,40}instrucci)\"\n| where success == true or toint(resultCode) between (200 .. 299)\n| extend Caller = coalesce(user_AuthenticatedId, user_Id, client_IP, \"unknown\"), Model = tostring(RequestJson.model), Input = tostring(RequestJson.input), APIName = tostring(customDimensions[\"API Name\"]), RequestId = tostring(customDimensions[\"Request Id\"])\n| project timestamp, Verdict = \"FAIL / REVIEW\", Caller, resultCode, APIName, name, Model, Input, RequestBody, ResponseBody, RequestId, operation_Id, duration\n| order by timestamp desc\n| take 250",
              "size": 0,
              "title": "Allowed-through injection attempts requiring review",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Verdict",
                    "formatter": 0
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{APIMApplicationInsights}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-apim-allowed-injection-appinsights",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "applicationInsights"
            }
          },
          {
            "type": 1,
            "content": {
              "json": "#### PII and output masking\n\nThe first two views report **observable masking evidence** from successful `AppRequests.Properties['Response-Body']` values containing runs of three or more asterisks. The percentage uses successful responses with a recorded body as its denominator, avoiding the misleading claim that every successful request was eligible for PII protection. Masking proves that output text changed; it does not identify the PII entity type or prove that every sensitive value was found. Use **Agent search** to scope results to APIs such as `invoice-agent`. The final view remains stricter and only reports explicit PII-policy metadata from `AppTraces`; it can legitimately be empty when the policy does not emit sanitized entity type, action, and mask counts.",
              "style": "warning"
            },
            "name": "cs-apim-pii-h"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppRequests\n| extend ResponseBody = tostring(Properties[\"Response-Body\"]), APIName = coalesce(tostring(Properties[\"API Name\"]), Name)\n| where Success == true or toint(ResultCode) between (200 .. 299)\n| where isnotempty(ResponseBody)\n| where \"{AgentSearch}\" == \"\" or APIName has \"{AgentSearch}\" or Name has \"{AgentSearch}\"\n| extend HasMask = ResponseBody contains \"***\", MaskedCharacters = strlen(ResponseBody) - strlen(replace_string(ResponseBody, \"*\", \"\"))\n| summarize SuccessfulResponseBodies = count(), MaskedResponses = countif(HasMask), MaskedCharacters = sumif(MaskedCharacters, HasMask)\n| extend MaskingRatePct = iff(SuccessfulResponseBodies == 0, 0.0, round(100.0 * MaskedResponses / SuccessfulResponseBodies, 1))\n| mv-expand Metric = pack_array(\"Successful response bodies\", \"Responses with masking\", \"Masked characters\", \"Response bodies masked (%)\"), Value = pack_array(SuccessfulResponseBodies, MaskedResponses, MaskedCharacters, MaskingRatePct), Order = pack_array(1, 2, 3, 4)\n| project Order = toint(Order), Metric = tostring(Metric), Value = todouble(Value)\n| order by Order asc\n| project-away Order",
              "size": 3,
              "visualization": "tiles",
              "title": "Output masking evidence from APIM responses",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                }
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{APIMWorkspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-apim-output-masking-kpis",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "workspace"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "requests\n| extend ResponseBody = tostring(customDimensions[\"Response-Body\"]), APIName = coalesce(tostring(customDimensions[\"API Name\"]), name)\n| where success == true or toint(resultCode) between (200 .. 299)\n| where isnotempty(ResponseBody)\n| where \"{AgentSearch}\" == \"\" or APIName has \"{AgentSearch}\" or name has \"{AgentSearch}\"\n| extend HasMask = ResponseBody contains \"***\", MaskedCharacters = strlen(ResponseBody) - strlen(replace_string(ResponseBody, \"*\", \"\"))\n| summarize SuccessfulResponseBodies = count(), MaskedResponses = countif(HasMask), MaskedCharacters = sumif(MaskedCharacters, HasMask)\n| extend MaskingRatePct = iff(SuccessfulResponseBodies == 0, 0.0, round(100.0 * MaskedResponses / SuccessfulResponseBodies, 1))\n| mv-expand Metric = pack_array(\"Successful response bodies\", \"Responses with masking\", \"Masked characters\", \"Response bodies masked (%)\"), Value = pack_array(SuccessfulResponseBodies, MaskedResponses, MaskedCharacters, MaskingRatePct), Order = pack_array(1, 2, 3, 4)\n| project Order = toint(Order), Metric = tostring(Metric), Value = todouble(Value)\n| order by Order asc\n| project-away Order",
              "size": 3,
              "visualization": "tiles",
              "title": "Output masking evidence from APIM responses",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                }
              },
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{APIMApplicationInsights}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-apim-output-masking-kpis-appinsights",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "applicationInsights"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppRequests\n| extend RequestBody = tostring(Properties[\"Request-Body\"]), ResponseBody = tostring(Properties[\"Response-Body\"]), APIName = coalesce(tostring(Properties[\"API Name\"]), Name), RequestId = tostring(Properties[\"Request Id\"])\n| where Success == true or toint(ResultCode) between (200 .. 299)\n| where ResponseBody contains \"***\"\n| where \"{AgentSearch}\" == \"\" or APIName has \"{AgentSearch}\" or Name has \"{AgentSearch}\"\n| extend RequestJson = parse_json(RequestBody), ResponseJson = parse_json(ResponseBody)\n| extend ResponseId = coalesce(tostring(ResponseJson.id), extract(@'\"id\"\\s*:\\s*\"(resp_[A-Za-z0-9_-]+)\"', 1, ResponseBody)),\n    Instructions = coalesce(tostring(ResponseJson.instructions), tostring(ResponseJson.input[0].content[0].text), tostring(ResponseJson.messages[0].content), tostring(RequestJson.instructions)),\n    OutputText = coalesce(tostring(ResponseJson.output[0].content[0].text), tostring(ResponseJson.output_text)),\n    Model = coalesce(tostring(ResponseJson.model), tostring(RequestJson.model)),\n    Caller = coalesce(UserAuthenticatedId, UserId, ClientIP, \"unknown\"),\n    MaskedCharacters = strlen(ResponseBody) - strlen(replace_string(ResponseBody, \"*\", \"\")),\n    MaskedRuns = array_length(extract_all(@'(\\*{3,})', ResponseBody))\n| extend MaskedExcerpt = substring(coalesce(Instructions, OutputText, ResponseBody), 0, 500)\n| project TimeGenerated, Evidence = \"MASKED OUTPUT OBSERVED\", APIName, Caller, ResponseId, Model, MaskedCharacters, MaskedRuns, MaskedExcerpt, ResultCode, RequestId, OperationId, DurationMs\n| order by TimeGenerated desc\n| take 250",
              "size": 0,
              "title": "Masked APIM response details",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Evidence",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "MaskedCharacters",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "green"
                    }
                  },
                  {
                    "columnMatch": "DurationMs",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{APIMWorkspace}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-apim-output-masking-details",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "workspace"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "requests\n| extend RequestBody = tostring(customDimensions[\"Request-Body\"]), ResponseBody = tostring(customDimensions[\"Response-Body\"]), APIName = coalesce(tostring(customDimensions[\"API Name\"]), name), RequestId = tostring(customDimensions[\"Request Id\"])\n| where success == true or toint(resultCode) between (200 .. 299)\n| where ResponseBody contains \"***\"\n| where \"{AgentSearch}\" == \"\" or APIName has \"{AgentSearch}\" or name has \"{AgentSearch}\"\n| extend RequestJson = parse_json(RequestBody), ResponseJson = parse_json(ResponseBody)\n| extend ResponseId = coalesce(tostring(ResponseJson.id), extract(@'\"id\"\\s*:\\s*\"(resp_[A-Za-z0-9_-]+)\"', 1, ResponseBody)),\n    Instructions = coalesce(tostring(ResponseJson.instructions), tostring(ResponseJson.input[0].content[0].text), tostring(ResponseJson.messages[0].content), tostring(RequestJson.instructions)),\n    OutputText = coalesce(tostring(ResponseJson.output[0].content[0].text), tostring(ResponseJson.output_text)),\n    Model = coalesce(tostring(ResponseJson.model), tostring(RequestJson.model)),\n    Caller = coalesce(user_AuthenticatedId, user_Id, client_IP, \"unknown\"),\n    MaskedCharacters = strlen(ResponseBody) - strlen(replace_string(ResponseBody, \"*\", \"\")),\n    MaskedRuns = array_length(extract_all(@'(\\*{3,})', ResponseBody))\n| extend MaskedExcerpt = substring(coalesce(Instructions, OutputText, ResponseBody), 0, 500)\n| project timestamp, Evidence = \"MASKED OUTPUT OBSERVED\", APIName, Caller, ResponseId, Model, MaskedCharacters, MaskedRuns, MaskedExcerpt, resultCode, RequestId, operation_Id, duration\n| order by timestamp desc\n| take 250",
              "size": 0,
              "title": "Masked APIM response details",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Evidence",
                    "formatter": 0
                  },
                  {
                    "columnMatch": "MaskedCharacters",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "green"
                    }
                  },
                  {
                    "columnMatch": "duration",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{APIMApplicationInsights}"
              ],
              "timeContextFromParameter": "TimeRange"
            },
            "name": "cs-apim-output-masking-details-appinsights",
            "conditionalVisibility": {
              "parameterName": "APIMTelemetrySource",
              "comparison": "isEqualTo",
              "value": "applicationInsights"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AppTraces\n| where SDKVersion startswith \"apim:\"\n| extend Search = tolower(strcat(Message, \" \", tostring(Properties))), Action = tolower(coalesce(tostring(Properties[\"action\"]), tostring(Properties[\"outcome\"]), tostring(Properties[\"decision\"]))), EntityType = coalesce(tostring(Properties[\"entity_type\"]), tostring(Properties[\"entityType\"]), tostring(Properties[\"pii_category\"]), tostring(Properties[\"category\"]), \"Not emitted\"), MaskedCount = tolong(coalesce(Properties[\"masked_count\"], Properties[\"redacted_count\"], Properties[\"maskCount\"], 0))\n| where Search has_any (\"pii\", \"redact\", \"mask\")\n| extend Redacted = Action has_any (\"redact\", \"mask\", \"block\") or MaskedCount > 0\n| summarize DetectedEvents = count(), RedactedEvents = countif(Redacted), UnresolvedOrUnknown = countif(not(Redacted)), MaskedValues = sum(MaskedCount), LastSeen = max(TimeGenerated) by EntityType\n| order by DetectedEvents desc",
              "size": 0,
              "title": "Explicit PII policy outcomes (metadata only)",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "DetectedEvents",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  },
                  {
                    "columnMatch": "RedactedEvents",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "green"
                    }
                  },
                  {
                    "columnMatch": "UnresolvedOrUnknown",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "red"
                    }
                  }
                ]
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
