          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"__advancedHuntingSettings\":true,\"query\":\"let AgentActivity = CloudAppEvents\\n| extend ActivityText=tolower(strcat(Application, \\\" \\\", ActionType, \\\" \\\", tostring(RawEventData), \\\" \\\", tostring(AdditionalFields)))\\n| where ActionType in~ (\\\"ExecuteToolByGateway\\\", \\\"InvokeAgent\\\", \\\"CopilotInteraction\\\") or ActivityText has_any (\\\"copilot\\\", \\\"agentid\\\", \\\"agentname\\\", \\\"generative ai\\\")\\n| extend AccountKeys=pack_array(tolower(AccountId), tolower(AccountObjectId))\\n| mv-expand AccountKey=AccountKeys to typeof(string)\\n| where isnotempty(AccountKey)\\n| summarize AgentActivities=count(), AgentApplications=make_set(coalesce(Application, ActionType), 20), LastAgentActivity=max(Timestamp) by AccountKey;\\nlet DlpAlertIds=union\\n(AlertEvidence | where Timestamp > ago(30d) and ServiceSource has \\\"Data Loss Prevention\\\" | project AlertId),\\n(AlertInfo | where Timestamp > ago(30d) | where ServiceSource has \\\"Data Loss Prevention\\\" or DetectionSource has \\\"Data Loss Prevention\\\" | project AlertId)\\n| distinct AlertId;\\nlet DlpAlerts=DlpAlertIds\\n| join kind=leftouter (AlertEvidence\\n  | where Timestamp > ago(30d) and ServiceSource has \\\"Data Loss Prevention\\\"\\n  | extend Extra=parse_json(AdditionalFields)\\n  | project AlertId, EvidenceTimestamp=Timestamp, EvidenceTitle=Title, EvidenceCategories=Categories, EvidenceSeverity=Severity, EvidenceServiceSource=ServiceSource, EvidenceDetectionSource=DetectionSource, EvidenceAttackTechniques=AttackTechniques, AccountUpn, AccountObjectId, AccountName, EntityType, EvidenceRole, FileName, Application, DisplayName=tostring(Extra.DisplayName), AssetTags=tostring(Extra.Tags), Workload=tostring(Extra.Workload), Location=tostring(Extra.Location), PolicyMatch=tostring(Extra.PolicyMatch), PolicyId=tostring(Extra.PolicyId), RuleId=tostring(Extra.RuleId), RuleMatch=tostring(Extra.RuleMatch), SensitiveInfoTypes=coalesce(tostring(Extra.SITDetected), tostring(Extra.SensitiveInfoTypes)), ActionTaken=tostring(Extra.ActionTaken), UserOverride=tostring(Extra.UserOverride), EventId=coalesce(tostring(Extra.EventId), tostring(Extra.EventID)), CorrelationId=tostring(Extra.CorrelationId), Path=tostring(Extra.Path)) on AlertId\\n| join kind=leftouter (AlertInfo | where Timestamp > ago(30d) | project AlertId, InfoTimestamp=Timestamp, InfoTitle=Title, InfoCategory=Category, InfoSeverity=Severity, InfoServiceSource=ServiceSource, InfoDetectionSource=DetectionSource, InfoAttackTechniques=AttackTechniques) on AlertId\\n| extend AlertTimestamp=coalesce(InfoTimestamp, EvidenceTimestamp), Title=coalesce(InfoTitle, EvidenceTitle), Category=coalesce(InfoCategory, EvidenceCategories), Severity=coalesce(InfoSeverity, EvidenceSeverity), ServiceSource=coalesce(EvidenceServiceSource, InfoServiceSource), DetectionSource=coalesce(InfoDetectionSource, EvidenceDetectionSource), AttackTechniques=coalesce(InfoAttackTechniques, EvidenceAttackTechniques)\\n| extend AccountKey=tolower(coalesce(AccountUpn, AccountObjectId, AccountName)), DirectAI=tolower(strcat(Title, \\\" \\\", Category, \\\" \\\", Application, \\\" \\\", Workload, \\\" \\\", Location, \\\" \\\", PolicyMatch, \\\" \\\", RuleMatch)) has_any (\\\"copilot\\\", \\\"agent\\\", \\\"genai\\\", \\\"generative ai\\\", \\\"llm\\\")\\n| join kind=leftouter AgentActivity on AccountKey\\n| summarize DirectAI=max(toint(DirectAI)), UserCorrelated=max(toint(AgentActivities > 0)), Accounts=make_set_if(AccountUpn, isnotempty(AccountUpn), 20), DisplayNames=make_set_if(DisplayName, isnotempty(DisplayName), 20), IsCriticalAsset=max(toint(AssetTags has \\\"critical_asset_tag\\\")), AssetTags=make_set_if(AssetTags, isnotempty(AssetTags), 20), AgentApplications=make_set_if(tostring(AgentApplications), AgentActivities > 0, 20), AgentActivities=max(coalesce(AgentActivities, 0)), LastAgentActivity=max(LastAgentActivity), Files=make_set_if(FileName, isnotempty(FileName), 20), Workloads=make_set_if(Workload, isnotempty(Workload), 10), Locations=make_set_if(Location, isnotempty(Location), 10), PolicyMatches=make_set_if(PolicyMatch, isnotempty(PolicyMatch), 20), PolicyIds=make_set_if(PolicyId, isnotempty(PolicyId), 20), RuleIds=make_set_if(RuleId, isnotempty(RuleId), 20), RuleMatches=make_set_if(RuleMatch, isnotempty(RuleMatch), 20), SensitiveInfoTypes=make_set_if(SensitiveInfoTypes, isnotempty(SensitiveInfoTypes), 20), ActionsTaken=make_set_if(ActionTaken, isnotempty(ActionTaken), 20), UserOverrides=make_set_if(UserOverride, isnotempty(UserOverride), 10), EventIds=make_set_if(EventId, isnotempty(EventId), 20), CorrelationIds=make_set_if(CorrelationId, isnotempty(CorrelationId), 20), Paths=make_set_if(Path, isnotempty(Path), 20), EntityTypes=make_set_if(EntityType, isnotempty(EntityType), 10), EvidenceRoles=make_set_if(EvidenceRole, isnotempty(EvidenceRole), 10) by AlertTimestamp, AlertId, Title, Category, Severity, ServiceSource, DetectionSource, AttackTechniques\\n| extend IsCriticalAsset=IsCriticalAsset == 1, SignalType=\\\"Purview DLP alert\\\", AttackSeverity=case(Severity =~ \\\"Critical\\\", \\\"🔴 CRITICAL\\\", Severity =~ \\\"High\\\", \\\"🟠 HIGH\\\", Severity =~ \\\"Medium\\\", \\\"🟡 MEDIUM\\\", Severity =~ \\\"Low\\\", \\\"🔵 LOW\\\", \\\"⚪ INFORMATIONAL / UNKNOWN\\\"), SeverityRank=case(Severity =~ \\\"Critical\\\", 1, Severity =~ \\\"High\\\", 2, Severity =~ \\\"Medium\\\", 3, Severity =~ \\\"Low\\\", 4, 5), AgentLinkClue=case(DirectAI == 1, \\\"DIRECT AI / COPILOT CONTEXT\\\", UserCorrelated == 1, \\\"SAME USER HAS AGENT ACTIVITY\\\", \\\"NO AGENT LINK FOUND\\\"), EvidenceClassification=case(DirectAI == 1, \\\"CONFIRMED PRODUCT ALERT - DIRECT AI CONTEXT\\\", UserCorrelated == 1, \\\"CORRELATED PRODUCT ALERT - AGENT USER\\\", \\\"PURVIEW DLP ALERT - NO AGENT ATTRIBUTION\\\"), SignalId=AlertId, Timestamp=AlertTimestamp;\\nlet DlpBehaviors=BehaviorInfo\\n| where Timestamp > ago(30d)\\n| where ServiceSource has \\\"Data Loss Prevention\\\" or DetectionSource has \\\"Data Loss Prevention\\\"\\n| project BehaviorTimestamp=Timestamp, BehaviorId, Title, Description, Categories, ActionType, InfoAccountUpn=AccountUpn, InfoAccountObjectId=AccountObjectId, ServiceSource, DetectionSource, AttackTechniques\\n| join kind=leftouter (BehaviorEntities | where Timestamp > ago(30d) | project BehaviorId, AccountUpn, AccountObjectId, AccountName, EntityType, EntityRole, FileName, Application, AdditionalFields) on BehaviorId\\n| extend AccountKey=tolower(coalesce(AccountUpn, AccountObjectId, InfoAccountUpn, InfoAccountObjectId, AccountName)), DirectAI=tolower(strcat(Title, \\\" \\\", Description, \\\" \\\", Categories, \\\" \\\", ActionType, \\\" \\\", Application, \\\" \\\", AdditionalFields)) has_any (\\\"copilot\\\", \\\"agent\\\", \\\"genai\\\", \\\"generative ai\\\", \\\"llm\\\")\\n| join kind=leftouter AgentActivity on AccountKey\\n| summarize DirectAI=max(toint(DirectAI)), UserCorrelated=max(toint(AgentActivities > 0)), Accounts=make_set_if(coalesce(AccountUpn, InfoAccountUpn), isnotempty(coalesce(AccountUpn, InfoAccountUpn)), 20), AgentApplications=make_set_if(tostring(AgentApplications), AgentActivities > 0, 20), AgentActivities=max(coalesce(AgentActivities, 0)), LastAgentActivity=max(LastAgentActivity), Files=make_set_if(FileName, isnotempty(FileName), 20), EntityTypes=make_set_if(EntityType, isnotempty(EntityType), 10), EvidenceRoles=make_set_if(EntityRole, isnotempty(EntityRole), 10) by BehaviorTimestamp, BehaviorId, Title, Categories, ActionType, ServiceSource, DetectionSource, AttackTechniques\\n| extend SignalType=\\\"Purview DLP behavior\\\", AttackSeverity=\\\"⚪ NOT SCORED\\\", SeverityRank=6, AgentLinkClue=case(DirectAI == 1, \\\"DIRECT AI / COPILOT CONTEXT\\\", UserCorrelated == 1, \\\"SAME USER HAS AGENT ACTIVITY\\\", \\\"NO AGENT LINK FOUND\\\"), EvidenceClassification=case(DirectAI == 1, \\\"CONFIRMED PRODUCT BEHAVIOR - DIRECT AI CONTEXT\\\", UserCorrelated == 1, \\\"CORRELATED PRODUCT BEHAVIOR - AGENT USER\\\", \\\"PURVIEW DLP BEHAVIOR - NO AGENT ATTRIBUTION\\\"), SignalId=BehaviorId, Timestamp=BehaviorTimestamp, Category=Categories;\\nunion DlpAlerts, DlpBehaviors\\n  | where \\\"{AgentSearch}\\\" == \\\"\\\" or Title has \\\"{AgentSearch}\\\" or tostring(Accounts) has \\\"{AgentSearch}\\\" or tostring(DisplayNames) has \\\"{AgentSearch}\\\" or tostring(AgentApplications) has \\\"{AgentSearch}\\\" or tostring(PolicyMatches) has \\\"{AgentSearch}\\\"\\n  | project Timestamp, SignalType, AttackSeverity, AgentLinkClue, EvidenceClassification, Title, Category, ActionType, Accounts, DisplayNames, IsCriticalAsset, AssetTags, Workloads, Locations, PolicyMatches, PolicyIds, RuleMatches, RuleIds, SensitiveInfoTypes, ActionsTaken, UserOverrides, Paths, EventIds, CorrelationIds, AgentApplications, AgentActivities, LastAgentActivity, Files, EntityTypes, EvidenceRoles, ServiceSource, DetectionSource, AttackTechniques, SignalId, SeverityRank\\n| order by SeverityRank asc, Timestamp desc\\n| project-away SeverityRank\\n| take 200\",\"selectedWorkspaceIds\":[\"{AdvancedHuntingWorkspaceId}\"]}",
              "size": 0,
              "title": "Purview DLP alert and behavior investigation details",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "AttackSeverity",
