                },
                {
                  "durationMs": 7776000000
                }
              ],
              "allowCustom": true
            },
            "timeContext": {
              "durationMs": 86400000
            }
          },
          {
            "id": "c4f7c4d9-2e1a-4f9c-8d7e-1a2b3c4d5e7f",
            "version": "KqlParameterItem/1.0",
            "name": "Workspace",
            "type": 5,
