// Phase 3, query 10: canonical permission-edge table contract.
//
// Use this empty datatable as the destination-schema contract for a normalized
// AgentPermissionEdges_CL table (or an equivalent Data lake table). Collectors
// for Microsoft Graph, Azure Resource Graph/ARM, Agent 365 Data lake, resource
// ACLs, and controls should project into this exact shape before visualization.
//
// CRITICAL: preserve EdgeClass. Never write an observed event as `configured`
// and never write broad-scope/resource-type inference as
// `reachableDeterministic`.
datatable(
    TimeGenerated:datetime,
    EdgeId:string,
    EdgeClass:string,
    Relation:string,
    TenantId:guid,
    SubjectId:string,
    SubjectType:string,
    TargetId:string,
    TargetType:string,
    PermissionId:string,
    PermissionValue:string,
    PermissionMode:string,
    AuthorizationMechanism:string,
    GrantOrigin:string,
    ConsentType:string,
    DeclarationState:string,
    GrantState:string,
    TokenState:string,
    ConfiguredEdgeId:string,
    ResourceScope:string,
    Operation:string,
    EventId:string,
    SourceSystem:string,
    SourceTable:string,
    SourceObjectId:string,
    EvidenceAuthority:string,
    Confidence:string,
    ObservedAt:datetime,
    RetrievedAt:datetime,
    ValidFrom:datetime,
    ValidTo:datetime,
    CollectorName:string,
    CollectorVersion:string,
    Details:dynamic
)[]
