{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-action-provenance-graph:permission-edge:1.0.0",
  "title": "Canonical Agent Permission Edge",
  "description": "Exact JSON and Log Analytics ingestion contract for one normalized identity, configured, observed, reachable, or control relationship. Property names match AgentPermissionEdges_CL, the DCR stream declaration, and AgentPermissionEdgeCollector.ps1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "TimeGenerated",
    "EdgeId",
    "EdgeClass",
    "Relation",
    "SubjectId",
    "TargetId",
    "SourceSystem",
    "EvidenceAuthority",
    "Confidence",
    "RetrievedAt"
  ],
  "properties": {
    "TimeGenerated": {
      "type": "string",
      "format": "date-time"
    },
    "EdgeId": {
      "type": "string",
      "minLength": 1
    },
    "EdgeClass": {
      "enum": [
        "identityLifecycle",
        "configured",
        "observed",
        "reachableDeterministic",
        "reachableBounded",
        "reachableInferred",
        "control"
      ]
    },
    "Relation": {
      "enum": [
        "belongsTo",
        "representedBy",
        "owns",
        "sponsors",
        "manages",
        "declares",
        "eligibleToInherit",
        "assigned",
        "consented",
        "materialized",
        "memberOf",
        "observedUsing",
        "reaches",
        "blockedBy",
        "constrainedBy",
        "dependsOn"
      ]
    },
    "TenantId": {
      "type": "string",
      "format": "uuid"
    },
    "SubjectId": {
      "type": "string",
      "minLength": 1
    },
    "SubjectType": {
      "enum": [
        "AgentRecord",
        "EntraApplication",
        "AgentIdentityBlueprint",
        "ServicePrincipal",
        "AgentIdentityBlueprintPrincipal",
        "AgentIdentity",
        "ManagedIdentity",
        "AgentUser",
        "HumanUser",
        "Group",
        "PermissionDefinition",
        "RoleDefinition",
        "Resource",
        "Control",
        "Unknown"
      ]
    },
    "TargetId": {
      "type": "string",
      "minLength": 1
    },
    "TargetType": {
      "type": "string"
    },
    "PermissionId": {
      "type": "string"
    },
    "PermissionValue": {
      "type": "string"
    },
    "PermissionMode": {
      "enum": [
        "application",
        "delegated",
        "notApplicable",
        "unknown"
      ]
    },
    "AuthorizationMechanism": {
      "enum": [
        "appRoleAssignment",
        "oauth2PermissionGrant",
        "resourceSpecificConsent",
        "directoryRole",
        "azureRbac",
        "workloadAcl",
        "apiKey",
        "identityRelationship",
        "runtimeObservation",
        "derivedReachability",
        "policyEvaluation",
        "unknown"
      ]
    },
    "GrantOrigin": {
      "enum": [
        "direct",
        "blueprintInherited",
        "groupDerived",
        "roleDerived",
        "accessPackage",
        "resourceSpecific",
        "notApplicable",
        "unknown"
      ]
    },
    "ConsentType": {
      "enum": [
        "AllPrincipals",
        "Principal",
        "notApplicable",
        "unknown"
      ]
    },
    "DeclarationState": {
      "type": "string"
    },
    "GrantState": {
      "type": "string"
    },
    "TokenState": {
      "type": "string"
    },
    "ConfiguredEdgeId": {
      "type": "string",
      "description": "For observed/reachable/control edges, the configured edge this evidence explains or constrains. Empty means no configured path was found; it does not automatically mean unauthorized access."
    },
    "ResourceScope": {
      "type": "string"
    },
    "Operation": {
      "type": "string"
    },
    "EventId": {
      "type": "string"
    },
    "SourceSystem": {
      "type": "string",
      "minLength": 1
    },
    "SourceTable": {
      "type": "string"
    },
    "SourceObjectId": {
      "type": "string"
    },
    "EvidenceAuthority": {
      "enum": [
        "authoritative",
        "nativeTelemetry",
        "deterministicDerived",
        "boundedDerived",
        "inferred",
        "manual"
      ]
    },
    "Confidence": {
      "enum": [
        "confirmed",
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "ObservedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "RetrievedAt": {
      "type": "string",
      "format": "date-time"
    },
    "ValidFrom": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ValidTo": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "CollectorName": {
      "type": "string"
    },
    "CollectorVersion": {
      "type": "string"
    },
    "Details": {
      "type": "object"
    }
  }
}
