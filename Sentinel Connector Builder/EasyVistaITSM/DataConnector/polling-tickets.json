{
  "type": "Microsoft.SecurityInsights/dataConnectors",
  "name": "EasyVistaITSM-Tickets",
  "apiVersion": "2025-03-01",
  "location": "{{location}}",
  "kind": "RestApiPoller",
  "properties": {
    "connectorDefinitionName": "EasyVistaITSM",
    "dataType": "EasyVista_Tickets_CL",
    "dcrConfig": {
      "streamName": "Custom-EasyVista_Tickets_CL",
      "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
      "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
    },
    "auth": {
      "type": "APIKey",
      "ApiKey": "{{bearerToken}}",
      "ApiKeyName": "Authorization",
      "ApiKeyIdentifier": "Bearer",
      "IsApiKeyInPostPayload": false
    },
    "request": {
      "apiEndpoint": "https://{{serverHost}}/api/v1/{{accountId}}/requests",
      "httpMethod": "GET",
      "queryParameters": {
        "max_rows": "100",
        "sort": "last_update+asc",
        "fields": "rfc_number,request_id,submit_date_ut,end_date_ut,last_update,status.status_en,status.status_id,severity_id,urgency_id,impact_id,description,title,request_type,origin,external_reference,first_call_resolution,max_resolution_date_ut,catalog_request.title_en,catalog_request.catalog_guid,requestor.last_name,requestor.e_mail,requestor.employee_id,recipient.last_name,recipient.e_mail,recipient.employee_id,location.location_en,location.location_path,department.department_en,department.department_path,asset.asset_tag,asset.asset_id"
      },
      "queryTimeFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
      "startTimeAttributeName": "search",
      "queryTimeIntervalAttributeName": "search",
      "queryTimeIntervalPrepend": "last_update:{0}",
      "rateLimitQps": 2,
      "retryCount": 3,
      "timeoutInSeconds": 120
    },
    "response": {
      "eventsJsonPaths": [
        "$.records[*]"
      ],
      "format": "json",
      "isGzipCompressed": false
    },
    "paging": {
      "pagingType": "CountBasedPaging",
      "pageSize": 100
    }
  }
}
