{
  "type": "Microsoft.SecurityInsights/dataConnectors",
  "name": "EasyVistaITSM-Assets",
  "apiVersion": "2025-03-01",
  "location": "{{location}}",
  "kind": "RestApiPoller",
  "properties": {
    "connectorDefinitionName": "EasyVistaITSM",
    "dataType": "EasyVista_Assets_CL",
    "dcrConfig": {
      "streamName": "Custom-EasyVista_Assets_CL",
      "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
      "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
    },
    "auth": {
      "type": "APIKey",
      "ApiKey": "{{bearerToken}}",
      "ApiKeyName": "Authorization",
      "ApiKeyIdentifier": "Bearer",
      "IsApiKeyInPostPayload": false
    },
    "request": {
      "apiEndpoint": "https://{{serverHost}}/api/v1/{{accountId}}/assets",
      "httpMethod": "GET",
      "queryParameters": {
        "max_rows": "100",
        "sort": "last_update+asc",
        "fields": "asset_id,asset_tag,asset_label,serial_number,purchase_date,installation_date,end_of_waranty,last_update,entry_date,location.location_en,location.location_path,location.city,employee.last_name,employee.e_mail,employee.employee_id,department.department_en,department.department_path"
      },
      "queryTimeFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
      "startTimeAttributeName": "search",
      "queryTimeIntervalAttributeName": "search",
      "queryTimeIntervalPrepend": "last_update:{0}",
      "rateLimitQps": 2,
      "retryCount": 3,
      "timeoutInSeconds": 120
    },
    "response": {
      "eventsJsonPaths": [
        "$.records[*]"
      ],
      "format": "json",
      "isGzipCompressed": false
    },
    "paging": {
      "pagingType": "CountBasedPaging",
      "pageSize": 100
    }
  }
}
