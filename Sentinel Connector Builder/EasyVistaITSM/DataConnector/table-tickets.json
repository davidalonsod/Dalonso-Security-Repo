{
  "type": "Microsoft.OperationalInsights/workspaces/tables",
  "name": "EasyVista_Tickets_CL",
  "apiVersion": "2022-10-01",
  "properties": {
    "schema": {
      "name": "EasyVista_Tickets_CL",
      "columns": [
        { "name": "TimeGenerated", "type": "datetime", "description": "Event timestamp derived from LAST_UPDATE or SUBMIT_DATE_UT" },
        { "name": "RFC_NUMBER", "type": "string", "description": "Unique ticket number (e.g., I161026_000005)" },
        { "name": "REQUEST_ID", "type": "string", "description": "Internal request identifier" },
        { "name": "SUBMIT_DATE_UT", "type": "datetime", "description": "Ticket creation date" },
        { "name": "END_DATE_UT", "type": "datetime", "description": "Ticket closure date" },
        { "name": "LAST_UPDATE", "type": "datetime", "description": "Last modification timestamp" },
        { "name": "STATUS_EN", "type": "string", "description": "Ticket status (e.g., In Progress, Closed, Resolved)" },
        { "name": "STATUS_ID", "type": "int", "description": "Status identifier" },
        { "name": "SEVERITY_ID", "type": "int", "description": "Severity level identifier" },
        { "name": "URGENCY_ID", "type": "int", "description": "Urgency level identifier" },
        { "name": "IMPACT_ID", "type": "int", "description": "Impact level identifier" },
        { "name": "DESCRIPTION", "type": "string", "description": "Ticket description" },
        { "name": "TITLE", "type": "string", "description": "Ticket title" },
        { "name": "REQUEST_TYPE", "type": "string", "description": "Type: Incident, Service Request, Change Request, Problem, Event" },
        { "name": "ORIGIN", "type": "string", "description": "Request origin (Phone, Email, API, Portal)" },
        { "name": "EXTERNAL_REFERENCE", "type": "string", "description": "External system reference ID" },
        { "name": "FIRST_CALL_RESOLUTION", "type": "string", "description": "First call resolution flag" },
        { "name": "MAX_RESOLUTION_DATE_UT", "type": "datetime", "description": "SLA maximum resolution date" },
        { "name": "CATALOG_TITLE", "type": "string", "description": "Service catalog entry title" },
        { "name": "CATALOG_GUID", "type": "string", "description": "Service catalog GUID" },
        { "name": "REQUESTOR_NAME", "type": "string", "description": "Requestor full name" },
        { "name": "REQUESTOR_EMAIL", "type": "string", "description": "Requestor email address" },
        { "name": "REQUESTOR_ID", "type": "string", "description": "Requestor employee ID" },
        { "name": "RECIPIENT_NAME", "type": "string", "description": "Recipient full name" },
        { "name": "RECIPIENT_EMAIL", "type": "string", "description": "Recipient email address" },
        { "name": "RECIPIENT_ID", "type": "string", "description": "Recipient employee ID" },
        { "name": "LOCATION_NAME", "type": "string", "description": "Location name" },
        { "name": "LOCATION_PATH", "type": "string", "description": "Full location path (e.g., Europe/France/Paris)" },
        { "name": "DEPARTMENT_NAME", "type": "string", "description": "Department name" },
        { "name": "DEPARTMENT_PATH", "type": "string", "description": "Full department path" },
        { "name": "ASSET_TAG", "type": "string", "description": "Associated asset tag" },
        { "name": "ASSET_ID", "type": "string", "description": "Associated asset identifier" },
        { "name": "HREF", "type": "string", "description": "EasyVista API link to this ticket" }
      ]
    }
  }
}
