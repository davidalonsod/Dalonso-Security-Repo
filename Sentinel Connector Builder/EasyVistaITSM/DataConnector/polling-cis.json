{
  "type": "Microsoft.SecurityInsights/dataConnectors",
  "name": "EasyVistaITSM-CIs",
  "apiVersion": "2025-03-01",
  "location": "{{location}}",
  "kind": "RestApiPoller",
  "properties": {
    "connectorDefinitionName": "EasyVistaITSM",
    "dataType": "EasyVista_CIs_CL",
    "dcrConfig": {
      "streamName": "Custom-EasyVista_CIs_CL",
      "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
      "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
    },
    "auth": {
      "type": "APIKey",
      "ApiKey": "{{bearerToken}}",
      "ApiKeyName": "Authorization",
      "ApiKeyIdentifier": "Bearer",
      "IsApiKeyInPostPayload": false
    },
    "request": {
      "apiEndpoint": "https://{{serverHost}}/api/v1/{{accountId}}/configuration_items",
      "httpMethod": "GET",
      "queryParameters": {
        "max_rows": "100",
        "sort": "last_update+asc",
        "fields": "ci_id,ci_name,ci_asset_tag,ci_status.ci_status_en,ci_status.ci_status_id,last_update,asset.asset_tag,asset.asset_id,location.location_en,location.location_path,department.department_en,department.department_path,employee.last_name,employee.e_mail"
      },
      "queryTimeFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
      "startTimeAttributeName": "search",
      "queryTimeIntervalAttributeName": "search",
      "queryTimeIntervalPrepend": "last_update:{0}",
      "rateLimitQps": 2,
      "retryCount": 3,
      "timeoutInSeconds": 120
    },
    "response": {
      "eventsJsonPaths": [
        "$.records[*]"
      ],
      "format": "json",
      "isGzipCompressed": false
    },
    "paging": {
      "pagingType": "CountBasedPaging",
      "pageSize": 100
    }
  }
}
