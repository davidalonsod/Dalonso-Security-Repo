{
  "type": "Microsoft.SecurityInsights/dataConnectors",
  "name": "EasyVistaITSM-Employees",
  "apiVersion": "2025-03-01",
  "location": "{{location}}",
  "kind": "RestApiPoller",
  "properties": {
    "connectorDefinitionName": "EasyVistaITSM",
    "dataType": "EasyVista_Employees_CL",
    "dcrConfig": {
      "streamName": "Custom-EasyVista_Employees_CL",
      "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
      "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
    },
    "auth": {
      "type": "APIKey",
      "ApiKey": "{{bearerToken}}",
      "ApiKeyName": "Authorization",
      "ApiKeyIdentifier": "Bearer",
      "IsApiKeyInPostPayload": false
    },
    "request": {
      "apiEndpoint": "https://{{serverHost}}/api/v1/{{accountId}}/employees",
      "httpMethod": "GET",
      "queryParameters": {
        "max_rows": "100",
        "sort": "last_update+asc",
        "fields": "employee_id,last_name,e_mail,phone_number,cellular_number,department_path,department_id,location_path,location_id,begin_of_contract,end_of_contract,last_update,identification"
      },
      "queryTimeFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
      "startTimeAttributeName": "search",
      "queryTimeIntervalAttributeName": "search",
      "queryTimeIntervalPrepend": "last_update:{0}",
      "rateLimitQps": 2,
      "retryCount": 3,
      "timeoutInSeconds": 120
    },
    "response": {
      "eventsJsonPaths": [
        "$.records[*]"
      ],
      "format": "json",
      "isGzipCompressed": false
    },
    "paging": {
      "pagingType": "CountBasedPaging",
      "pageSize": 100
    }
  }
}
