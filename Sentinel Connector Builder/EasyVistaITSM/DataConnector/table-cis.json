{
  "type": "Microsoft.OperationalInsights/workspaces/tables",
  "name": "EasyVista_CIs_CL",
  "apiVersion": "2022-10-01",
  "properties": {
    "schema": {
      "name": "EasyVista_CIs_CL",
      "columns": [
        { "name": "TimeGenerated", "type": "datetime", "description": "Event timestamp derived from LAST_UPDATE" },
        { "name": "CI_ID", "type": "string", "description": "Unique configuration item identifier" },
        { "name": "CI_NAME", "type": "string", "description": "Configuration item name" },
        { "name": "CI_ASSET_TAG", "type": "string", "description": "CI associated asset tag" },
        { "name": "CI_STATUS_EN", "type": "string", "description": "CI status (e.g., Active, Retired)" },
        { "name": "CI_STATUS_ID", "type": "string", "description": "CI status identifier" },
        { "name": "LAST_UPDATE", "type": "datetime", "description": "Last modification timestamp" },
        { "name": "ASSET_TAG", "type": "string", "description": "Linked asset tag" },
        { "name": "ASSET_ID", "type": "string", "description": "Linked asset identifier" },
        { "name": "LOCATION_NAME", "type": "string", "description": "Location name" },
        { "name": "LOCATION_PATH", "type": "string", "description": "Full location path" },
        { "name": "DEPARTMENT_NAME", "type": "string", "description": "Department name" },
        { "name": "DEPARTMENT_PATH", "type": "string", "description": "Full department path" },
        { "name": "EMPLOYEE_NAME", "type": "string", "description": "Responsible employee name" },
        { "name": "EMPLOYEE_EMAIL", "type": "string", "description": "Responsible employee email" },
        { "name": "HREF", "type": "string", "description": "EasyVista API link to this CI" }
      ]
    }
  }
}
