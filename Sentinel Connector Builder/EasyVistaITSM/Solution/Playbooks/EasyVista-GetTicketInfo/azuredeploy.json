{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "EasyVista - Get Ticket Info (Enrichment)",
    "description": "Retrieves EasyVista ticket details (status, owner, SLA, actions) and adds them as enrichment comments on the Sentinel incident. Enables SOC analysts to see ITSM context directly in their investigation without leaving Sentinel.",
    "prerequisites": ["EasyVista REST API Bearer token", "Microsoft Sentinel contributor role"],
    "lastUpdateTime": "2026-04-16T00:00:00Z",
    "support": { "tier": "community" },
    "author": { "name": "CyberSOC" }
  },
  "parameters": {
    "PlaybookName": { "defaultValue": "EasyVista-GetTicketInfo", "type": "string" },
    "EasyVistaHost": { "type": "string" },
    "EasyVistaAccount": { "type": "string" },
    "EasyVistaBearerToken": { "type": "securestring" }
  },
  "variables": {
    "AzureSentinelConnectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]",
    "EasyVistaBaseUrl": "[concat('https://', parameters('EasyVistaHost'), '/api/v1/', parameters('EasyVistaAccount'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('AzureSentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('AzureSentinelConnectionName')]",
        "parameterValueType": "Alternative",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('PlaybookName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "LogicAppsCategory": "security",
        "hidden-SentinelTemplateName": "EasyVista-GetTicketInfo",
        "hidden-SentinelTemplateVersion": "1.0"
      },
      "identity": { "type": "SystemAssigned" },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": { "type": "Object" },
            "EasyVistaBaseUrl": { "type": "String" },
            "EasyVistaBearerToken": { "type": "SecureString" }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } },
                "body": { "callback_url": "@{listCallbackUrl()}" },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "Filter_EV_Tag": {
              "runAfter": {},
              "type": "Query",
              "inputs": {
                "from": "@triggerBody()?['object']?['properties']?['labels']",
                "where": "@startsWith(item()?['labelName'], 'EV:')"
              }
            },
            "Condition_-_Has_EV_Tag": {
              "runAfter": { "Filter_EV_Tag": ["Succeeded"] },
              "type": "If",
              "expression": { "and": [{ "greater": ["@length(body('Filter_EV_Tag'))", 0] }] },
              "actions": {
                "Extract_RFC": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": "@replace(body('Filter_EV_Tag')[0]?['labelName'], 'EV:', '')"
                },
                "Get_EV_Ticket": {
                  "runAfter": { "Extract_RFC": ["Succeeded"] },
                  "type": "Http",
                  "inputs": {
                    "method": "GET",
                    "uri": "@{parameters('EasyVistaBaseUrl')}/requests?search=rfc_number:@{outputs('Extract_RFC')}&fields=rfc_number,request_id,title,status.status_en,severity_id,urgency_id,requestor.last_name,requestor.e_mail,recipient.last_name,recipient.e_mail,submit_date_ut,last_update,max_resolution_date_ut,first_call_resolution,description,location.location_path,department.department_path",
                    "headers": { "Authorization": "Bearer @{parameters('EasyVistaBearerToken')}" }
                  }
                },
                "Parse_Ticket": {
                  "runAfter": { "Get_EV_Ticket": ["Succeeded"] },
                  "type": "ParseJson",
                  "inputs": {
                    "content": "@body('Get_EV_Ticket')",
                    "schema": {
                      "type": "object",
                      "properties": {
                        "records": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "RFC_NUMBER": { "type": "string" },
                              "REQUEST_ID": { "type": "string" },
                              "TITLE": { "type": "string" },
                              "STATUS": { "type": "object" },
                              "SEVERITY_ID": { "type": "string" },
                              "REQUESTOR": { "type": "object" },
                              "RECIPIENT": { "type": "object" },
                              "SUBMIT_DATE_UT": { "type": "string" },
                              "LAST_UPDATE": { "type": "string" },
                              "MAX_RESOLUTION_DATE_UT": { "type": "string" },
                              "LOCATION": { "type": "object" },
                              "DEPARTMENT": { "type": "object" }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "Get_EV_Actions": {
                  "runAfter": { "Parse_Ticket": ["Succeeded"] },
                  "type": "Http",
                  "inputs": {
                    "method": "GET",
                    "uri": "@{parameters('EasyVistaBaseUrl')}/requests/@{body('Parse_Ticket')?['records'][0]?['REQUEST_ID']}/actions",
                    "headers": { "Authorization": "Bearer @{parameters('EasyVistaBearerToken')}" }
                  }
                },
                "Build_Enrichment": {
                  "runAfter": { "Get_EV_Actions": ["Succeeded"] },
                  "type": "Compose",
                  "inputs": "@concat('<h3>EasyVista ITSM Ticket Details</h3>','<table border=\"1\" cellpadding=\"5\">','<tr><td><b>RFC Number</b></td><td>',body('Parse_Ticket')?['records'][0]?['RFC_NUMBER'],'</td></tr>','<tr><td><b>Title</b></td><td>',body('Parse_Ticket')?['records'][0]?['TITLE'],'</td></tr>','<tr><td><b>Status</b></td><td>',body('Parse_Ticket')?['records'][0]?['STATUS']?['STATUS_EN'],'</td></tr>','<tr><td><b>Severity</b></td><td>',body('Parse_Ticket')?['records'][0]?['SEVERITY_ID'],'</td></tr>','<tr><td><b>Owner</b></td><td>',body('Parse_Ticket')?['records'][0]?['RECIPIENT']?['LAST_NAME'],' (',body('Parse_Ticket')?['records'][0]?['RECIPIENT']?['E_MAIL'],')</td></tr>','<tr><td><b>Requestor</b></td><td>',body('Parse_Ticket')?['records'][0]?['REQUESTOR']?['LAST_NAME'],' (',body('Parse_Ticket')?['records'][0]?['REQUESTOR']?['E_MAIL'],')</td></tr>','<tr><td><b>Created</b></td><td>',body('Parse_Ticket')?['records'][0]?['SUBMIT_DATE_UT'],'</td></tr>','<tr><td><b>Last Update</b></td><td>',body('Parse_Ticket')?['records'][0]?['LAST_UPDATE'],'</td></tr>','<tr><td><b>SLA Deadline</b></td><td>',body('Parse_Ticket')?['records'][0]?['MAX_RESOLUTION_DATE_UT'],'</td></tr>','<tr><td><b>Location</b></td><td>',body('Parse_Ticket')?['records'][0]?['LOCATION']?['LOCATION_PATH'],'</td></tr>','<tr><td><b>Department</b></td><td>',body('Parse_Ticket')?['records'][0]?['DEPARTMENT']?['DEPARTMENT_PATH'],'</td></tr>','</table>','<br><b>Recent Actions (last 5):</b><br>',body('Get_EV_Actions'))"
                },
                "Add_Enrichment_Comment": {
                  "runAfter": { "Build_Enrichment": ["Succeeded"] },
                  "type": "ApiConnection",
                  "inputs": {
                    "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } },
                    "method": "post",
                    "body": {
                      "incidentArmId": "@triggerBody()?['object']?['id']",
                      "message": "@{outputs('Build_Enrichment')}"
                    },
                    "path": "/Incidents/Comment"
                  }
                },
                "Update_Incident_With_SLA_Warning": {
                  "runAfter": { "Parse_Ticket": ["Succeeded"] },
                  "type": "If",
                  "expression": {
                    "and": [
                      { "less": ["@body('Parse_Ticket')?['records'][0]?['MAX_RESOLUTION_DATE_UT']", "@utcNow()"] }
                    ]
                  },
                  "actions": {
                    "Escalate_Severity": {
                      "type": "ApiConnection",
                      "inputs": {
                        "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } },
                        "method": "put",
                        "body": {
                          "incidentArmId": "@triggerBody()?['object']?['id']",
                          "severity": "High",
                          "tagsToAdd": { "TagsToAdd": [{ "Tag": "SLA-Breached" }] }
                        },
                        "path": "/Incidents"
                      }
                    }
                  },
                  "else": { "actions": {} }
                }
              },
              "else": { "actions": {} }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]",
                "connectionName": "[variables('AzureSentinelConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]",
                "connectionProperties": { "authentication": { "type": "ManagedServiceIdentity" } }
              }
            }
          },
          "EasyVistaBaseUrl": { "value": "[variables('EasyVistaBaseUrl')]" },
          "EasyVistaBearerToken": { "value": "[parameters('EasyVistaBearerToken')]" }
        }
      }
    }
  ]
}
