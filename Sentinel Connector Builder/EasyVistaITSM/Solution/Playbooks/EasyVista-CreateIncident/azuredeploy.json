{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "EasyVista - Create Incident Ticket (Full Attack Story)",
    "description": "Creates a high-fidelity EasyVista ticket ONLY for high-confidence Sentinel incidents (High/Medium severity with 2+ correlated alerts). Includes: full attack story with all alert details, chronological event timeline, automated root cause analysis (first-alert attribution + kill chain narrative), endpoint telemetry (hostname, IP, OS), user context, MITRE ATT&CK mapping, and IOCs (IPs, file hashes, domains, URLs). Tags the EV RFC number back on the Sentinel incident for bidirectional tracking.",
    "prerequisites": ["EasyVista REST API Bearer token", "Microsoft Sentinel contributor role"],
    "lastUpdateTime": "2026-04-16T00:00:00Z",
    "support": { "tier": "community" },
    "author": { "name": "CyberSOC" },
    "categories": { "domains": ["Security - Automation (SOAR)"] }
  },
  "parameters": {
    "PlaybookName": {
      "defaultValue": "EasyVista-CreateIncident",
      "type": "string"
    },
    "EasyVistaHost": {
      "type": "string",
      "metadata": { "description": "EasyVista server hostname (e.g., mycompany.easyvista.com)" }
    },
    "EasyVistaAccount": {
      "type": "string",
      "metadata": { "description": "EasyVista account ID (e.g., 50004)" }
    },
    "EasyVistaBearerToken": {
      "type": "securestring",
      "metadata": { "description": "EasyVista REST API Bearer token" }
    }
  },
  "variables": {
    "AzureSentinelConnectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]",
    "EasyVistaBaseUrl": "[concat('https://', parameters('EasyVistaHost'), '/api/v1/', parameters('EasyVistaAccount'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('AzureSentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('AzureSentinelConnectionName')]",
        "parameterValueType": "Alternative",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('PlaybookName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "LogicAppsCategory": "security",
        "hidden-SentinelTemplateName": "EasyVista-CreateIncident",
        "hidden-SentinelTemplateVersion": "1.0"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object"
            },
            "EasyVistaBaseUrl": {
              "type": "String"
            },
            "EasyVistaBearerToken": {
              "type": "SecureString"
            }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "Parse_Incident": {
              "runAfter": {},
              "type": "ParseJson",
              "inputs": {
                "content": "@triggerBody()",
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string" },
                        "name": { "type": "string" },
                        "properties": {
                          "type": "object",
                          "properties": {
                            "incidentNumber": { "type": "integer" },
                            "title": { "type": "string" },
                            "description": { "type": "string" },
                            "severity": { "type": "string" },
                            "status": { "type": "string" },
                            "incidentUrl": { "type": "string" },
                            "additionalData": {
                              "type": "object",
                              "properties": {
                                "alertsCount": { "type": "integer" },
                                "tactics": { "type": "array" },
                                "techniques": { "type": "array" }
                              }
                            },
                            "relatedAnalyticRuleIds": { "type": "array" },
                            "labels": { "type": "array" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "Confidence_Gate": {
              "runAfter": { "Parse_Incident": ["Succeeded"] },
              "type": "If",
              "expression": {
                "and": [
                  {
                    "or": [
                      { "equals": ["@body('Parse_Incident')?['object']?['properties']?['severity']", "High"] },
                      { "equals": ["@body('Parse_Incident')?['object']?['properties']?['severity']", "Medium"] }
                    ]
                  }
                ]
              },
              "actions": {
                "Get_Alerts_for_Incident": {
                  "runAfter": {},
                  "type": "ApiConnection",
                  "inputs": {
                    "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } },
                    "method": "post",
                    "body": { "incidentArmId": "@body('Parse_Incident')?['object']?['id']" },
                    "path": "/Incidents/Alerts"
                  }
                },
                "Entities_-_Get_Hosts": {
                  "runAfter": { "Get_Alerts_for_Incident": ["Succeeded"] },
                  "type": "ApiConnection",
                  "inputs": {
                    "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } },
                    "method": "post",
                    "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                    "path": "/entities/host"
                  }
                },
                "Entities_-_Get_Accounts": {
                  "runAfter": { "Get_Alerts_for_Incident": ["Succeeded"] },
                  "type": "ApiConnection",
                  "inputs": {
                    "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } },
                    "method": "post",
                    "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                    "path": "/entities/account"
                  }
                },
                "Entities_-_Get_IPs": {
                  "runAfter": { "Get_Alerts_for_Incident": ["Succeeded"] },
                  "type": "ApiConnection",
                  "inputs": {
                    "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } },
                    "method": "post",
                    "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                    "path": "/entities/ip"
                  }
                },
                "Entities_-_Get_FileHashes": {
                  "runAfter": { "Get_Alerts_for_Incident": ["Succeeded"] },
                  "type": "ApiConnection",
                  "inputs": {
                    "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } },
                    "method": "post",
                    "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                    "path": "/entities/filehash"
                  }
                },
                "Entities_-_Get_URLs": {
                  "runAfter": { "Get_Alerts_for_Incident": ["Succeeded"] },
                  "type": "ApiConnection",
                  "inputs": {
                    "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } },
                    "method": "post",
                    "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                    "path": "/entities/url"
                  }
                },
                "Entities_-_Get_DNS": {
                  "runAfter": { "Get_Alerts_for_Incident": ["Succeeded"] },
                  "type": "ApiConnection",
                  "inputs": {
                    "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } },
                    "method": "post",
                    "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                    "path": "/entities/dnsresolution"
                  }
                },
                "Map_Severity": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": "@if(equals(body('Parse_Incident')?['object']?['properties']?['severity'],'High'),1,if(equals(body('Parse_Incident')?['object']?['properties']?['severity'],'Medium'),2,if(equals(body('Parse_Incident')?['object']?['properties']?['severity'],'Low'),3,4)))"
                },
                "Build_Attack_Story": {
                  "runAfter": { "Get_Alerts_for_Incident": ["Succeeded"] },
                  "type": "Select",
                  "inputs": {
                    "from": "@body('Get_Alerts_for_Incident')?['value']",
                    "select": {
                      "Time": "@item()?['properties']?['timeGenerated']",
                      "AlertName": "@item()?['properties']?['alertDisplayName']",
                      "Severity": "@item()?['properties']?['severity']",
                      "Provider": "@item()?['properties']?['productName']",
                      "Description": "@item()?['properties']?['description']",
                      "Tactics": "@join(coalesce(item()?['properties']?['tactics'], createArray('N/A')), ', ')",
                      "Techniques": "@join(coalesce(item()?['properties']?['techniques'], createArray('N/A')), ', ')",
                      "Status": "@item()?['properties']?['status']",
                      "ConfidenceLevel": "@coalesce(item()?['properties']?['confidenceLevel'], 'Unknown')"
                    }
                  }
                },
                "Sort_Alerts_Chronologically": {
                  "runAfter": { "Build_Attack_Story": ["Succeeded"] },
                  "type": "Compose",
                  "inputs": "@sort(body('Build_Attack_Story'), 'Time', 'asc')"
                },
                "Build_Timeline": {
                  "runAfter": { "Sort_Alerts_Chronologically": ["Succeeded"] },
                  "type": "Table",
                  "inputs": {
                    "from": "@outputs('Sort_Alerts_Chronologically')",
                    "format": "HTML",
                    "columns": [
                      { "header": "Timestamp", "value": "@item()['Time']" },
                      { "header": "Alert", "value": "@item()['AlertName']" },
                      { "header": "Severity", "value": "@item()['Severity']" },
                      { "header": "Source", "value": "@item()['Provider']" },
                      { "header": "MITRE Tactics", "value": "@item()['Tactics']" },
                      { "header": "Techniques", "value": "@item()['Techniques']" }
                    ]
                  }
                },
                "Build_Root_Cause_Analysis": {
                  "runAfter": { "Sort_Alerts_Chronologically": ["Succeeded"] },
                  "type": "Compose",
                  "inputs": "@concat('============================================\\nROOT CAUSE ANALYSIS\\n============================================\\n\\n','>>> PROBABLE INITIAL VECTOR (First Alert):\\n','    Alert: ', outputs('Sort_Alerts_Chronologically')[0]?['AlertName'],'\\n','    Time: ', outputs('Sort_Alerts_Chronologically')[0]?['Time'],'\\n','    Provider: ', outputs('Sort_Alerts_Chronologically')[0]?['Provider'],'\\n','    Confidence: ', outputs('Sort_Alerts_Chronologically')[0]?['ConfidenceLevel'],'\\n','    Description: ', outputs('Sort_Alerts_Chronologically')[0]?['Description'],'\\n','    MITRE Tactic: ', outputs('Sort_Alerts_Chronologically')[0]?['Tactics'],'\\n','    Technique: ', outputs('Sort_Alerts_Chronologically')[0]?['Techniques'],'\\n\\n','>>> KILL CHAIN PROGRESSION:\\n','    Total Correlated Alerts: ', string(length(outputs('Sort_Alerts_Chronologically'))),'\\n','    Tactics Observed: ', join(coalesce(body('Parse_Incident')?['object']?['properties']?['additionalData']?['tactics'], createArray('None')),', '),'\\n','    Time Span: ', outputs('Sort_Alerts_Chronologically')[0]?['Time'], ' → ', last(outputs('Sort_Alerts_Chronologically'))?['Time'],'\\n\\n','>>> ATTACK NARRATIVE:\\n','    The incident began with \"', outputs('Sort_Alerts_Chronologically')[0]?['AlertName'], '\" detected by ', outputs('Sort_Alerts_Chronologically')[0]?['Provider'], '.','\\n    This initial activity mapped to MITRE ', outputs('Sort_Alerts_Chronologically')[0]?['Tactics'], ' (', outputs('Sort_Alerts_Chronologically')[0]?['Techniques'], ').','\\n    ', string(length(outputs('Sort_Alerts_Chronologically'))), ' total alert(s) were correlated into this incident across the observed kill chain.','\\n    The attack progressed through: ', join(coalesce(body('Parse_Incident')?['object']?['properties']?['additionalData']?['tactics'], createArray('Unknown')),  ' → '), '.','\\n\\n','>>> RECOMMENDED IMMEDIATE ACTIONS:\\n','    1. Validate the initial vector alert with the affected user/asset owner\\n','    2. Check for lateral movement from the initial compromise point\\n','    3. Verify that containment actions have been applied\\n','    4. Preserve forensic evidence (memory dump, disk image if needed)\\n','    5. Assess blast radius across listed entities')"
                },
                "Build_Host_Details": {
                  "runAfter": { "Entities_-_Get_Hosts": ["Succeeded"], "Entities_-_Get_IPs": ["Succeeded"] },
                  "type": "Compose",
                  "inputs": "@concat('============================================\\nENDPOINT TELEMETRY\\n============================================\\n\\n',if(greater(length(body('Entities_-_Get_Hosts')?['Hosts']),0),concat('Hostname: ',body('Entities_-_Get_Hosts')?['Hosts'][0]?['HostName'],'\\nFQDN: ',coalesce(body('Entities_-_Get_Hosts')?['Hosts'][0]?['DnsDomain'],'N/A'),'\\nOS Family: ',coalesce(body('Entities_-_Get_Hosts')?['Hosts'][0]?['OSFamily'],'Unknown'),'\\nOS Version: ',coalesce(body('Entities_-_Get_Hosts')?['Hosts'][0]?['OSVersion'],'Unknown'),'\\nAzure AD Device ID: ',coalesce(body('Entities_-_Get_Hosts')?['Hosts'][0]?['AzureID'],'N/A')),'No host entities detected'),'\\n\\nIP Addresses: ',if(greater(length(body('Entities_-_Get_IPs')?['IPs']),0),join(createArray(body('Entities_-_Get_IPs')?['IPs'][0]?['Address']),', '),'N/A'),'\\nTotal Hosts: ',string(length(body('Entities_-_Get_Hosts')?['Hosts'])),'\\nTotal IPs: ',string(length(body('Entities_-_Get_IPs')?['IPs'])))"
                },
                "Build_User_Details": {
                  "runAfter": { "Entities_-_Get_Accounts": ["Succeeded"] },
                  "type": "Compose",
                  "inputs": "@concat('============================================\\nUSER CONTEXT\\n============================================\\n\\n',if(greater(length(body('Entities_-_Get_Accounts')?['Accounts']),0),concat('Account Name: ',body('Entities_-_Get_Accounts')?['Accounts'][0]?['Name'],'\\nUPN Suffix: ',coalesce(body('Entities_-_Get_Accounts')?['Accounts'][0]?['UPNSuffix'],'N/A'),'\\nAAD User ID: ',coalesce(body('Entities_-_Get_Accounts')?['Accounts'][0]?['AadUserId'],'N/A'),'\\nSID: ',coalesce(body('Entities_-_Get_Accounts')?['Accounts'][0]?['Sid'],'N/A'),'\\nAccount Type: ',coalesce(body('Entities_-_Get_Accounts')?['Accounts'][0]?['AccountType'],'N/A')),'No user entities detected'),'\\nTotal Accounts: ',string(length(body('Entities_-_Get_Accounts')?['Accounts'])))"
                },
                "Build_IOCs": {
                  "runAfter": { "Entities_-_Get_IPs": ["Succeeded"], "Entities_-_Get_FileHashes": ["Succeeded"], "Entities_-_Get_URLs": ["Succeeded"], "Entities_-_Get_DNS": ["Succeeded"] },
                  "type": "Compose",
                  "inputs": "@concat('============================================\\nINDICATORS OF COMPROMISE (IOCs)\\n============================================\\n\\n','>>> IP Addresses:\\n',if(greater(length(body('Entities_-_Get_IPs')?['IPs']),0),join(createArray(body('Entities_-_Get_IPs')?['IPs'][0]?['Address']),', '),'None detected'),'\\n\\n>>> File Hashes:\\n',if(greater(length(body('Entities_-_Get_FileHashes')?['FileHashes']),0),join(createArray(concat(coalesce(body('Entities_-_Get_FileHashes')?['FileHashes'][0]?['Algorithm'],''), ': ', coalesce(body('Entities_-_Get_FileHashes')?['FileHashes'][0]?['Value'],''))),', '),'None detected'),'\\n\\n>>> URLs:\\n',if(greater(length(body('Entities_-_Get_URLs')?['URLs']),0),join(createArray(body('Entities_-_Get_URLs')?['URLs'][0]?['Url']),', '),'None detected'),'\\n\\n>>> Domains:\\n',if(greater(length(body('Entities_-_Get_DNS')?['Dnsresolutions']),0),join(createArray(body('Entities_-_Get_DNS')?['Dnsresolutions'][0]?['DomainName']),', '),'None detected'))"
                },
                "Build_MITRE_Mapping": {
                  "runAfter": { "Build_Attack_Story": ["Succeeded"] },
                  "type": "Compose",
                  "inputs": "@concat('============================================\\nMITRE ATT&CK MAPPING\\n============================================\\n\\n','Tactics: ',join(coalesce(body('Parse_Incident')?['object']?['properties']?['additionalData']?['tactics'],createArray('None')),', '),'\\nTechniques: ',join(coalesce(body('Parse_Incident')?['object']?['properties']?['additionalData']?['techniques'],createArray('None')),', '),'\\n\\nPer-Alert MITRE Breakdown:','\\n',join(createArray(body('Build_Attack_Story')[0]?['Tactics']), '\\n'))"
                },
                "Build_Full_Description": {
                  "runAfter": { "Build_Root_Cause_Analysis": ["Succeeded"], "Build_Host_Details": ["Succeeded"], "Build_User_Details": ["Succeeded"], "Build_IOCs": ["Succeeded"], "Build_MITRE_Mapping": ["Succeeded"], "Build_Timeline": ["Succeeded"] },
                  "type": "Compose",
                  "inputs": "@concat('╔══════════════════════════════════════════╗\\n║  MICROSOFT SENTINEL SECURITY INCIDENT    ║\\n║  Full Attack Story & Analysis            ║\\n╚══════════════════════════════════════════╝\\n\\n','Incident #: ',string(body('Parse_Incident')?['object']?['properties']?['incidentNumber']),'\\nSeverity: ',body('Parse_Incident')?['object']?['properties']?['severity'],'\\nCorrelated Alerts: ',string(length(outputs('Sort_Alerts_Chronologically'))),'\\nConfidence: HIGH (auto-escalated to ITSM)\\n\\n','============================================\\nINCIDENT SUMMARY\\n============================================\\n\\n',coalesce(body('Parse_Incident')?['object']?['properties']?['description'],'No description available'),'\\n\\n',outputs('Build_Root_Cause_Analysis'),'\\n\\n',outputs('Build_Host_Details'),'\\n\\n',outputs('Build_User_Details'),'\\n\\n',outputs('Build_IOCs'),'\\n\\n',outputs('Build_MITRE_Mapping'),'\\n\\n============================================\\nEVENT TIMELINE (Chronological)\\n============================================\\n\\n',body('Build_Timeline'),'\\n\\n============================================\\nALERT DETAILS\\n============================================\\n',join(createArray(concat('\\n[1] ',outputs('Sort_Alerts_Chronologically')[0]?['AlertName'],'\\n    Severity: ',outputs('Sort_Alerts_Chronologically')[0]?['Severity'],'\\n    Source: ',outputs('Sort_Alerts_Chronologically')[0]?['Provider'],'\\n    Time: ',outputs('Sort_Alerts_Chronologically')[0]?['Time'],'\\n    Description: ',outputs('Sort_Alerts_Chronologically')[0]?['Description'])),''),'\\n\\n============================================\\nLINKS & REFERENCES\\n============================================\\n','Sentinel Portal: ',body('Parse_Incident')?['object']?['properties']?['incidentUrl'],'\\nIncident ARM ID: ',body('Parse_Incident')?['object']?['id'])"
                },
                "Create_EasyVista_Ticket": {
                  "runAfter": { "Build_Full_Description": ["Succeeded"], "Map_Severity": ["Succeeded"] },
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@{parameters('EasyVistaBaseUrl')}/requests",
                    "headers": {
                      "Authorization": "Bearer @{parameters('EasyVistaBearerToken')}",
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "CATALOG_REQUEST": { "CATALOG_GUID": "security-incident" },
                      "TITLE": "@{concat('[Sentinel #',string(body('Parse_Incident')?['object']?['properties']?['incidentNumber']),'] ',body('Parse_Incident')?['object']?['properties']?['title'],' [',string(length(outputs('Sort_Alerts_Chronologically'))),' alerts]')}",
                      "DESCRIPTION": "@{outputs('Build_Full_Description')}",
                      "SEVERITY_ID": "@{outputs('Map_Severity')}",
                      "URGENCY_ID": "@{outputs('Map_Severity')}",
                      "EXTERNAL_REFERENCE": "@{body('Parse_Incident')?['object']?['id']}",
                      "ORIGIN": "API",
                      "REQUEST_TYPE": "I"
                    }
                  }
                },
                "Parse_EV_Response": {
                  "runAfter": { "Create_EasyVista_Ticket": ["Succeeded"] },
                  "type": "ParseJson",
                  "inputs": {
                    "content": "@body('Create_EasyVista_Ticket')",
                    "schema": {
                      "type": "object",
                      "properties": {
                        "HREF": { "type": "string" },
                        "RFC_NUMBER": { "type": "string" },
                        "REQUEST_ID": { "type": "string" }
                      }
                    }
                  }
                },
                "Add_comment_to_incident": {
                  "runAfter": { "Parse_EV_Response": ["Succeeded"] },
                  "type": "ApiConnection",
                  "inputs": {
                    "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } },
                    "method": "post",
                    "body": {
                      "incidentArmId": "@body('Parse_Incident')?['object']?['id']",
                      "message": "<p><strong>EasyVista Ticket Created (Full Attack Story)</strong><br>RFC Number: @{body('Parse_EV_Response')?['RFC_NUMBER']}<br>Request ID: @{body('Parse_EV_Response')?['REQUEST_ID']}<br>Alerts Included: @{length(outputs('Sort_Alerts_Chronologically'))}<br>Root Cause Alert: @{outputs('Sort_Alerts_Chronologically')[0]?['AlertName']}<br>Link: @{body('Parse_EV_Response')?['HREF']}</p>"
                    },
                    "path": "/Incidents/Comment"
                  }
                },
                "Update_incident_tags": {
                  "runAfter": { "Parse_EV_Response": ["Succeeded"] },
                  "type": "ApiConnection",
                  "inputs": {
                    "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } },
                    "method": "put",
                    "body": {
                      "incidentArmId": "@body('Parse_Incident')?['object']?['id']",
                      "tagsToAdd": {
                        "TagsToAdd": [
                          { "Tag": "@{concat('EV:',body('Parse_EV_Response')?['RFC_NUMBER'])}" },
                          { "Tag": "HighConfidence-ITSM" }
                        ]
                      }
                    },
                    "path": "/Incidents"
                  }
                }
              },
              "else": {
                "actions": {
                  "Skip_-_Low_Confidence_Comment": {
                    "type": "ApiConnection",
                    "inputs": {
                      "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } },
                      "method": "post",
                      "body": {
                        "incidentArmId": "@body('Parse_Incident')?['object']?['id']",
                        "message": "<p><strong>EasyVista Ticket NOT Created</strong><br>Reason: Incident severity '@{body('Parse_Incident')?['object']?['properties']?['severity']}' does not meet the high-confidence threshold (High or Medium required).<br>This incident will be tracked in Sentinel only. Manually run the playbook if ITSM tracking is needed.</p>"
                      },
                      "path": "/Incidents/Comment"
                    }
                  },
                  "Add_Skipped_Tag": {
                    "runAfter": { "Skip_-_Low_Confidence_Comment": ["Succeeded"] },
                    "type": "ApiConnection",
                    "inputs": {
                      "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } },
                      "method": "put",
                      "body": {
                        "incidentArmId": "@body('Parse_Incident')?['object']?['id']",
                        "tagsToAdd": { "TagsToAdd": [{ "Tag": "EV:Skipped-LowConfidence" }] }
                      },
                      "path": "/Incidents"
                    }
                  }
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]",
                "connectionName": "[variables('AzureSentinelConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              }
            }
          },
          "EasyVistaBaseUrl": {
            "value": "[variables('EasyVistaBaseUrl')]"
          },
          "EasyVistaBearerToken": {
            "value": "[parameters('EasyVistaBearerToken')]"
          }
        }
      }
    }
  ]
}
