{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "EasyVista - Sync Status to Sentinel (EV→Sentinel)",
    "description": "Polls EasyVista for recently updated tickets that have a Sentinel incident reference (EXTERNAL_REFERENCE). Syncs the EasyVista ticket status back to the corresponding Sentinel incident. Maps: Open→New, Investigating→Active, Contained→Active, Resolved→Closed. Ensures SOC and IT teams stay aligned in real time.",
    "prerequisites": ["EasyVista REST API Bearer token", "Microsoft Sentinel contributor role", "Log Analytics API permissions"],
    "lastUpdateTime": "2026-04-16T00:00:00Z",
    "support": { "tier": "community" },
    "author": { "name": "CyberSOC" }
  },
  "parameters": {
    "PlaybookName": { "defaultValue": "EasyVista-SyncStatusToSentinel", "type": "string" },
    "EasyVistaHost": { "type": "string" },
    "EasyVistaAccount": { "type": "string" },
    "EasyVistaBearerToken": { "type": "securestring" },
    "SubscriptionId": { "type": "string" },
    "ResourceGroupName": { "type": "string" },
    "WorkspaceName": { "type": "string" }
  },
  "variables": {
    "AzureSentinelConnectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]",
    "EasyVistaBaseUrl": "[concat('https://', parameters('EasyVistaHost'), '/api/v1/', parameters('EasyVistaAccount'))]",
    "SentinelApiBase": "[concat('https://management.azure.com/subscriptions/', parameters('SubscriptionId'), '/resourceGroups/', parameters('ResourceGroupName'), '/providers/Microsoft.OperationalInsights/workspaces/', parameters('WorkspaceName'), '/providers/Microsoft.SecurityInsights')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('AzureSentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('AzureSentinelConnectionName')]",
        "parameterValueType": "Alternative",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('PlaybookName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "LogicAppsCategory": "security",
        "hidden-SentinelTemplateName": "EasyVista-SyncStatusToSentinel",
        "hidden-SentinelTemplateVersion": "1.0"
      },
      "identity": { "type": "SystemAssigned" },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": { "type": "Object" },
            "EasyVistaBaseUrl": { "type": "String" },
            "EasyVistaBearerToken": { "type": "SecureString" },
            "SentinelApiBase": { "type": "String" }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": { "frequency": "Minute", "interval": 5 }
            }
          },
          "actions": {
            "Get_Recently_Updated_Tickets": {
              "runAfter": {},
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "@{concat(parameters('EasyVistaBaseUrl'), '/requests?search=last_update:{', addMinutes(utcNow(), -10, 'yyyy-MM-ddTHH:mm:ss'), '}&fields=rfc_number,request_id,status.status_en,external_reference,last_update,title&sort=last_update+desc&max_rows=50')}",
                "headers": { "Authorization": "Bearer @{parameters('EasyVistaBearerToken')}" }
              }
            },
            "Parse_Updated_Tickets": {
              "runAfter": { "Get_Recently_Updated_Tickets": ["Succeeded"] },
              "type": "ParseJson",
              "inputs": {
                "content": "@body('Get_Recently_Updated_Tickets')",
                "schema": {
                  "type": "object",
                  "properties": {
                    "records": { "type": "array" }
                  }
                }
              }
            },
            "Filter_Sentinel_Linked": {
              "runAfter": { "Parse_Updated_Tickets": ["Succeeded"] },
              "type": "Query",
              "inputs": {
                "from": "@body('Parse_Updated_Tickets')?['records']",
                "where": "@and(not(empty(item()?['EXTERNAL_REFERENCE'])), startsWith(item()?['EXTERNAL_REFERENCE'], '/subscriptions/'))"
              }
            },
            "For_Each_Linked_Ticket": {
              "runAfter": { "Filter_Sentinel_Linked": ["Succeeded"] },
              "type": "Foreach",
              "foreach": "@body('Filter_Sentinel_Linked')",
              "actions": {
                "Map_EV_Status_to_Sentinel": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": "@if(equals(items('For_Each_Linked_Ticket')?['STATUS']?['STATUS_EN'],'Open'),'New',if(equals(items('For_Each_Linked_Ticket')?['STATUS']?['STATUS_EN'],'Investigating'),'Active',if(equals(items('For_Each_Linked_Ticket')?['STATUS']?['STATUS_EN'],'Contained'),'Active',if(or(equals(items('For_Each_Linked_Ticket')?['STATUS']?['STATUS_EN'],'Resolved'),equals(items('For_Each_Linked_Ticket')?['STATUS']?['STATUS_EN'],'Closed')),'Closed','Active'))))"
                },
                "Map_Classification": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": "@if(or(equals(items('For_Each_Linked_Ticket')?['STATUS']?['STATUS_EN'],'Resolved'),equals(items('For_Each_Linked_Ticket')?['STATUS']?['STATUS_EN'],'Closed')),'TruePositive','')"
                },
                "Update_Sentinel_Incident": {
                  "runAfter": { "Map_EV_Status_to_Sentinel": ["Succeeded"], "Map_Classification": ["Succeeded"] },
                  "type": "Http",
                  "inputs": {
                    "method": "PATCH",
                    "uri": "@{concat('https://management.azure.com', items('For_Each_Linked_Ticket')?['EXTERNAL_REFERENCE'], '?api-version=2023-11-01')}",
                    "headers": { "Content-Type": "application/json" },
                    "body": {
                      "properties": {
                        "status": "@{outputs('Map_EV_Status_to_Sentinel')}",
                        "classification": "@{if(empty(outputs('Map_Classification')), null, outputs('Map_Classification'))}"
                      }
                    },
                    "authentication": { "type": "ManagedServiceIdentity" }
                  }
                },
                "Add_Sync_Comment": {
                  "runAfter": { "Update_Sentinel_Incident": ["Succeeded"] },
                  "type": "ApiConnection",
                  "inputs": {
                    "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } },
                    "method": "post",
                    "body": {
                      "incidentArmId": "@items('For_Each_Linked_Ticket')?['EXTERNAL_REFERENCE']",
                      "message": "<p><strong>EasyVista → Sentinel Sync</strong><br>EV Ticket: @{items('For_Each_Linked_Ticket')?['RFC_NUMBER']}<br>EV Status: @{items('For_Each_Linked_Ticket')?['STATUS']?['STATUS_EN']}<br>Sentinel Status set to: @{outputs('Map_EV_Status_to_Sentinel')}<br>Synced at: @{utcNow()}</p>"
                    },
                    "path": "/Incidents/Comment"
                  }
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]",
                "connectionName": "[variables('AzureSentinelConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]",
                "connectionProperties": { "authentication": { "type": "ManagedServiceIdentity" } }
              }
            }
          },
          "EasyVistaBaseUrl": { "value": "[variables('EasyVistaBaseUrl')]" },
          "EasyVistaBearerToken": { "value": "[parameters('EasyVistaBearerToken')]" },
          "SentinelApiBase": { "value": "[variables('SentinelApiBase')]" }
        }
      }
    }
  ]
}
