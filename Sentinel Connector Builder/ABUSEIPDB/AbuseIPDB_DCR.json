{
    "name": "AbuseIPDBDCR",
    "apiVersion": "2024-03-11",
    "type": "Microsoft.Insights/dataCollectionRules",
    "kind": "Direct",
    "location": "{{location}}",
    "tags": {
        "createdBy": "SentinelCodelessConnector"
    },
    "properties": {
        "streamDeclarations": {
            "Custom-AbuseIPDB_Blacklist_CL": {
                "columns": [
                    {
                        "name": "ipAddress",
                        "type": "string"
                    },
                    {
                        "name": "abuseConfidenceScore",
                        "type": "real"
                    },
                    {
                        "name": "countryCode",
                        "type": "string"
                    },
                    {
                        "name": "lastReportedAt",
                        "type": "string"
                    }
                ]
            }
        },
        "destinations": {
            "logAnalytics": [
                {
                    "workspaceResourceId": "{{workspaceResourceId}}",
                    "name": "clv2ws1"
                }
            ]
        },
        "dataFlows": [
            {
                "streams": ["Custom-AbuseIPDB_Blacklist_CL"],
                "destinations": ["clv2ws1"],
                "outputStream": "Custom-AbuseIPDB_Blacklist_CL",
                "transformKql": "source | extend TimeGenerated = todatetime(lastReportedAt) | project TimeGenerated, IpAddress = ipAddress, AbuseConfidenceScore = abuseConfidenceScore, CountryCode = countryCode, LastReportedAt = todatetime(lastReportedAt)"
            }
        ]
    }
}