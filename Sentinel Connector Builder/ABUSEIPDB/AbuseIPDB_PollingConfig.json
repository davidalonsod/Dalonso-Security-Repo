[
  {
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "apiVersion": "2023-02-01-preview",
    "name": "AbuseIPDBBlacklistConnector",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
      "connectorDefinitionName": "AbuseIPDBConnectorDefinition",
      "dataType": "AbuseIPDB_Blacklist_CL",
      "dcrConfig": {
        "streamName": "Custom-AbuseIPDB_Blacklist_CL",
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
      },
      "auth": {
        "type": "APIKey",
        "ApiKey": "{{apiKey}}",
        "ApiKeyName": "Key",
        "ApiKeyIdentifier": ""
      },
      "request": {
        "apiEndpoint": "https://api.abuseipdb.com/api/v2/blacklist",
        "httpMethod": "GET",
        "rateLimitQPS": 1,
        "queryWindowInMin": 1440,
        "retryCount": 3,
        "timeoutInSeconds": 120,
        "headers": {
          "Accept": "application/json"
        },
        "queryParameters": {
          "confidenceMinimum": "25",
          "limit": "500000"
        }
      },
      "response": {
        "eventsJsonPaths": [
          "$.data"
        ],
        "format": "json"
      }
    }
  }
]