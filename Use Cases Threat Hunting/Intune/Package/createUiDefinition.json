{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {
      "isWizard": false,
      "basics": {
        "description": "**Intune Logs** Microsoft Sentinel content pack. Deploys 10 analytic rules, 10 hunting queries, and the CIO/CISO KPI workbook. IP-aware detections honor the existing `NetworkAllowlist` watchlist (CIDR).",
        "subscription": { "resourceProviders": ["Microsoft.OperationalInsights/workspaces"] },
        "location": { "metadata": { "hidden": "Workspace location is used." } },
        "resourceGroup": { "allowExisting": true }
      }
    },
    "basics": [
      {
        "name": "workspace",
        "type": "Microsoft.Common.TextBox",
        "label": "Sentinel workspace name",
        "toolTip": "Name of the Log Analytics / Sentinel workspace (e.g. lawsentinel).",
        "constraints": {
          "required": true,
          "regex": "^[A-Za-z0-9][A-Za-z0-9-]{2,62}[A-Za-z0-9]$",
          "validationMessage": "Enter a valid workspace name."
        }
      }
    ],
    "steps": [],
    "outputs": {
      "workspace": "[basics('workspace')]",
      "workspace-location": "[location()]"
    }
  }
}
