{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workbookDisplayName": {
      "type": "string",
      "defaultValue": "Intune Security - CIO/CISO KPIs",
      "metadata": { "description": "Display name for the workbook shown in Azure Workbooks." }
    },
    "workbookType": {
      "type": "string",
      "defaultValue": "sentinel",
      "metadata": { "description": "Kind of workbook. For Sentinel content, keep as 'sentinel'." }
    },
    "workbookSourceId": {
      "type": "string",
      "defaultValue": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
      "metadata": { "description": "Resource ID of the Log Analytics / Sentinel workspace." }
    },
    "workspaceName": {
      "type": "string",
      "metadata": { "description": "Name of the Log Analytics workspace where Sentinel is enabled (e.g. lawsentinel)." }
    }
  },
  "variables": {
    "workbookId": "[guid(resourceGroup().id, parameters('workbookDisplayName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Insights/workbooks",
      "apiVersion": "2022-04-01",
      "name": "[variables('workbookId')]",
      "location": "[resourceGroup().location]",
      "kind": "shared",
      "properties": {
        "displayName": "[parameters('workbookDisplayName')]",
        "serializedData": "[string(json(loadTextContent('../Workbooks/IntuneSecurity-CIO-CISO.json')))]",
        "version": "1.0",
        "sourceId": "[parameters('workbookSourceId')]",
        "category": "[parameters('workbookType')]"
      }
    }
  ],
  "outputs": {
    "workbookId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Insights/workbooks', variables('workbookId'))]"
    }
  }
}
