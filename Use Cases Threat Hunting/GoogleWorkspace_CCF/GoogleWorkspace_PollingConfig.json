[
  {
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "apiVersion": "2023-02-01-preview",
    "name": "GoogleWorkspaceAlertsConnector",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
      "connectorDefinitionName": "GoogleWorkspaceDefinition",
      "dataType": "GWSAlerts_CL",
      "dcrConfig": {
        "streamName": "Custom-GWSAlerts_CL",
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
      },
      "auth": {
        "type": "OAuth2",
        "GrantType": "authorization_code",
        "ClientId": "{{clientId}}",
        "ClientSecret": "{{clientSecret}}",
        "AuthorizationCode": "{{code}}",
        "AuthorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "TokenEndpoint": "https://oauth2.googleapis.com/token",
        "RedirectUri": "https://portal.azure.com/TokenAuthorize/ExtensionName/Microsoft_Azure_Security_Insights",
        "Scope": "https://www.googleapis.com/auth/apps.alerts",
        "AuthorizationEndpointQueryParameters": {
          "access_type": "offline",
          "prompt": "consent"
        }
      },
      "request": {
        "apiEndpoint": "https://alertcenter.googleapis.com/v1beta1/alerts",
        "httpMethod": "GET",
        "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
        "rateLimitQPS": 10,
        "queryWindowInMin": 5,
        "retryCount": 3,
        "timeoutInSeconds": 60,
        "headers": {
          "Accept": "application/json"
        },
        "queryParameters": {
          "pageSize": "1000",
          "orderBy": "createTime asc",
          "filter": "createTime >= \"{_QueryWindowStartTime}\" AND createTime < \"{_QueryWindowEndTime}\""
        }
      },
      "paging": {
        "pagingType": "NextPageToken",
        "nextPageTokenJsonPath": "$.nextPageToken",
        "NextPageParaName": "pageToken",
        "pageSize": 1000,
        "pageSizeParameterName": "pageSize"
      },
      "response": {
        "eventsJsonPaths": [
          "$.alerts"
        ],
        "format": "json"
      }
    }
  }
]
