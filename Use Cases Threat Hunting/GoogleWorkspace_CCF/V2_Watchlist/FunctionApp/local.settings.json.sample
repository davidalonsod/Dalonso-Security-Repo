{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "FUNCTIONS_EXTENSION_VERSION": "~4",

    "GOOGLE_SA_JSON": "@Microsoft.KeyVault(SecretUri=https://<kv>.vault.azure.net/secrets/gws-sa-json/)",
    "GWS_IMPERSONATE_SUBJECT": "secadmin@example.com",
    "GWS_ALERT_FILTER_LOOKBACK_MINUTES": "60",
    "GWS_PAGE_SIZE": "1000",

    "DCE_LOGS_INGESTION_ENDPOINT": "https://<dce-name>.<region>-1.ingest.monitor.azure.com",
    "DCR_IMMUTABLE_ID": "dcr-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    "DCR_STREAM_NAME": "Custom-GWSAlerts_CL",

    "STATE_TABLE_NAME": "gwsalertstate",
    "STATE_PARTITION_KEY": "alertcenter",
    "STATE_ROW_KEY": "cursor"
  }
}
