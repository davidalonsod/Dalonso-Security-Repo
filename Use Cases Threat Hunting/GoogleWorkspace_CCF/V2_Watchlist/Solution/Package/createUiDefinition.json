{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {
      "isWizard": false,
      "basics": {
        "description": "<img src=\"https://raw.githubusercontent.com/Azure/Azure-Sentinel/master/Logos/Azure_Sentinel.svg\" width=\"75px\" height=\"75px\">\n\n**Google Workspace Alert Center** \u2014 End-to-end Microsoft Sentinel solution for Google Workspace Alert Center. Includes a Codeless (CCF) data connector that ingests alerts from the Alert Center API into the GWSAlerts_CL custom table, 10 scheduled analytic rules, and 10 hunting queries mapped to MITRE ATT&CK.",
        "subscription": {
          "resourceProviders": [
            "Microsoft.OperationalInsights/workspaces"
          ]
        },
        "location": {
          "metadata": {
            "hidden": "Hiding location field, since the template will deploy to the same location as the workspace."
          }
        },
        "resourceGroup": {
          "allowExisting": true
        }
      }
    },
    "basics": [
      {
        "name": "getLAWorkspace",
        "type": "Microsoft.Solutions.ArmApiControl",
        "request": {
          "method": "GET",
          "path": "[concat(subscription().id, '/providers/Microsoft.OperationalInsights/workspaces?api-version=2020-08-01')]"
        }
      },
      {
        "name": "workspace",
        "type": "Microsoft.Common.DropDown",
        "label": "Workspace",
        "placeholder": "Select a workspace",
        "toolTip": "Microsoft Sentinel-enabled Log Analytics workspace.",
        "constraints": {
          "allowedValues": "[map(filter(basics('getLAWorkspace').value, (filter) => contains(filter.id, resourceGroup().name)), (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.name, '\"}')))]",
          "required": true
        },
        "visible": true
      }
    ],
    "steps": [],
    "outputs": {
      "workspace-location": "[resourceGroup().location]",
      "location": "[location()]",
      "workspace": "[basics('workspace')]"
    }
  }
}