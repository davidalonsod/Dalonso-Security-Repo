{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-action-provenance-graph:case-schema:1.0.0",
  "title": "Agentic Action Investigation Case",
  "description": "A single incident-investigation instance: concrete entities, an evidence chain with per-step evidence type and confidence, anomaly findings, blast-radius counts, and an analyst recommendation. Distinct from graph-schema.json, which models detection-logic provenance rather than a specific incident.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "incident", "steps", "evidenceTable", "anomalies", "blastRadius", "recommendation"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "risk", "agentName", "agentId", "agentIdentity", "initiatingUser", "conversationId", "investigationConfidencePercent"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "agentName": { "type": "string", "minLength": 1 },
        "agentId": { "type": "string", "minLength": 1 },
        "agentIdentity": { "type": "string", "minLength": 1 },
        "initiatingUser": { "type": "string", "minLength": 1 },
        "conversationId": { "type": "string", "minLength": 1 },
        "investigationConfidencePercent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "The causal/temporal chain rendered as the 'What happened' flow diagram. Each step is a hop from one actor/entity to the next.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor", "action", "evidenceType"],
        "properties": {
          "actor": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" },
          "branches": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional parallel branches from this step, e.g. multiple resources searched."
          },
          "flag": { "type": "string", "description": "Optional inline annotation, e.g. 'unusual resource for this agent'." },
          "evidenceType": { "enum": ["exact", "correlated", "audit", "inferred"] },
          "confidencePercent": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "evidenceTable": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time", "entity", "action", "evidence", "confidencePercent"],
        "properties": {
          "time": { "type": "string", "minLength": 1 },
          "entity": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "confidencePercent": { "type": "number", "minimum": 0, "maximum": 100 },
          "sourceTable": {
            "type": "string",
            "description": "The real KQL table this row would come from in your tenant, e.g. AppDependencies, CloudAppEvents, AgentsInfo. Optional but recommended for traceability back to a query."
          }
        }
      }
    },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "baseline": { "type": "string" },
          "current": { "type": "string" }
        }
      }
    },
    "blastRadius": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootLabel", "branches"],
      "properties": {
        "rootLabel": { "type": "string", "minLength": 1 },
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "count": { "type": "number" }
            }
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "investigate"],
      "properties": {
        "priority": { "enum": ["low", "medium", "high", "critical"] },
        "investigate": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
