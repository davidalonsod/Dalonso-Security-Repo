{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-action-provenance-graph:schema:1.1.0",
  "title": "Agentic Security Provenance Graph",
  "description": "A reusable schema for tracing source claims through agent actions, telemetry, detection decisions, and security mappings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "metadata",
    "stages",
    "nodes",
    "edges"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "source",
        "generatedAt",
        "deploymentStatus"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "behaviorCluster": {
          "type": "string"
        },
        "detectionId": {
          "type": "string"
        },
        "deploymentStatus": {
          "enum": [
            "draft",
            "requires-tuning",
            "ready",
            "deployed",
            "retired"
          ]
        },
        "statusReason": {
          "type": "string"
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "stage",
        "label",
        "description",
        "evidence",
        "confidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "source",
            "behavior",
            "action",
            "control",
            "entity",
            "telemetry",
            "parameter",
            "detection",
            "validation",
            "finding",
            "output",
            "technique"
          ]
        },
        "stage": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "relation",
        "description",
        "evidence",
        "evidenceType"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "from": {
          "$ref": "#/$defs/identifier"
        },
        "to": {
          "$ref": "#/$defs/identifier"
        },
        "relation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "evidenceType": {
          "description": "How strong the link between 'from' and 'to' actually is. exact: a shared trace/session/native-column identifier ties the two records together deterministically. correlated: joined by identity + a bounded time window with no shared ID -- a real but probabilistic join. contextual: same resource/type/timeframe or an unverified/hypothesized inference, weaker than correlated. conflict: the two nodes directly contradict each other.",
          "enum": [
            "exact",
            "correlated",
            "contextual",
            "conflict"
          ]
        },
        "conditional": {
          "type": "boolean",
          "default": false,
          "description": "Whether this edge only holds in some circumstances (e.g. only if a match occurs, only if the agent is instrumented a certain way) as opposed to always applying. Independent of evidenceType, which measures strength, not universality."
        }
      }
    }
  }
}
